---
import type { SidebarItem } from '../lib/sidebar';

export interface Props {
  items: SidebarItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function isActive(link: string): boolean {
  return currentPath === link;
}

function renderItems(items: SidebarItem[], depth = 0): any[] {
  return items;
}
---

<aside class="docs-sidebar" aria-label="Documentation navigation">
  <noscript>
    <style>
      /* Without scripting the row could never become a field, so the control
         that would open it is not shown. */
      .sidebar-search__toggle {
        display: none;
      }
    </style>
  </noscript>

  <nav>
    {items.map(group => (
      <div class="sidebar-group">
        {group.textByFramework ? (
          <>
            {/* One heading per framework, and the selector's own CSS shows the
                one in force — the label is set before the first paint. */}
            {Object.entries(group.textByFramework)
              .filter(([, text]) => Boolean(text))
              .map(([framework, text]) => (
                <div class="sidebar-group__title" data-framework-only={framework}>{text}</div>
              ))}
          </>
        ) : group.text ? (
          <div class="sidebar-group__title">{group.text}</div>
        ) : null}
        {group.items && (
          <ul class="sidebar-group__items">
            {group.items.map(item => (
              item.items ? (
                <li>
                  <div class="sidebar-subgroup-title">{item.text}</div>
                  <ul class="sidebar-subgroup__items">
                    {item.items.map(sub => (
                      <li>
                        <a
                          href={sub.link}
                          class={`sidebar-item${sub.link && isActive(sub.link) ? ' active' : ''}`}
                        >
                          <span class="sidebar-item__label">{sub.text}</span>
                          {sub.examples?.gpui ? (
                            <span class="sidebar-item__count" data-framework-count="gpui">
                              {sub.examples.gpui}<span class="sr-only"> examples</span>
                            </span>
                          ) : null}
                          {sub.examples?.slint ? (
                            <span class="sidebar-item__count" data-framework-count="slint">
                              {sub.examples.slint}<span class="sr-only"> examples</span>
                            </span>
                          ) : null}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : item.rootLink ? (
                <li class="sidebar-row" data-sidebar-row>
                  <a
                    href={item.link}
                    class={`sidebar-item${item.link && isActive(item.link) ? ' active' : ''}`}
                  >
                    <span class="sidebar-item__label">{item.text}</span>
                  </a>
                  <input
                    id="sidebar-search-field"
                    class="sidebar-search__field"
                    type="search"
                    placeholder="Filter"
                    aria-label="Filter components"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button
                    class="sidebar-search__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="sidebar-search-field"
                    aria-label="Filter components"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8" />
                      <path d="m21 21-4.35-4.35" />
                    </svg>
                  </button>
                </li>
              ) : (
                <li>
                  <a
                    href={item.link}
                    class={`sidebar-item${item.link && isActive(item.link) ? ' active' : ''}`}
                  >
                    <span class="sidebar-item__label">{item.text}</span>
                    {item.examples?.gpui ? (
                      <span class="sidebar-item__count" data-framework-count="gpui">
                        {item.examples.gpui}<span class="sr-only"> examples</span>
                      </span>
                    ) : null}
                    {item.examples?.slint ? (
                      <span class="sidebar-item__count" data-framework-count="slint">
                        {item.examples.slint}<span class="sr-only"> examples</span>
                      </span>
                    ) : null}
                  </a>
                </li>
              )
            ))}
          </ul>
        )}
      </div>
    ))}
  </nav>

  <p class="sidebar-search__empty" data-sidebar-empty role="status" hidden>
    No component matches that filter. Clear it to see them all.
  </p>
</aside>

<script is:inline>
  // The icon opens a field that filters the links below it: a link that does
  // not match is hidden, and so is the group, subgroup or heading left with no
  // visible link of its own. Nothing here talks to the framework selector.
  (function () {
    const sidebar = document.querySelector('.docs-sidebar');
    const row = sidebar && sidebar.querySelector('[data-sidebar-row]');
    if (!sidebar || !row) return;

    const toggle = row.querySelector('.sidebar-search__toggle');
    const field = row.querySelector('.sidebar-search__field');
    const empty = sidebar.querySelector('[data-sidebar-empty]');
    const links = () => Array.from(sidebar.querySelectorAll('.sidebar-item'));
    // The label and the address it leads to. The example counts sit inside the
    // same link, and a query is never a count.
    const haystack = (link) =>
      ((link.querySelector('.sidebar-item__label') || link).textContent + ' ' + (link.getAttribute('href') || '')).toLowerCase();
    const holder = (link) => link.closest('li');
    const shown = (link) => holder(link).style.display !== 'none';
    let open = false;

    function apply() {
      const query = field.value.trim().toLowerCase();
      let hits = 0;

      for (const link of links()) {
        // The row carrying the field is never filtered out from under the
        // reader: they are typing into it.
        if (link.closest('[data-sidebar-row]')) continue;
        const hit = query === '' || haystack(link).includes(query);
        holder(link).style.display = hit ? '' : 'none';
        if (hit) hits += 1;
      }

      // Innermost lists first: a wrapper goes once nothing inside it is left,
      // and the group goes with it — unless it holds the field.
      for (const list of Array.from(sidebar.querySelectorAll('ul')).reverse()) {
        for (const item of Array.from(list.children)) {
          if (item.hasAttribute('data-sidebar-row')) continue;
          const any = Array.from(item.querySelectorAll('.sidebar-item')).some(shown);
          item.style.display = any ? '' : 'none';
        }
      }
      for (const group of sidebar.querySelectorAll('.sidebar-group')) {
        const holdsTheField = group.querySelector('[data-sidebar-row]') !== null;
        const any = Array.from(group.querySelectorAll('.sidebar-item')).some(shown);
        group.style.display = holdsTheField || any ? '' : 'none';
      }

      if (empty) empty.hidden = !(query !== '' && hits === 0);
    }

    function setOpen(next) {
      open = next;
      row.toggleAttribute('data-search-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        field.focus();
      } else {
        field.value = '';
        apply();
        toggle.focus();
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(!open);
    });

    field.addEventListener('input', apply);

    // Clicking away gives the row back, as long as there is nothing to keep.
    field.addEventListener('blur', function () {
      if (open && field.value.trim() === '') setOpen(false);
    });

    field.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }
      // One link left: the filter has done its job, so Enter takes it. The
      // row's own link is not a match, it is where the query is typed.
      if (event.key === 'Enter') {
        const matches = links().filter(
          (link) => !link.closest('[data-sidebar-row]') && shown(link),
        );
        if (matches.length === 1) {
          event.preventDefault();
          window.location.assign(matches[0].href);
        }
      }
    });
  })();
</script>

<script is:inline>
  (function () {
    const sidebar = document.querySelector('.docs-sidebar');
    if (!sidebar) return;

    const section = window.location.pathname.match(/(?:^|\/)(docs|base)(?:\/|$)/)?.[1] || 'docs';
    const key = 'gpui-kit:sidebar-scroll:' + section;

    // 1. Restore the last known scroll position for this section.
    let isRestoring = true;
    try {
      const saved = sessionStorage.getItem(key);
      if (saved !== null) {
        sidebar.scrollTop = Number(saved);
      }
    } catch {}

    // 2. Ensure the active item is visible; if off-screen (e.g. direct link or refresh), scroll it into center.
    const active = sidebar.querySelector('.sidebar-item.active');
    if (active) {
      const cRect = sidebar.getBoundingClientRect();
      const aRect = active.getBoundingClientRect();
      const isVisible = aRect.top >= cRect.top && aRect.bottom <= cRect.bottom;
      if (!isVisible) {
        sidebar.scrollTop = active.offsetTop - (sidebar.clientHeight / 2) + (active.offsetHeight / 2);
      }
    }

    requestAnimationFrame(function () {
      delete sidebar.dataset.scrollbarVisible;
      isRestoring = false;
    });

    // 3. Synchronize scroll position and manage transient scrollbar visibility.
    let hideTimer;
    function saveScroll() {
      try {
        sessionStorage.setItem(key, String(sidebar.scrollTop));
      } catch {}
    }

    sidebar.addEventListener(
      'scroll',
      function () {
        if (!isRestoring) {
          sidebar.dataset.scrollbarVisible = '';
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(function () {
            delete sidebar.dataset.scrollbarVisible;
          }, 800);
        }
        saveScroll();
      },
      { passive: true },
    );

    sidebar.addEventListener('click', function (e) {
      if (e.target && e.target.closest('a')) {
        saveScroll();
      }
    });

    window.addEventListener('pagehide', saveScroll);
  })();
</script>
