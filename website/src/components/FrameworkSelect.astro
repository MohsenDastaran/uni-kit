---
const label = 'Framework';
---

<div class="framework-select" data-framework-select>
  <button
    class="framework-select__trigger"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="framework-select-menu"
  >
    <span class="framework-select__sr">{label}</span>
    <span class="framework-select__value" data-framework-value="gpui">
      <svg class="framework-select__logo" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M4 4h24v5H10v14h18v5H4V4Z" fill="currentColor"></path>
        <path class="framework-switch__logo-accent" d="M16 13h12v10h-5v-5h-7v-5Z" fill="#3B82F6"></path>
      </svg>
      <span class="framework-select__name">GPUI</span>
    </span>
    <span class="framework-select__value" data-framework-value="slint">
      <svg class="framework-select__logo" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="m6.503 23.914 13.61-9.399s.614-.351.614-.906c0-.739-.776-.979-.776-.979l-7.488-2.953c-.267-.104-.634.189-.29.56l2.479 2.471s.688.675.688 1.117-.423.836-.423.836l-9.02 8.684c-.32.31.113.87.606.569zM17.497.087 3.887 9.484s-.614.351-.614.906c0 .739.776.98.776.98l7.488 2.953c.267.103.636-.19.29-.559l-2.479-2.48s-.688-.673-.688-1.116c0-.444.423-.837.423-.837L18.097.654c.326-.31-.106-.87-.6-.567z"
        ></path>
      </svg>
      <span class="framework-select__name">Slint</span>
    </span>
    <svg class="framework-select__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>
  <div id="framework-select-menu" class="framework-select__menu" role="listbox" aria-label={label} inert>
    <button class="framework-select__option" type="button" role="option" data-framework-option="gpui" aria-selected="false" tabindex="-1">
      <svg class="framework-select__logo" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M4 4h24v5H10v14h18v5H4V4Z" fill="currentColor"></path>
        <path class="framework-switch__logo-accent" d="M16 13h12v10h-5v-5h-7v-5Z" fill="#3B82F6"></path>
      </svg>
      <span>GPUI</span>
      <svg class="framework-select__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m20 6-11 11-5-5"></path>
      </svg>
    </button>
    <button class="framework-select__option" type="button" role="option" data-framework-option="slint" aria-selected="true" tabindex="-1">
      <svg class="framework-select__logo" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="m6.503 23.914 13.61-9.399s.614-.351.614-.906c0-.739-.776-.979-.776-.979l-7.488-2.953c-.267-.104-.634.189-.29.56l2.479 2.471s.688.675.688 1.117-.423.836-.423.836l-9.02 8.684c-.32.31.113.87.606.569zM17.497.087 3.887 9.484s-.614.351-.614.906c0 .739.776.98.776.98l7.488 2.953c.267.103.636-.19.29-.559l-2.479-2.48s-.688-.673-.688-1.116c0-.444.423-.837.423-.837L18.097.654c.326-.31-.106-.87-.6-.567z"
        ></path>
      </svg>
      <span>Slint</span>
      <svg class="framework-select__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m20 6-11 11-5-5"></path>
      </svg>
    </button>
  </div>

  <div class="framework-hint" data-framework-hint hidden role="status">
    <svg class="framework-hint__leader" aria-hidden="true">
      <path class="framework-hint__leader-line" pathLength="1"></path>
      <g class="framework-hint__leader-head">
        <path d="M-7.5 -5.5 L0 0 L-7.5 5.5"></path>
      </g>
    </svg>
    <div class="framework-hint__card">
      <p class="framework-hint__kicker">Same components, other framework</p>
      <span class="framework-hint__value" data-framework-value="gpui">
        <svg class="framework-select__logo" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M4 4h24v5H10v14h18v5H4V4Z" fill="currentColor"></path>
          <path class="framework-switch__logo-accent" d="M16 13h12v10h-5v-5h-7v-5Z" fill="#3B82F6"></path>
        </svg>
        Try GPUI
      </span>
      <span class="framework-hint__value" data-framework-value="slint">
        <svg class="framework-select__logo" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="m6.503 23.914 13.61-9.399s.614-.351.614-.906c0-.739-.776-.979-.776-.979l-7.488-2.953c-.267-.104-.634.189-.29.56l2.479 2.471s.688.675.688 1.117-.423.836-.423.836l-9.02 8.684c-.32.31.113.87.606.569zM17.497.087 3.887 9.484s-.614.351-.614.906c0 .739.776.98.776.98l7.488 2.953c.267.103.636-.19.29-.559l-2.479-2.48s-.688-.673-.688-1.116c0-.444.423-.837.423-.837L18.097.654c.326-.31-.106-.87-.6-.567z"
          ></path>
        </svg>
        Try Slint
      </span>
      <button class="framework-hint__close" type="button" aria-label="Dismiss">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l14 14M19 5 5 19"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-framework-select]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.framework-select__trigger');
    const menu = root.querySelector<HTMLElement>('.framework-select__menu');
    if (!trigger || !menu) return;

    const options = [...menu.querySelectorAll<HTMLButtonElement>('[data-framework-option]')];

    const selectedOption = () =>
      options.find((option) => option.getAttribute('aria-selected') === 'true') ?? options[0];

    const setOpen = (open: boolean) => {
      const wasOpen = root.classList.contains('is-open');
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      if (open) menu.removeAttribute('inert');
      else menu.setAttribute('inert', '');
      if (open && !wasOpen) selectedOption()?.focus();
    };

    trigger.addEventListener('click', () => {
      setOpen(!root.classList.contains('is-open'));
    });

    trigger.addEventListener('keydown', (event) => {
      if (!['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) return;
      event.preventDefault();
      setOpen(true);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !root.classList.contains('is-open')) return;
      event.stopPropagation();
      setOpen(false);
      trigger.focus();
    });

    menu.addEventListener('click', (event) => {
      if (!(event.target as Element | null)?.closest('[data-framework-option]')) return;
      setOpen(false);
      trigger.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });
  });

  // A nudge towards the framework selector: nobody looks for a switch they have
  // no reason to expect. It waits for the page to settle, then points at the
  // control for about as long as a glance takes.
  //
  // Asking exactly once is too easy to miss, so it is allowed a few sightings
  // and retires for good the moment the reader switches, which is the thing it
  // was asking for. The count lives in `framework-hint-seen`; a `1` left by the
  // once-only version counts as one sighting.
  const HINT_KEY = 'framework-hint-seen';
  const HINT_LIMIT = 3;
  const HINT_DELAY = 2200;
  const HINT_LIFE = 12000;

  document.querySelectorAll<HTMLElement>('[data-framework-select]').forEach((root) => {
    const hint = root.querySelector<HTMLElement>('[data-framework-hint]');
    const trigger = root.querySelector<HTMLButtonElement>('.framework-select__trigger');
    if (!hint || !trigger) return;

    let seen = 0;
    try {
      seen = Number(window.localStorage.getItem(HINT_KEY)) || 0;
    } catch {}
    if (seen >= HINT_LIMIT) return;

    let hideTimer: number | undefined;
    let shown = false;

    const stopForGood = () => {
      try {
        window.localStorage.setItem(HINT_KEY, String(HINT_LIMIT));
      } catch {}
    };

    // The reader switched: the nudge has done its job, so it retires.
    const switched = () => {
      stopForGood();
      dismiss();
    };

    // Draw the leader from the card's top-left corner to the bottom of the
    // selector. A curve rather than a stub, so it reaches the selector wherever
    // the bar puts it — a centred bar can leave it hundreds of pixels inside
    // the screen's corner, and a narrow one puts it a few.
    const pointLeader = () => {
      const card = hint.querySelector<HTMLElement>('.framework-hint__card');
      const line = hint.querySelector<SVGPathElement>('.framework-hint__leader-line');
      const head = hint.querySelector<SVGGElement>('.framework-hint__leader-head');
      if (!card || !line || !head) return;

      const from = card.getBoundingClientRect();
      const to = trigger.getBoundingClientRect();
      const startX = from.left + 5;
      const startY = from.top + 7;
      const endX = to.left + to.width / 2;
      const endY = to.bottom + 8;
      // The curve dips below the gap and comes back up, so the arrow arrives at
      // the selector from underneath and points up at it. The dip grows with
      // the distance, and shrinks to a flick when the two are close.
      const bendX = (startX + endX) / 2;
      const bendY = Math.max(startY, endY) + Math.min(72, 26 + Math.abs(startX - endX) * 0.28);

      line.setAttribute('d', `M${startX} ${startY} Q${bendX} ${bendY} ${endX} ${endY}`);

      // The head sits on the selector end, turned along the curve's tangent.
      const angle = (Math.atan2(endY - bendY, endX - bendX) * 180) / Math.PI;
      head.setAttribute('transform', `translate(${endX} ${endY}) rotate(${angle})`);
    };

    const dismiss = () => {
      if (!shown) return;
      shown = false;
      window.clearTimeout(hideTimer);
      hint.hidden = true;
      trigger.classList.remove('is-hinting');
      window.removeEventListener('keydown', onKey);
      document.removeEventListener('framework-change', switched);
      trigger.removeEventListener('keydown', onTriggerKey);
      window.removeEventListener('resize', pointLeader);
    };

    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') dismiss();
    };

    const onTriggerKey = (event: KeyboardEvent) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) dismiss();
    };

    window.setTimeout(() => {
      // The reader may have found the selector, or switched, in the meantime.
      if (root.classList.contains('is-open')) return;
      // Out of the bar: its backdrop blur would anchor this fixed card to the
      // bar instead of the viewport.
      if (hint.parentElement !== document.body) document.body.append(hint);
      shown = true;
      hint.hidden = false;
      pointLeader();
      window.addEventListener('resize', pointLeader);
      // The bar settles late: the star count arrives from GitHub after first
      // paint and nudges everything beside it. Draw again once it has.
      window.setTimeout(pointLeader, 900);
      window.setTimeout(pointLeader, 2400);
      trigger.classList.add('is-hinting');
      try {
        window.localStorage.setItem(HINT_KEY, String(seen + 1));
      } catch {}
      window.addEventListener('keydown', onKey);
      document.addEventListener('framework-change', switched);
      hint.querySelector('.framework-hint__close')?.addEventListener('click', dismiss);
      // Reaching the selector — by pointer or by keyboard — is the nudge
      // working; it should get out of the way either way.
      trigger.addEventListener('click', dismiss, { once: true });
      trigger.addEventListener('keydown', onTriggerKey);
      hideTimer = window.setTimeout(dismiss, HINT_LIFE);
    }, HINT_DELAY);
  });
</script>

<style>
  .framework-select {
    position: relative;
  }

  .framework-select__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.55rem 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--background);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1;
    cursor: default;
    box-shadow: var(--shadow-hairline);
  }

  .framework-select__trigger:hover,
  .framework-select.is-open .framework-select__trigger {
    background: var(--secondary);
    border-color: var(--border-hover);
  }

  .framework-select__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .framework-select__value {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  :global(html:not([data-framework='gpui'])) .framework-select:not([data-selected]) .framework-select__value[data-framework-value='gpui'],
  :global(html[data-framework='gpui']) .framework-select:not([data-selected]) .framework-select__value[data-framework-value='slint'],
  .framework-select[data-selected='gpui'] .framework-select__value[data-framework-value='slint'],
  .framework-select[data-selected='slint'] .framework-select__value[data-framework-value='gpui'] {
    display: none;
  }

  .framework-select__logo {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
  }

  .framework-select__chevron {
    display: block;
    flex: none;
    color: var(--muted-foreground);
    transition: transform 160ms ease;
  }

  .framework-select.is-open .framework-select__chevron {
    transform: rotate(180deg);
  }

  .framework-select__menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 9.5rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--popover);
    box-shadow: var(--shadow-hairline), var(--shadow-panel);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 140ms ease,
      visibility 140ms ease;
  }

  .framework-select.is-open .framework-select__menu {
    opacity: 1;
    visibility: visible;
  }

  .framework-select__option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: left;
    cursor: default;
  }

  .framework-select__option:hover {
    background: var(--secondary);
  }

  :global(html[data-framework='gpui']) .framework-select:not([data-selected]) [data-framework-option='gpui'],
  :global(html:not([data-framework='gpui'])) .framework-select:not([data-selected]) [data-framework-option='slint'],
  .framework-select[data-selected='gpui'] [data-framework-option='gpui'],
  .framework-select[data-selected='slint'] [data-framework-option='slint'] {
    background: var(--secondary);
    font-weight: 600;
  }

  .framework-select__option span {
    flex: 1;
  }

  .framework-select__check {
    flex: none;
    color: var(--foreground);
    opacity: 0;
  }

  :global(html[data-framework='gpui']) .framework-select:not([data-selected]) [data-framework-option='gpui'] .framework-select__check,
  :global(html:not([data-framework='gpui'])) .framework-select:not([data-selected]) [data-framework-option='slint'] .framework-select__check,
  .framework-select[data-selected='gpui'] [data-framework-option='gpui'] .framework-select__check,
  .framework-select[data-selected='slint'] [data-framework-option='slint'] .framework-select__check {
    opacity: 1;
  }

  /* The nudge: a card in the corner, a leader drawn from it to the selector, a
     wiggle on the control, and a springy entrance. Every colour is a token. */
  /* A toast in the screen's top-right corner, and a leader drawn from it to the
     framework selector — which is the only way an arrow can point at a selector
     that a centred bar can put hundreds of pixels from the corner. The card is
     moved to the body before it shows, because the bar's backdrop blur would
     otherwise become the containing block for this fixed overlay. */
  .framework-hint {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .framework-hint__leader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--brand);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* `pathLength="1"` makes the dash a fraction of the whole, so the line draws
     itself without anyone measuring it. */
  .framework-hint__leader-line {
    stroke-dasharray: 1;
    animation: framework-hint-draw 620ms ease-out both;
  }

  .framework-hint__leader-head {
    animation: framework-hint-head 300ms ease-out 480ms both;
  }

  .framework-hint__card {
    position: absolute;
    top: calc(var(--nav-height, 56px) + 0.9rem);
    right: 1rem;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 11.5rem;
    padding: 0.55rem 1.7rem 0.6rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--brand) 32%, var(--border));
    border-radius: var(--radius-card);
    background: var(--popover);
    color: var(--foreground);
    box-shadow: var(--shadow-hairline), var(--shadow-panel);
    animation: framework-hint-in 340ms cubic-bezier(0.2, 1.35, 0.4, 1) both;
  }

  .framework-hint[hidden] {
    display: none;
  }

  .framework-hint__kicker {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 560;
    letter-spacing: 0.02em;
  }

  .framework-hint__value {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 640;
    letter-spacing: -0.014em;
  }

  .framework-hint__value .framework-select__logo {
    width: 0.9rem;
    height: 0.9rem;
  }

  /* It names the framework the reader is not on, the inverse of the trigger. */
  :global(html:not([data-framework='gpui'])) .framework-hint__value[data-framework-value='slint'],
  :global(html[data-framework='gpui']) .framework-hint__value[data-framework-value='gpui'] {
    display: none;
  }

  .framework-hint__close {
    position: absolute;
    top: 0.25rem;
    right: 0.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .framework-hint__close:hover {
    background: var(--secondary);
    color: var(--foreground);
  }

  .framework-select__trigger.is-hinting {
    animation: framework-hint-wiggle 1s ease-in-out 1;
  }

  @keyframes framework-hint-in {
    from {
      opacity: 0;
      transform: translateY(-0.3rem) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* The leader draws itself out to the selector, then its head arrives. */
  @keyframes framework-hint-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes framework-hint-head {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes framework-hint-wiggle {
    0%,
    100% {
      transform: rotate(0) scale(1);
    }
    20% {
      transform: rotate(-3.5deg) scale(1.05);
    }
    45% {
      transform: rotate(2.5deg) scale(1.02);
    }
    70% {
      transform: rotate(-1.5deg) scale(1.01);
    }
  }

  @media (max-width: 900px) {
    .framework-select__trigger {
      width: 2rem;
      padding: 0;
      justify-content: center;
      border-color: transparent;
      background: transparent;
      box-shadow: none;
    }

    .framework-select__name {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .framework-select__chevron {
      display: none;
    }

    .framework-select__trigger:hover,
    .framework-select.is-open .framework-select__trigger {
      border-color: transparent;
      background: var(--secondary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .framework-select__chevron,
    .framework-select__menu {
      transition: none;
    }

    /* The hint still arrives, it just does not perform. */
    .framework-hint__card,
    .framework-hint__leader-line,
    .framework-hint__leader-head,
    .framework-select__trigger.is-hinting {
      animation: none;
    }

    .framework-hint__leader-line {
      stroke-dashoffset: 0;
    }
  }
</style>
