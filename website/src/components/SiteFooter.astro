---
const base = import.meta.env.BASE_URL;

function url(path: string) {
  return `${base}${path}`.replace(/\/+/g, '/');
}

// The footer the site was asked for: a brand column, link columns, then a bar
// with social, copyright and back-to-top. The content is this project's, so
// where the reference block wants a newsletter and a street address this has
// the attribution instead -- the one place the site states where the work came
// from.
const columns = [
  {
    title: 'Project',
    links: [
      { text: 'Components', href: url('component') },
      { text: 'Blocks', href: url('blocks') },
      { text: 'Starter', href: url('starter') },
      { text: 'Skills', href: url('skills') },
    ],
  },
  {
    title: 'Registry',
    links: [
      { text: 'llms-full.txt', href: url('llms-full.txt'), external: true },
      { text: 'Source', href: 'https://github.com/MohsenDastaran/uni-kit/tree/main/registry', external: true },
      { text: 'npm', href: 'https://www.npmjs.com/package/@dastaran/uni-kit', external: true },
    ],
  },
  {
    title: 'Community',
    links: [
      { text: 'GitHub', href: 'https://github.com/MohsenDastaran/uni-kit', external: true },
      { text: 'Issues', href: 'https://github.com/MohsenDastaran/uni-kit/issues', external: true },
      { text: 'Discussions', href: 'https://github.com/MohsenDastaran/uni-kit/discussions', external: true },
    ],
  },
  {
    title: 'Credits',
    links: [
      { text: 'GPUI Kit', href: 'https://gpui-kit.com', external: true },
      { text: 'GPUI', href: 'https://gpui.rs', external: true },
      { text: 'Zed Industries', href: 'https://zed.dev', external: true },
      { text: 'Slint', href: 'https://slint.dev', external: true },
    ],
  },
];

const version = 'v0.7.1';
const year = new Date().getFullYear();
---

<footer class="kit-footer" aria-labelledby="footer-heading">
  <div class="kit-footer__glow" aria-hidden="true"></div>

  <div class="kit-footer__inner">
    <div class="kit-footer__top">
      <div class="kit-footer__brand">
        <div class="kit-footer__badges">
          <span class="kit-footer__badge kit-footer__badge--brand">uni-kit</span>
          <span class="kit-footer__badge">{version}</span>
        </div>

        <h2 id="footer-heading" class="kit-footer__lede">
          A fork of GPUI Kit, carried on under its own name.
        </h2>
        <p class="kit-footer__blurb">
          The component catalog, the guides and most of what is on this site
          began as <a href="https://gpui-kit.com" target="_blank" rel="noopener noreferrer">GPUI Kit</a>,
          by <a href="https://longbridge.com" target="_blank" rel="noopener noreferrer">Longbridge</a>.
          It is built on <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer">GPUI</a>,
          the UI framework from
          <a href="https://zed.dev" target="_blank" rel="noopener noreferrer">Zed Industries</a>.
          GPUI, GPUI Kit and this fork are all Apache-2.0.
        </p>
      </div>

      <div class="kit-footer__columns">
        {
          columns.map((column) => (
            <div class="kit-footer__column">
              <h3>{column.title}</h3>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="kit-footer__divider" aria-hidden="true"></div>

    <div class="kit-footer__bottom">
      <a
        class="kit-footer__social"
        href="https://github.com/MohsenDastaran/uni-kit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="uni-kit on GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.6 4.6 18.6 5 18.6 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
        </svg>
      </a>

      <p class="kit-footer__copy">
        © {year} uni-kit. Icons by
        <a href="https://lucide.dev" target="_blank" rel="noopener noreferrer">Lucide</a>
        and
        <a href="https://isocons.app" target="_blank" rel="noopener noreferrer">Isocons</a>.
      </p>

      <button class="kit-footer__top-btn" type="button" id="footer-to-top" aria-label="Back to top">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" />
          <path d="m5 12 7-7 7 7" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // The reference block scrolls to top; the arrow bobs while the page is live.
  document.getElementById('footer-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
