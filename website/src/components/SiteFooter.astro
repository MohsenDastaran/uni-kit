---
const base = import.meta.env.BASE_URL;

function url(path: string) {
  return `${base}${path}`.replace(/\/+/g, '/');
}

const links = [
  { text: 'Docs', href: url('docs') },
  { text: 'Components', href: url('component') },
  { text: 'Blocks', href: url('blocks') },
  { text: 'Starter', href: url('starter') },
  { text: 'Skills', href: url('skills') },
  { text: 'llms-full.txt', href: url('llms-full.txt'), external: true },
  { text: 'Report Bug', href: 'https://github.com/MohsenDastaran/uni-kit/issues', external: true },
  { text: 'Discussion', href: 'https://github.com/MohsenDastaran/uni-kit/discussions', external: true },
];

const copy = {
  nav: 'Footer navigation',
  // The origin of the work, which is also the reason the project can exist at
  // all: everything here started as GPUI Kit.
  fromPrefix: 'A fork of',
  fromMid: 'by',
  fromEnd:
    '. The component catalog, the guides, and most of what is on this site began there; this project is that tree carried on under its own name, and it would not exist without it.',
  // The framework underneath, which is the other debt worth naming.
  builtOn: 'Built on',
  attributionMid: ', the UI framework from ',
  attributionEnd: '. GPUI, GPUI Kit and this fork are all Apache-2.0.',
  iconCredits: 'Icons by',
  and: 'and',
  period: '.',
};
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <strong>uni-kit</strong>
    <p>
      {copy.fromPrefix}{' '}<a
        href="https://gpui-kit.com"
        target="_blank"
        rel="noopener noreferrer">GPUI Kit</a
      >{' '}{copy.fromMid}{' '}<a
        href="https://longbridge.com"
        target="_blank"
        rel="noopener noreferrer">Longbridge</a
      >{copy.fromEnd}
    </p>
    <p>
      {copy.builtOn}{' '}<a href="https://gpui.rs" target="_blank" rel="noopener noreferrer">GPUI</a
      >{copy.attributionMid}<a
        href="https://zed.dev"
        target="_blank"
        rel="noopener noreferrer">Zed Industries</a
      >{copy.attributionEnd}
    </p>
  </div>

  <nav aria-label={copy.nav}>
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >
        {link.text}
      </a>
    ))}
  </nav>

  <p class="site-footer__credits">
    {copy.iconCredits}{' '}<a href="https://lucide.dev" target="_blank" rel="noopener noreferrer">Lucide</a
    >{' '}{copy.and}{' '}<a href="https://isocons.app" target="_blank" rel="noopener noreferrer">Isocons</a
    >{copy.period}
  </p>
</footer>
