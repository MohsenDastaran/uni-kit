---
const base = import.meta.env.BASE_URL;

function url(path: string) {
  return `${base}${path}`.replace(/\/+/g, '/');
}

const links = [
  { text: 'Design Guides', href: url('docs/design-guides') },
  { text: 'Coding Guides', href: url('docs/coding-guides') },
  { text: 'Blocks', href: url('blocks') },
  { text: 'Starter', href: url('starter') },
  { text: 'Skills', href: url('skills') },
  { text: 'llms-full.txt', href: url('llms-full.txt'), external: true },
  { text: 'Report Bug', href: 'https://github.com/MohsenDastaran/uni-kit/issues', external: true },
  { text: 'Discussion', href: 'https://github.com/MohsenDastaran/uni-kit/discussions', external: true },
];

const copy = {
  nav: 'Footer navigation',
  prefix: 'Open source under the Apache-2.0 License, developed by',
  suffix: '.',
  builtOn: 'Built on',
  attributionMid: ', the UI framework from ',
  attributionEnd: ', also Apache-2.0.',
  iconCredits: 'Icons by',
  and: 'and',
  period: '.',
};
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <strong>GPUI Kit</strong>
    <p>
      {copy.prefix}{' '}<a href="https://longbridge.com" target="_blank" rel="noopener noreferrer">Longbridge</a
      >{copy.suffix}
    </p>
    <!-- The one place the site names GPUI's origin. See DESIGN.md, "Attribution". -->
    <p>
      {copy.builtOn}{' '}<a href="https://gpui.rs" target="_blank" rel="noopener noreferrer">GPUI</a
      >{copy.attributionMid}<a
        href="https://zed.dev"
        target="_blank"
        rel="noopener noreferrer">Zed Industries</a
      >{copy.attributionEnd}
    </p>
  </div>

  <nav aria-label={copy.nav}>
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >
        {link.text}
      </a>
    ))}
  </nav>

  <p class="site-footer__credits">
    {copy.iconCredits}{' '}<a href="https://lucide.dev" target="_blank" rel="noopener noreferrer">Lucide</a
    >{' '}{copy.and}{' '}<a href="https://isocons.app" target="_blank" rel="noopener noreferrer">Isocons</a
    >{copy.period}
  </p>
</footer>
