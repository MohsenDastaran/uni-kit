---
const base = import.meta.env.BASE_URL;

function url(path: string) {
  return `${base}${path}`.replace(/\/+/g, '/');
}

// The footer the site was asked for: a brand column, link columns, then a bar
// with social, copyright and back-to-top. The content is this project's, so
// where the reference block wants a newsletter and a street address this has
// the attribution instead -- the one place the site states where the work came
// from.
const columns = [
  {
    title: 'Project',
    links: [
      { text: 'Components', href: url('component') },
      { text: 'Blocks', href: url('blocks') },
      { text: 'Starter', href: url('starter') },
      { text: 'Skills', href: url('skills') },
    ],
  },
  {
    title: 'Registry',
    links: [
      { text: 'llms-full.txt', href: url('llms-full.txt'), external: true },
      { text: 'Source', href: 'https://github.com/MohsenDastaran/uni-kit/tree/main/registry', external: true },
      { text: 'npm', href: 'https://www.npmjs.com/package/@dastaran/uni-kit', external: true },
    ],
  },
  {
    title: 'Community',
    links: [
      { text: 'GitHub', href: 'https://github.com/MohsenDastaran/uni-kit', external: true },
      { text: 'Issues', href: 'https://github.com/MohsenDastaran/uni-kit/issues', external: true },
      { text: 'Discussions', href: 'https://github.com/MohsenDastaran/uni-kit/discussions', external: true },
    ],
  },
  {
    title: 'Credits',
    links: [
      { text: 'GPUI Kit', href: 'https://gpui-kit.com', external: true },
      { text: 'GPUI', href: 'https://gpui.rs', external: true },
      { text: 'Zed Industries', href: 'https://zed.dev', external: true },
      { text: 'Slint', href: 'https://slint.dev', external: true },
    ],
  },
];

const version = 'v0.7.1';
const year = new Date().getFullYear();
---

<footer class="kit-footer" aria-labelledby="footer-heading">
  <div class="kit-footer__glow" aria-hidden="true"></div>

  <div class="kit-footer__inner">
    <div class="kit-footer__top">
      <div class="kit-footer__brand kit-footer__reveal">
        <div class="kit-footer__badges">
          <span class="kit-footer__badge kit-footer__badge--brand">uni-kit</span>
          <span class="kit-footer__badge">{version}</span>
        </div>

        <h2 id="footer-heading" class="kit-footer__lede">
          A fork of GPUI Kit, carried on under its own name.
        </h2>
        <p class="kit-footer__blurb">
          The component catalog, the guides and most of what is on this site began as{' '}
          <a href="https://gpui-kit.com" target="_blank" rel="noopener noreferrer">GPUI Kit</a>, by{' '}
          <a href="https://longbridge.com" target="_blank" rel="noopener noreferrer">Longbridge</a>.
          It is built on{' '}
          <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer">GPUI</a>, the UI framework
          from{' '}
          <a href="https://zed.dev" target="_blank" rel="noopener noreferrer">Zed Industries</a>. GPUI,
          GPUI Kit and this fork are all Apache-2.0.
        </p>
      </div>

      <div class="kit-footer__columns">
        {
          columns.map((column, index) => (
            <div class="kit-footer__column kit-footer__reveal" style={`--i: ${index + 1}`}>
              <h3>{column.title}</h3>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="kit-footer__divider" aria-hidden="true"></div>

    <div class="kit-footer__bottom">
      <div class="kit-footer__socials kit-footer__reveal" style="--i: 5">
        <a
          class="kit-footer__social"
          href="https://github.com/MohsenDastaran/uni-kit"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.6 4.6 18.6 5 18.6 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
          </svg>
        </a>

        <a
          class="kit-footer__social"
          href="https://www.linkedin.com/in/mohsendastaran"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
          </svg>
        </a>

        <a
          class="kit-footer__social"
          href="https://t.me/MohsenDastaran"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Telegram"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm5.57 8.16-1.97 9.3c-.15.66-.54.83-1.09.51l-3-2.21-1.45 1.4c-.16.16-.3.31-.6.31l.21-3.05 5.56-5.02c.24-.21-.05-.33-.37-.12l-6.87 4.33-2.96-.93c-.64-.2-.66-.64.14-.95l11.56-4.46c.53-.2 1 .12.84.89Z" />
          </svg>
        </a>

        <a class="kit-footer__social" href="mailto:mohsen.dastaran@gmail.com" aria-label="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        </a>

        <a
          class="kit-footer__social"
          href="https://mohsen.dastaran.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="mohsen.dastaran.com"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
          </svg>
        </a>
      </div>

      <p class="kit-footer__copy kit-footer__reveal" style="--i: 6">
        © {year} uni-kit. Icons by{' '}
        <a href="https://lucide.dev" target="_blank" rel="noopener noreferrer">Lucide</a> and{' '}
        <a href="https://isocons.app" target="_blank" rel="noopener noreferrer">Isocons</a>.
      </p>

      <button class="kit-footer__top-btn kit-footer__reveal" style="--i: 7" type="button" id="footer-to-top" aria-label="Back to top">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" />
          <path d="m5 12 7-7 7 7" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // The reference animates each part in as it scrolls into view. That is an
  // intersection here rather than framer-motion's `whileInView`, and the parts
  // stagger by their `--i`.
  const footer = document.querySelector('.kit-footer');
  const parts = footer?.querySelectorAll('.kit-footer__reveal') ?? [];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer && parts.length && !still) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      // No negative bottom margin: the last row sits at the very bottom of the
      // page, where anything that shrinks the viewport would keep it hidden
      // forever rather than merely late.
      { rootMargin: '0px' },
    );
    for (const part of parts) observer.observe(part);
  } else {
    for (const part of parts) part.classList.add('is-in');
  }

  document.getElementById('footer-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
