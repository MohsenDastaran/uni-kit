---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnimatedToc from '../components/AnimatedToc.vue';
import CodeBlock from '../components/CodeBlock.vue';
import InstallCommand from '../components/InstallCommand.vue';
import type { SidebarItem } from '../lib/sidebar';
import { fetchStarCount } from '../lib/github';
import { SITE_URL } from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  sidebar?: SidebarItem[];
  frontmatter?: Record<string, any>;
  /** Extra class for the article, for a page whose content needs its own rules. */
  contentClass?: string;
  /** Extra class for the layout row, e.g. a wider component-page shell. */
  layoutClass?: string;
  /** Extra class for the main column. */
  mainClass?: string;
  /** Extra attributes for the article, for the same reason. */
  contentData?: Record<string, string | undefined>;
  /** The framework this page is permanently rendered in. */
  framework?: string;
  frameworkFixed?: boolean;
  frameworkAvailable?: string;
  /** The component slug used by the install command on a framework page. */
  installSlug?: string;
  /** Override the canonical URL for legacy pages that redirect to a framework URL. */
  canonical?: string;
}

const {
  title,
  description,
  sidebar = [],
  frontmatter = {},
  contentClass,
  layoutClass,
  mainClass,
  contentData = {},
  framework,
  frameworkFixed = false,
  frameworkAvailable,
  installSlug,
  canonical: canonicalOverride,
} = Astro.props;
const hasSidebar = sidebar.length > 0;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const canonical = canonicalOverride ?? `${SITE_URL}${pathname}`;

let starCount = 0;
try {
  starCount = await fetchStarCount();
} catch {}

const segments = pathname.split('/').filter(Boolean);
const itemListElement = segments
  .map((segment, index, visibleSegments) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: index === visibleSegments.length - 1 && title
      ? title
      : segment.replace(/[-_]/g, ' ').replace(/\b\w/g, char => char.toUpperCase()),
    item: `${SITE_URL}/${visibleSegments.slice(0, index + 1).join('/')}`,
  }));
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonical={canonical} framework={framework} frameworkFixed={frameworkFixed} frameworkAvailable={frameworkAvailable} structuredData={structuredData}>
  <Nav currentPath={pathname} starCount={starCount} framework={framework ?? "nsh"} />

  <div class:list={['docs-layout', layoutClass]}>
    {hasSidebar && <Sidebar items={sidebar} currentPath={pathname} />}

    <main class:list={['docs-main', { 'docs-main--full': !hasSidebar }, mainClass]}>
      <article
        class:list={['doc-content', contentClass]}
        data-pagefind-body
        {...contentData}
      >
        <slot />
      </article>
      <CodeBlock
        client:load
        copyLabel="Copy code"
        copiedLabel="Copied"
      />
      <InstallCommand client:load slug={installSlug} />
    </main>

    {hasSidebar && <AnimatedToc client:load />}
  </div>

  <!-- Page-level, so it spans the shared content box rather than the
       article's reading measure. -->
  <SiteFooter framework={framework ?? "nsh"} />
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>
