---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Toc from '../components/Toc.astro';
import CodeBlock from '../components/CodeBlock.vue';
import InstallCommand from '../components/InstallCommand.vue';
import type { Heading } from '../components/Toc.astro';
import type { SidebarItem } from '../lib/sidebar';
import { fetchStarCount } from '../lib/github';
import { SITE_URL } from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  sidebar?: SidebarItem[];
  headings?: Heading[];
  frontmatter?: Record<string, any>;
  /** Extra class for the article, for a page whose content needs its own rules. */
  contentClass?: string;
  /** Extra attributes for the article, for the same reason. */
  contentData?: Record<string, string | undefined>;
}

const {
  title,
  description,
  sidebar = [],
  headings = [],
  frontmatter = {},
  contentClass,
  contentData = {},
} = Astro.props;
const hasSidebar = sidebar.length > 0;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const canonical = `${SITE_URL}${pathname}`;

let starCount = 0;
try {
  starCount = await fetchStarCount();
} catch {}

const segments = pathname.split('/').filter(Boolean);
const itemListElement = segments
  .map((segment, index, visibleSegments) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: index === visibleSegments.length - 1 && title
      ? title
      : segment.replace(/[-_]/g, ' ').replace(/\b\w/g, char => char.toUpperCase()),
    item: `${SITE_URL}/${visibleSegments.slice(0, index + 1).join('/')}`,
  }));
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  },
];
---

<BaseLayout title={title} description={description} lang="en" canonical={canonical} structuredData={structuredData}>
  <Nav currentPath={pathname} starCount={starCount} />

  <div class="docs-layout">
    {hasSidebar && <Sidebar items={sidebar} currentPath={pathname} />}

    <main class:list={['docs-main', { 'docs-main--full': !hasSidebar }]}>
      <article
        class:list={['doc-content', contentClass]}
        data-pagefind-body
        {...contentData}
      >
        <slot />
      </article>
      <CodeBlock
        client:load
        copyLabel="Copy code"
        copiedLabel="Copied"
      />
      <InstallCommand client:load />
    </main>

    {hasSidebar && <Toc headings={headings} />}
  </div>

  <!-- Page-level, so it spans the shared content box rather than the
       article's reading measure. -->
  <SiteFooter />
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>
