---
import { SITE_URL } from "../lib/site";
import { DEFAULT_THEME_ID, themeInfo } from "../lib/theme-catalog";

export interface Props {
    title?: string;
    description?: string;
    lang?: string;
    ogTitle?: string;
    canonical?: string;
    robots?: string;
    alternates?: boolean;
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title,
    description = "A comprehensive Rust framework for building fantastic, high-performance desktop apps with GPUI.",
    lang = "en",
    ogTitle,
    canonical = new URL(Astro.url.pathname, SITE_URL).href,
    robots,
    alternates = true,
    structuredData,
} = Astro.props;

const SITE_TITLE = "uni-kit";
const OG_IMAGE = `${SITE_URL}/og.png`;

const pageTitle =
    !title || title === SITE_TITLE
        ? SITE_TITLE
        : title.includes(SITE_TITLE)
          ? title
          : `${title} · ${SITE_TITLE}`;
const socialTitle = ogTitle ?? pageTitle;
const base = import.meta.env.BASE_URL;

const path = Astro.url.pathname;
const pageUrl = new URL(path, SITE_URL).href;

const defaultStructuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    url: SITE_URL,
    description,
};
const jsonLd = JSON.stringify(structuredData ?? defaultStructuredData).replace(
    /</g,
    "\\u003c",
);
---

<!doctype html>
<html lang={lang} data-framework="slint">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        {robots && <meta name="robots" content={robots} />}
        <title>{pageTitle}</title>

        <!-- Favicon -->
        <!-- One SVG favicon, whatever the theme: a browser tab is not the page,
         and the mark does not change for it. iOS will not take an SVG, so the
         home-screen icon stays a raster. -->
        <link rel="icon" href={`${base}uni-kit.svg`} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={`${base}uni-kit.png`} />
        <link rel="stylesheet" href={`${base}theme-tokens.css`} />

        <!-- OG / Twitter -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_TITLE} />
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={OG_IMAGE} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="2400" />
        <meta property="og:image:height" content="1260" />
        <meta property="og:image:alt" content={SITE_TITLE} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={socialTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE} />
        <link rel="canonical" href={canonical} />
        {alternates && <link rel="alternate" hreflang="en" href={pageUrl} />}
        {alternates && (
            <link rel="alternate" hreflang="x-default" href={pageUrl} />
        )}
        <script type="application/ld+json" set:html={jsonLd} />
        <!-- Theme: apply before paint to avoid FOUC -->
        <script is:inline define:vars={{ themeInfo, base, defaultThemeId: DEFAULT_THEME_ID }}>
            (function () {
                const stored = localStorage.getItem("theme");
                const systemTheme = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                );
                // A palette from the catalog, one of the picker's own three
                // options, or — for a first visit — the default palette.
                const chosen =
                    themeInfo[stored] ||
                    stored === "system" ||
                    stored === "light" ||
                    stored === "dark"
                        ? stored
                        : defaultThemeId;
                const selected = themeInfo[chosen];
                if (selected) {
                    document.documentElement.dataset.theme = chosen;
                    document.documentElement.dataset.themeName = selected.name;
                    document.documentElement.dataset.themeSource = `${base}theme-data/${selected.source}.json`;
                }
                // Only "Follow System" tracks the system, and only when it has
                // been asked for: the default is a palette, not a preference.
                const mode = selected ? selected.mode : chosen;
                document.documentElement.classList.toggle(
                    "dark",
                    mode === "system" ? systemTheme.matches : mode === "dark",
                );
                systemTheme.addEventListener("change", (event) => {
                    if (localStorage.getItem("theme") === "system")
                        document.documentElement.classList.toggle(
                            "dark",
                            event.matches,
                        );
                });
            })();
        </script>
        <!-- Framework: pick the code blocks before paint so they never flash.
         A `?framework=` in the address bar is the view being asked for, which
         is what makes one shareable and citable; the stored choice is what the
         reader last asked for; Slint is what a first visit gets. -->
        <script is:inline>
            (function () {
                const asked = new URLSearchParams(location.search).get(
                    "framework",
                );
                let stored = null;
                try {
                    stored = localStorage.getItem("selected-framework");
                } catch {}
                const chosen =
                    asked === "gpui" || asked === "slint" ? asked : stored;
                const framework = chosen === "gpui" ? "gpui" : "slint";
                document.documentElement.dataset.framework = framework;
                // A pinned view becomes the choice for the pages that follow it, so a
                // link shared with the parameter keeps its meaning after a click.
                if (asked === "gpui" || asked === "slint") {
                    try {
                        localStorage.setItem("selected-framework", framework);
                    } catch {}
                }
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
