---
import { SITE_URL } from "../lib/site";
import { DEFAULT_THEME_ID, themeInfo } from "../lib/theme-catalog";

export interface Props {
    title?: string;
    description?: string;
    lang?: string;
    ogTitle?: string;
    canonical?: string;
    robots?: string;
    alternates?: boolean;
    /** The server-rendered framework for a framework-specific page. */
    framework?: string;
    /** Framework pages keep the URL's framework instead of a stored choice. */
    frameworkFixed?: boolean;
    /** The framework/component combinations available on this page. */
    frameworkAvailable?: string;
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title,
    description = "A universal, framework-agnostic ecosystem of UI components. With more GUI frameworks on the way.",
    lang = "en",
    ogTitle,
    canonical = new URL(Astro.url.pathname, SITE_URL).href,
    robots,
    alternates = true,
    framework,
    frameworkFixed = false,
    frameworkAvailable,
    structuredData,
} = Astro.props;

const SITE_TITLE = "uni-kit";
const OG_IMAGE = `${SITE_URL}/og.png`;

const pageTitle =
    !title || title === SITE_TITLE
        ? SITE_TITLE
        : title.includes(SITE_TITLE)
          ? title
          : `${title} · ${SITE_TITLE}`;
const socialTitle = ogTitle ?? pageTitle;
const base = import.meta.env.BASE_URL;

const path = Astro.url.pathname;
const pageUrl = new URL(path, SITE_URL).href;

const defaultStructuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_TITLE,
    url: SITE_URL,
    description,
};
const jsonLd = JSON.stringify(structuredData ?? defaultStructuredData).replace(
    /</g,
    "\\u003c",
);
---

<!doctype html>
<html
    lang={lang}
    data-framework={framework ?? "nsh"}
    data-framework-fixed={frameworkFixed ? "true" : undefined}
    data-framework-available={frameworkAvailable}
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        {robots && <meta name="robots" content={robots} />}
        <title>{pageTitle}</title>

        <!-- Favicon -->
        <!-- One SVG favicon, whatever the theme: a browser tab is not the page,
         and the mark does not change for it. iOS will not take an SVG, so the
         home-screen icon stays a raster. -->
        <link rel="icon" href={`${base}uni-kit.svg`} type="image/svg+xml" />
        <!-- Google Search does not read an SVG favicon, so the mark is declared a
         second time as a raster it does read. The SVG stays first for browsers
         that take it, because it is the one that scales. -->
        <link rel="icon" href={`${base}uni-kit.png`} type="image/png" />
        <link rel="apple-touch-icon" href={`${base}uni-kit.png`} />
        <link rel="manifest" href={`${base}site.webmanifest`} />
        <!-- The colour a mobile browser paints its toolbar, per appearance. Both
         are the theme tokens' background, so the bar matches the page. -->
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#040404" media="(prefers-color-scheme: dark)" />
        <link rel="stylesheet" href={`${base}theme-tokens.css`} />

        <!-- OG / Twitter -->
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content={SITE_TITLE} />
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={OG_IMAGE} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="2400" />
        <meta property="og:image:height" content="1260" />
        <meta property="og:image:alt" content={SITE_TITLE} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={socialTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE} />
        <link rel="canonical" href={canonical} />
        {alternates && <link rel="alternate" hreflang="en" href={pageUrl} />}
        {alternates && (
            <link rel="alternate" hreflang="x-default" href={pageUrl} />
        )}
        <script type="application/ld+json" set:html={jsonLd} />
        <!-- Theme: apply before paint to avoid FOUC -->
        <script is:inline define:vars={{ themeInfo, base, defaultThemeId: DEFAULT_THEME_ID }}>
            (function () {
                const stored = localStorage.getItem("theme");
                const systemTheme = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                );
                // A palette from the catalog, one of the picker's own three
                // options, or — for a first visit — the default palette.
                const chosen =
                    themeInfo[stored] ||
                    stored === "system" ||
                    stored === "light" ||
                    stored === "dark"
                        ? stored
                        : defaultThemeId;
                const selected = themeInfo[chosen];
                if (selected) {
                    document.documentElement.dataset.theme = chosen;
                    document.documentElement.dataset.themeName = selected.name;
                    document.documentElement.dataset.themeSource = `${base}theme-data/${selected.source}.json`;
                }
                // Only "Follow System" tracks the system, and only when it has
                // been asked for: the default is a palette, not a preference.
                const mode = selected ? selected.mode : chosen;
                document.documentElement.classList.toggle(
                    "dark",
                    mode === "system" ? systemTheme.matches : mode === "dark",
                );
                systemTheme.addEventListener("change", (event) => {
                    if (localStorage.getItem("theme") === "system")
                        document.documentElement.classList.toggle(
                            "dark",
                            event.matches,
                        );
                });
            })();
        </script>
        <!-- Framework: pick the code blocks before paint so they never flash.
         A `?framework=` in the address bar is an old share link; it is moved to
         the clean framework route before paint. The stored choice is what the
         reader last asked for; NSH is what a first visit gets. -->
        <script is:inline>
            (function () {
                const FRAMEWORKS = ["gpui", "slint", "iced", "nsh"];
                const root = document.documentElement;
                const server = root.dataset.framework || "nsh";
                const fixed = root.dataset.frameworkFixed === "true";
                const asked = new URLSearchParams(location.search).get(
                    "framework",
                );
                // The query form was the old way to pin a framework. Move it
                // to the clean, indexable framework route before paint.
                const componentPage = location.pathname.match(
                    /^\/component(?:\/([^/]+))?$/,
                );
                if (
                    asked &&
                    FRAMEWORKS.includes(asked) &&
                    componentPage
                ) {
                    const available = (
                        root.dataset.frameworkAvailable || ""
                    ).split(/\s+/);
                    const slug = componentPage[1]
                        ? `/${componentPage[1]}`
                        : "";
                    const suffix =
                        slug && available.length > 1 && !available.includes(asked)
                            ? ""
                            : slug;
                    location.replace(`/frameworks/${asked}${suffix}`);
                    return;
                }
                let stored = null;
                try {
                    stored = localStorage.getItem("selected-framework");
                } catch {}
                const chosen = FRAMEWORKS.includes(asked) ? asked : stored;
                const framework = fixed
                    ? server
                    : FRAMEWORKS.includes(chosen)
                      ? chosen
                      : server;
                document.documentElement.dataset.framework = framework;
                // The document title is rendered with the GPUI suffix in the
                // static HTML. Rewrite it before paint so a reader whose stored
                // or requested view is NSH (or Slint/iced) never sees the wrong
                // framework named in the tab. Pages without that suffix keep
                // their own title.
                const titled = document.title.match(
                    /^(.*?) — (GPUI|Slint|Iced|NSH) Component( · .*)?$/,
                );
                if (titled) {
                    const name = {
                        gpui: "GPUI Component",
                        slint: "Slint Component",
                        iced: "Iced Component",
                        nsh: "NSH Component",
                    }[framework];
                    document.title = `${titled[1]} — ${name}${titled[3] ?? ""}`;
                }
                // A pinned view becomes the choice for the pages that follow it, so a
                // link shared with the parameter keeps its meaning after a click.
                if (!fixed && FRAMEWORKS.includes(asked)) {
                    try {
                        localStorage.setItem("selected-framework", framework);
                    } catch {}
                }
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
