---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import ComponentPageFooter from '../../components/ComponentPageFooter.astro';
import { componentNeighbours, enComponentSidebar } from '../../lib/sidebar';
import ComponentExample from '../../components/ComponentExample.vue';
import { hasIcedExample, hasIcedPage } from '../../lib/remark-iced-source.js';
import { hasNshExample, hasNshPage } from '../../lib/remark-nsh-source.js';
import { hasSlintExample, hasSlintPage } from '../../lib/remark-slint-source.js';
import { FRAMEWORKS } from '../../lib/rehype-framework-code.js';
import { gallerySizes } from '../../lib/gallery-sizes';

export async function getStaticPaths() {
  const entries = await getCollection('component');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, '');
const frameworks = [
  ...(hasSlintExample(slug) ? ['slint'] : []),
  ...(hasIcedExample(slug) ? ['iced'] : []),
  ...(hasNshExample(slug) ? ['nsh'] : []),
];
const pathname = Astro.url.pathname;
// The current main checkout owns the single WASM deployment at the site root.
const examplesBase = '/';
const devVersion = import.meta.env.DEV ? 'dev' : undefined;

// The sizes this page's loader prints: the shared GPUI gallery and, when the
// component has one, its Slint page.
const sizes = (() => {
  const all = gallerySizes();
  return {
    gallery: all.gallery,
    ...(slug === 'index' ? {} : { [`slint-gallery/pages/${slug}`]: all[`slint-gallery/pages/${slug}`] }),
    ...(slug === 'index' ? {} : { 'nsh-gallery': all['nsh-gallery'] }),
  };
})();
const seoTitle = entry.id.replace(/\.md$/, '') === 'index' ? entry.data.title : `${entry.data.title} — NSH Component`;

// The index lists every component, so it reads in the frameworks that have
// components; a component with no Slint or iced side says so, and the framework
// switch sends the reader back to the list rather than leaving them on a page
// with nothing to show. Every page declares what it has, so choosing a
// framework it does not have always has an answer.
const slintPage = slug === 'index' || hasSlintPage(slug, entry.data.example);
const icedPage = hasIcedPage(slug, entry.data.example);
const nshPage = slug === 'index' || hasNshPage(slug, entry.data.example);
const contentData = {
  'data-framework-available': [
    'gpui',
    ...(slintPage ? ['slint'] : []),
    ...(icedPage ? ['iced'] : []),
    ...(nshPage ? ['nsh'] : []),
  ].join(' '),
  'data-framework-fallback': `${import.meta.env.BASE_URL}component`,
};

// The two closing sections live on component pages only: the index is the
// catalog, not a component, and the block and starter routes never reach this
// page. Both read the sidebar's own ordered catalog, so the framework rows and
// the previous/next pair are the same list the reader sees beside the page.
const neighbours = slug === 'index' ? {} : componentNeighbours(enComponentSidebar, pathname);
const footerFrameworks =
  neighbours.current?.frameworkAvailable ?? contentData['data-framework-available'];
// The framework is a client-side choice on a static page, so the walk is cut
// once per framework the site has and the stylesheet's `data-framework-only`
// switch shows the pair in force. A neighbour with no view in that framework is
// skipped, the way the sidebar hides its row.
const pagers = FRAMEWORKS.map((framework) => ({
  framework,
  ...componentNeighbours(enComponentSidebar, pathname, framework),
}));
---

<DocsLayout
  title={seoTitle}
  description={entry.data.description}
  sidebar={enComponentSidebar}
  contentClass={slug === 'index' ? 'doc-content--component-index' : undefined}
  layoutClass={slug === 'index' ? undefined : 'docs-layout--component'}
  mainClass={slug === 'index' ? undefined : 'docs-main--component'}
  contentData={contentData}
  frameworkAvailable={contentData['data-framework-available']}
>
  <Content />
  {slug !== 'index' && (
    <ComponentPageFooter
      frameworks={footerFrameworks}
      pagers={pagers}
      slug={slug}
    />
  )}
  {entry.data.example !== false && (
    <ComponentExample
      client:load
      frontmatter={entry.data}
      pathname={pathname}
      baseUrl={examplesBase}
      devVersion={devVersion}
      frameworks={frameworks}
      sizes={sizes}
    />
  )}
</DocsLayout>
