---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { enComponentSidebar } from '../../lib/sidebar';
import ComponentExample from '../../components/ComponentExample.vue';
import { hasSlintExample } from '../../lib/remark-slint-source.js';

export async function getStaticPaths() {
  const entries = await getCollection('component');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id.replace(/\.md$/, '');
const frameworks = hasSlintExample(slug) ? ['slint'] : [];
const pathname = Astro.url.pathname;
// The current main checkout owns the single WASM deployment at the site root.
const examplesBase = '/';
const devVersion = import.meta.env.DEV ? 'dev' : undefined;
const seoTitle = entry.id.replace(/\.md$/, '') === 'index' ? entry.data.title : `${entry.data.title} — GPUI Component`;
---

<DocsLayout
  title={seoTitle}
  description={entry.data.description}
  headings={headings}
  sidebar={enComponentSidebar}
>
  <Content />
  {entry.data.example !== false && (
    <ComponentExample
      client:load
      frontmatter={entry.data}
      pathname={pathname}
      baseUrl={examplesBase}
      devVersion={devVersion}
      frameworks={frameworks}
    />
  )}
</DocsLayout>
