---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { enComponentSidebar } from '../../lib/sidebar';
import ComponentExample from '../../components/ComponentExample.vue';
import { hasIcedExample, hasIcedPage } from '../../lib/remark-iced-source.js';
import { hasSlintExample, hasSlintPage } from '../../lib/remark-slint-source.js';
import { gallerySizes } from '../../lib/gallery-sizes';

export async function getStaticPaths() {
  const entries = await getCollection('component');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, '');
const frameworks = [
  ...(hasSlintExample(slug) ? ['slint'] : []),
  ...(hasIcedExample(slug) ? ['iced'] : []),
];
const pathname = Astro.url.pathname;
// The current main checkout owns the single WASM deployment at the site root.
const examplesBase = '/';
const devVersion = import.meta.env.DEV ? 'dev' : undefined;

// The sizes this page's loader prints: the shared GPUI gallery and, when the
// component has one, its Slint page.
const sizes = (() => {
  const all = gallerySizes();
  return {
    gallery: all.gallery,
    ...(slug === 'index' ? {} : { [`slint-gallery/pages/${slug}`]: all[`slint-gallery/pages/${slug}`] }),
  };
})();
const seoTitle = entry.id.replace(/\.md$/, '') === 'index' ? entry.data.title : `${entry.data.title} — GPUI Component`;

// The index lists every component, so it reads in the frameworks that have
// components; a component with no Slint or iced side says so, and the framework
// switch sends the reader back to the list rather than leaving them on a page
// with nothing to show. Every page declares what it has, so choosing a
// framework it does not have always has an answer.
const slintPage = slug === 'index' || hasSlintPage(slug, entry.data.example);
const icedPage = hasIcedPage(slug, entry.data.example);
const contentData = {
  'data-framework-available': [
    'gpui',
    ...(slintPage ? ['slint'] : []),
    ...(icedPage ? ['iced'] : []),
  ].join(' '),
  'data-framework-fallback': `${import.meta.env.BASE_URL}component`,
};
---

<DocsLayout
  title={seoTitle}
  description={entry.data.description}
  sidebar={enComponentSidebar}
  contentClass={slug === 'index' ? 'doc-content--component-index' : undefined}
  contentData={contentData}
>
  <Content />
  {entry.data.example !== false && (
    <ComponentExample
      client:load
      frontmatter={entry.data}
      pathname={pathname}
      baseUrl={examplesBase}
      devVersion={devVersion}
      frameworks={frameworks}
      sizes={sizes}
    />
  )}
</DocsLayout>
