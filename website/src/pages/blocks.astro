---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BlocksGallery from "../components/BlocksGallery.vue";
import DocsLayout from "../layouts/DocsLayout.astro";
import { SITE_URL } from "../lib/site";
import { gallerySizes } from "../lib/gallery-sizes";
import { highlight } from "../lib/highlight.js";

const website = process.cwd();
const repo = join(website, "..");

// The first Rust fence long enough to be usage rather than an import: every
// component page opens with a one-line `use`, which is not what a reader wants
// to copy.
function gpuiUsage(doc: string) {
    try {
        const md = readFileSync(
            join(website, "component", `${doc}.md`),
            "utf8",
        );
        const fences = [...md.matchAll(/```rust\n([\s\S]*?)```/g)].map(
            (match) => match[1],
        );
        return (
            fences.find((fence) => fence.trim().split("\n").length > 5) ??
            fences[0] ??
            ""
        );
    } catch {
        return "";
    }
}

// The Slint gallery example is the block: the same file the live page runs.
function slintExample(slug: string) {
    try {
        return readFileSync(
            join(repo, "crates/slint-component/ui/examples", `${slug}.slint`),
            "utf8",
        );
    } catch {
        return "";
    }
}

// The GPUI block is a file you install, so the prompt carries it verbatim
// rather than a component page's usage. A block with no file yet falls back to
// that usage, which is what the crate alone can offer.
function gpuiBlock(id: string) {
    try {
        return readFileSync(
            join(repo, "crates/blocks/src", `${id}.rs`),
            "utf8",
        );
    } catch {
        return "";
    }
}

// The iced block is a gallery story rather than an installed file: the site
// shows the screen the gallery runs, and the prompt carries that screen's
// source. The story name is the file name with hyphens as underscores.
function icedBlock(story: string) {
    try {
        return readFileSync(
            join(
                repo,
                "crates/iced-component/src/demos",
                `${story.replace(/-/g, "_")}.rs`,
            ),
            "utf8",
        );
    } catch {
        return "";
    }
}

// The NSH block is a gallery story written as TSX: the same file the live
// preview runs, importing the installed catalog by relative path.
function nshBlock(story: string) {
    try {
        return readFileSync(
            join(
                repo,
                "crates/nsh-component/src/demos",
                `${story.replace(/-/g, "_")}.tsx`,
            ),
            "utf8",
        );
    } catch {
        return "";
    }
}

// Every block below exists in the GPUI and Slint galleries, and iced grows a
// view one screen at a time: `icedStory` is the story the iced gallery serves,
// and a block without one is left out of the iced list rather than shown empty.
// `story` is the GPUI gallery's story name, `slug` the Slint page folder, `doc`
// the component page whose Rust usage the prompt shows when a block has no GPUI
// file of its own, and `gpuiInstall` the registry name `add gpui` copies.
const definitions = [
    {
        id: "sidebar",
        title: "Sidebar",
        description:
            "A workspace shell: grouped navigation beside the content it controls. Selecting an entry moves the panel with it, so the two halves are one screen rather than a sidebar on its own.",
        story: "Sidebar",
        slug: "sidebar",
        doc: "sidebar",
        // What the screen is built from, so the install command and the usage
        // prompt name the whole composition rather than one control.
        // The screen's table is a DataTable: sorting, fixed rows, and a body that
        // pages. `table` was the primitive it used before it moved over.
        components: ["sidebar", "card", "button", "data-table"],
        // The GPUI block, which the registry copies as a file.
        gpuiInstall: ["sidebar"],
        // The iced view is the gallery's `sidebar-block` story, and its install
        // is the controls the screen is composed from. Omit both and iced has
        // no sidebar on this page yet.
        icedStory: "sidebar-block",
        icedInstall: ["sidebar", "card", "button", "data-table"],
        nshStory: "sidebar-block",
        nshInstall: ["sidebar-block"],
        // The page carries four compositions. A block is one finished screen, so
        // the gallery is asked for the last of them.
        slintExample: "last",
    },
    {
        id: "settings",
        title: "Settings",
        description:
            "A preferences screen: the heading that says what saving will do, then the groups the rows belong to. The rows are the point, but the header and the folders around them are what make it a page.",
        story: "Settings",
        slug: "settings",
        doc: "settings",
        components: ["settings", "card", "button"],
        gpuiInstall: ["settings"],
        // The iced view is the gallery's `settings-block` story: the groups are
        // cards, the rows are settings, and every row's control is a switch.
        icedStory: "settings-block",
        icedInstall: ["settings", "card", "button", "switch"],
        nshStory: "settings-block",
        nshInstall: ["settings-block"],
        // The page tours every composition; the block is the finished screen.
        slintExample: "last",
    },
    {
        id: "dock",
        title: "Dock",
        description:
            "An application shell: a toolbar over a dockable workspace, with a status bar underneath. Drag a tab onto another group to join it, or onto an edge to split the centre.",
        story: "Dock",
        slug: "dock",
        doc: "dock",
        components: ["dock", "button", "toolbar", "status-bar"],
        gpuiInstall: ["dock"],
        // The iced view is the gallery's `dock-block` story: the bar, the
        // workspace and the status bar under it, in one shell.
        icedStory: "dock-block",
        icedInstall: ["dock", "button", "toolbar", "status-bar"],
        // The page tours every composition; the block is the finished screen.
        slintExample: "last",
    },
    {
        id: "editor",
        title: "Editor",
        description:
            "A source view: the file toolbar above a buffer that brings its own header and status line. The toolbar does the work a document window needs, and the editor shows one.",
        story: "Editor",
        slug: "editor",
        doc: "editor",
        components: ["editor", "button", "toolbar"],
        // The page tours every composition; the block is the finished screen.
        slintExample: "last",
    },
    {
        id: "paginated-table",
        title: "Paginated table",
        description:
            "A result set one page at a time: the table that shows the page, the count that says which part of the result is on screen, and the control that replaces the rows.",
        story: "Paginated Table",
        slug: "paginated-table",
        doc: "data-table",
        // The page is a data table plus the control that moves it, so the install
        // command and the usage prompt name both.
        components: ["data-table", "pagination", "button", "toolbar"],
        // The iced view is the gallery's `paginated-table-block` story, built
        // from the table, the control that moves it, and the bar over both.
        icedStory: "paginated-table-block",
        icedInstall: ["data-table", "pagination", "button", "toolbar"],
        nshStory: "paginated-table-block",
        nshInstall: ["paginated-table-block"],
        // The page tours every composition; the block is the finished screen.
        slintExample: "last",
    },
    {
        id: "table",
        title: "Table",
        description:
            "An invoice list: the toolbar that shapes the query, the table it returns, and the footer that says how much of the result is on screen.",
        story: "Table",
        slug: "table",
        doc: "table",
        components: ["table", "button", "toolbar"],
        // The page tours every composition; the block is the finished screen.
        slintExample: "last",
        nshStory: "table-block",
        nshInstall: ["table-block"],
    },
];

// The sizes the island's loaders print, for the galleries these blocks point
// at. Pruned to the keys the page actually asks for.
const sizes = (() => {
    const all = gallerySizes();
    const hasIced = definitions.some(
        (block) => (block as { icedStory?: string }).icedStory,
    );
    return {
        gallery: all.gallery,
        ...(hasIced && all["iced-gallery"]?.total
            ? { "iced-gallery": all["iced-gallery"] }
            : {}),
        ...Object.fromEntries(
            definitions
                .map((block) => [
                    `slint-gallery/pages/${block.slug}`,
                    all[`slint-gallery/pages/${block.slug}`],
                ])
                .filter(([, entry]) => entry),
        ),
    };
})();

const blocks = await Promise.all(
    definitions.map(async (block) => {
        const gpui = gpuiBlock(block.id) || gpuiUsage(block.doc);
        const slint = slintExample(block.slug);
        const story = (block as { icedStory?: string }).icedStory;
        const iced = story ? icedBlock(story) : "";
        const nshStory = (block as { nshStory?: string }).nshStory;
        const nsh = nshStory ? nshBlock(nshStory) : "";
        return {
            ...block,
            // Highlighted for the page, plain for the usage prompt it copies.
            code: {
                gpui: await highlight(gpui),
                slint: await highlight(slint, "slint"),
                iced: await highlight(iced),
                nsh: await highlight(nsh, "tsx"),
            },
            text: { gpui, slint, iced, nsh },
        };
    }),
);
---

<DocsLayout
  canonical={`${SITE_URL}/frameworks/nsh/blocks`}
    title="Blocks — uni-kit"
    description="Composed screens built from the component layer, shown as live examples you can run, copy, and install."
>
    <h1>Blocks</h1>
    <p>
        Composed screens built from the components: run them, read them, install
        them.
    </p>

    <ul class="blocks-keys">
        <li class="blocks-key">
            <span class="blocks-key__label">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M8 3 4 7l4 4" />
                    <path d="M4 7h16" />
                    <path d="m16 21 4-4-4-4" />
                    <path d="M20 17H4" />
                </svg>
                Framework
            </span>
            <span class="blocks-key__note">
                The top-bar selector swaps each example, and the list with it.
            </span>
        </li>
        <li class="blocks-key">
            <span class="blocks-key__label">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 19h8" />
                    <path d="m4 17 6-6-6-6" />
                </svg>
                Install
            </span>
            <span class="blocks-key__note">
                The bar over each block carries that framework's command.
            </span>
        </li>
        <li class="blocks-key">
            <span class="blocks-key__label">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
                </svg>
                Usage prompt
            </span>
            <span class="blocks-key__note">
                Copies the screen's source, with that command, for an assistant.
            </span>
        </li>
    </ul>

    <BlocksGallery
        client:load
        blocks={blocks}
        baseUrl={import.meta.env.BASE_URL}
        sizes={sizes}
    />
</DocsLayout>

<style>
    /* The three controls a reader needs before the first block: what the
       selector does, where the command is, and what the prompt button is for.
       A strip rather than a paragraph, because it is read once and referred back
       to while scrolling. */
    .blocks-keys {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin: 1.75rem 0 0;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        background: var(--border);
        overflow: hidden;
        list-style: none;
    }

    .blocks-key {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 0.7rem 0.85rem;
        background: var(--card);
    }

    .blocks-key__label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--foreground);
        font-size: 0.8125rem;
        font-weight: 560;
        letter-spacing: -0.011em;
    }

    .blocks-key__label svg {
        flex: none;
        color: var(--muted-foreground);
    }

    .blocks-key__note {
        color: var(--muted-foreground);
        font-size: 0.8125rem;
        line-height: 1.45;
    }

    @media (max-width: 780px) {
        .blocks-keys {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
