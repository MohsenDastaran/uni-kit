---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BlocksGallery from '../components/BlocksGallery.vue';
import DocsLayout from '../layouts/DocsLayout.astro';
import { highlight } from '../lib/highlight.js';

const website = process.cwd();
const repo = join(website, '..');

// The first Rust fence long enough to be usage rather than an import: every
// component page opens with a one-line `use`, which is not what a reader wants
// to copy.
function gpuiUsage(doc: string) {
  try {
    const md = readFileSync(join(website, 'component', `${doc}.md`), 'utf8');
    const fences = [...md.matchAll(/```rust\n([\s\S]*?)```/g)].map((match) => match[1]);
    return fences.find((fence) => fence.trim().split('\n').length > 5) ?? fences[0] ?? '';
  } catch {
    return '';
  }
}

// The Slint gallery example is the block: the same file the live page runs.
function slintExample(slug: string) {
  try {
    return readFileSync(
      join(repo, 'crates/slint-component/ui/examples', `${slug}.slint`),
      'utf8',
    );
  } catch {
    return '';
  }
}

// The GPUI block is a file you install, so the prompt carries it verbatim
// rather than a component page's usage. A block with no file yet falls back to
// that usage, which is what the crate alone can offer.
function gpuiBlock(id: string) {
  try {
    return readFileSync(join(repo, 'crates/blocks/src', `${id}.rs`), 'utf8');
  } catch {
    return '';
  }
}

// Every block below exists in both galleries, so the framework selector in the
// top bar swaps the live example rather than emptying the frame. `story` is the
// GPUI gallery's story name, `slug` the Slint page folder, `doc` the component
// page whose Rust usage the prompt shows when a block has no GPUI file of its
// own, and `gpuiInstall` the registry name `add gpui` copies.
const definitions = [
  {
    id: 'sidebar',
    title: 'Sidebar',
    description:
      'A workspace shell: grouped navigation beside the content it controls. Selecting an entry moves the panel with it, so the two halves are one screen rather than a sidebar on its own.',
    story: 'Sidebar',
    slug: 'sidebar',
    doc: 'sidebar',
    // What the screen is built from, so the install command and the usage
    // prompt name the whole composition rather than one control.
    // The screen's table is a DataTable: sorting, fixed rows, and a body that
    // pages. `table` was the primitive it used before it moved over.
    components: ['sidebar', 'card', 'button', 'data-table'],
    // The GPUI block, which the registry copies as a file.
    gpuiInstall: ['sidebar'],
    // The page carries four compositions. A block is one finished screen, so
    // the gallery is asked for the last of them.
    slintExample: 'last',
  },
  {
    id: 'settings',
    title: 'Settings',
    description:
      'A preferences screen: the heading that says what saving will do, then the groups the rows belong to. The rows are the point, but the header and the folders around them are what make it a page.',
    story: 'Settings',
    slug: 'settings',
    doc: 'settings',
    components: ['settings', 'card', 'button'],
    gpuiInstall: ['settings'],
    // The page tours every composition; the block is the finished screen.
    slintExample: 'last',
  },
  {
    id: 'dock',
    title: 'Dock',
    description:
      'An application shell: a toolbar over a dockable workspace, with a status bar underneath. Drag a tab onto another group to join it, or onto an edge to split the centre.',
    story: 'Dock',
    slug: 'dock',
    doc: 'dock',
    components: ['dock', 'button', 'toolbar', 'status-bar'],
    gpuiInstall: ['dock'],
    // The page tours every composition; the block is the finished screen.
    slintExample: 'last',
  },
  {
    id: 'editor',
    title: 'Editor',
    description:
      'A source view: the file toolbar above a buffer that brings its own header and status line. The toolbar does the work a document window needs, and the editor shows one.',
    story: 'Editor',
    slug: 'editor',
    doc: 'editor',
    components: ['editor', 'button', 'toolbar'],
    // The page tours every composition; the block is the finished screen.
    slintExample: 'last',
  },
  {
    id: 'paginated-table',
    title: 'Paginated table',
    description:
      'A result set one page at a time: the table that shows the page, the count that says which part of the result is on screen, and the control that replaces the rows.',
    story: 'Paginated Table',
    slug: 'paginated-table',
    doc: 'data-table',
    // The page is a data table plus the control that moves it, so the install
    // command and the usage prompt name both.
    components: ['data-table', 'pagination', 'button', 'toolbar'],
    // The page tours every composition; the block is the finished screen.
    slintExample: 'last',
  },
  {
    id: 'table',
    title: 'Table',
    description:
      'An invoice list: the toolbar that shapes the query, the table it returns, and the footer that says how much of the result is on screen.',
    story: 'Table',
    slug: 'table',
    doc: 'table',
    components: ['table', 'button', 'toolbar'],
    // The page tours every composition; the block is the finished screen.
    slintExample: 'last',
  },
];

const blocks = await Promise.all(
  definitions.map(async (block) => {
    const gpui = gpuiBlock(block.id) || gpuiUsage(block.doc);
    const slint = slintExample(block.slug);
    return {
      ...block,
      // Highlighted for the page, plain for the usage prompt it copies.
      code: {
        gpui: await highlight(gpui),
        slint: await highlight(slint, 'slint'),
      },
      text: { gpui, slint },
    };
  }),
);
---

<DocsLayout
  title="Blocks — uni-kit"
  description="Composed screens built from the component layer, shown as live examples you can run, copy, and install."
>
  <h1>Blocks</h1>
  <p>
    Clean, working screens built from the components. Each one is a composition
    you can run, read, and copy into an application rather than a single control
    you place yourself — the spacing, the grouping, and the keyboard path are
    already decided.
  </p>
  <p>
    Every block below is the real application, compiled to WebAssembly and
    running in this page. Switch frameworks in the top bar and each one reloads
    as its Slint counterpart. The bar over each block carries the install
    command for the current framework; the buttons beside it size the example,
    and <strong>Usage prompt for this block</strong> copies the screen's source
    together with that command, to hand to an assistant.
  </p>

  <BlocksGallery client:load blocks={blocks} baseUrl={import.meta.env.BASE_URL} />

  <h2>Where a block sits</h2>
  <p>
    A component is one control — a <code>Button</code>, a <code>Table</code>, a
    <code>DockArea</code>. A block is what several of them become once they are
    arranged for a purpose. It carries the decisions a single control cannot
    make: the spacing between groups, the order focus moves through them, and
    the empty, loading, and error states the screen needs before anyone sees it
    working.
  </p>
  <p>
    That arrangement is repeated in every application and is rarely the
    interesting part of one. Starting from a block leaves the product decisions
    — what the screen is for, and where it should depart from the pattern — as
    the work.
  </p>

  <h2>Taking one</h2>
  <p>
    What the command copies depends on the framework, because the two give an
    application different things. Slint has no component crate, so a block is
    assembled from installed controls: the command writes the <code>.slint</code>
    files into <code>ui/components/</code> and adds that directory to the Slint
    include path, and the screen comes from the source the prompt carries. GPUI
    already has every control in the <code>gpui-kit</code> crate, so the command
    writes the block itself — <code>src/components/sidebar.rs</code> and its
    <code>pub mod</code> line — and the screen is in that file.
  </p>
  <p>
    The bar names the whole setup for the framework you are reading, and
    <a href="/component">the component pages</a> carry the full usage for each
    control inside a block.
  </p>
</DocsLayout>
