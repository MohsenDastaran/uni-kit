---
import FolderAnimation from '../components/FolderAnimation.astro';
import DocsLayout from '../layouts/DocsLayout.astro';

// Two projects to fork rather than clone. Each is a complete Slint application,
// so the first commit is the reader's own rather than a deletion; the second
// carries the same base with a sidebar shell around it. `repo` is shown as
// written, `fork` is GitHub's fork route for it.
const templates = [
  {
    id: 'blank',
    title: 'Blank template',
    repo: 'MohsenDastaran/slint-rust-template',
    fork: 'https://github.com/MohsenDastaran/slint-rust-template/fork',
    description:
      'One window, a build script, and the wiring between the .slint markup and Rust. The smallest thing that runs, with nothing to delete first.',
  },
  {
    id: 'sidebar',
    title: 'Sidebar example',
    repo: 'MohsenDastaran/slint-rust-template-sidebar',
    fork: 'https://github.com/MohsenDastaran/slint-rust-template-sidebar/fork',
    description:
      'The same template with a sidebar shell around it: grouped navigation beside the content it controls, and a components directory to grow into.',
  },
];
---

<DocsLayout
  title="Starter — uni-kit"
  description="Two Slint applications to fork: a blank template, and the same template with a sidebar shell."
>
  <h1>Starter</h1>
  <p>
    Two Slint applications to fork. Each is already wired — a window, a build
    script, and the link between the <code>.slint</code> markup and Rust — so the
    first change you make is your own rather than a deletion.
  </p>

  <section class="starter">
    <h2>Start from a template</h2>
    <p>
      Fork one and you have a Slint application already wired: <code>cargo run</code>
      opens a window, so the first change you make is your own rather than a
      deletion.
    </p>

    <div class="starter__grid">
      {
        templates.map((template) => (
          <article class="starter-card">
            <FolderAnimation />
            <p class="starter-card__meta">{template.repo}</p>
            <h3 class="starter-card__title">{template.title}</h3>
            <p class="starter-card__body">{template.description}</p>
            <a class="starter-card__link" href={template.fork}>
              Fork this repo
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>

</DocsLayout>
