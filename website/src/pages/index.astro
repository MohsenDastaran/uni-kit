---
import HomeLayout from '../layouts/HomeLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeApp from '../components/HomeApp.vue';
import HomeFaq from '../components/HomeFaq.astro';
import { fetchStarCount } from '../lib/github';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
---

<HomeLayout
  title="uni-kit"
  description="A comprehensive Rust framework for building fantastic, high-performance desktop apps with GPUI."
>
  <Nav currentPath={Astro.url.pathname} starCount={starCount} />

  <HomeApp client:load starCount={starCount} base={base} />

  <HomeFaq />

  <SiteFooter />
</HomeLayout>
