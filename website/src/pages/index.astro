---
import HomeLayout from '../layouts/HomeLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeApp from '../components/HomeApp.vue';
import HomeFaq from '../components/HomeFaq.astro';
import { fetchStarCount } from '../lib/github';
import { catalogTotals } from '../lib/sidebar';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
// The catalogue's components and samples, counted from the list the sidebar is
// built from rather than written down. Both totals run over every framework the
// pages have a view in, and the hero names none of them.
const totals = catalogTotals();
---

<HomeLayout
  title="uni-kit — universal, framework-agnostic UI components"
  description="A universal, framework-agnostic ecosystem of UI components. With more GUI frameworks on the way."
>
  <Nav currentPath={Astro.url.pathname} starCount={starCount} />

  <HomeApp
    client:load
    componentCount={totals.components}
    exampleCount={totals.examples}
    base={base}
  />

  <HomeFaq />

  <SiteFooter />
</HomeLayout>
