---
import HomeLayout from '../layouts/HomeLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeApp from '../components/HomeApp.vue';
import HomeFaq from '../components/HomeFaq.astro';
import { fetchStarCount } from '../lib/github';
import { catalogTotals } from '../lib/sidebar';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
// The catalogue's own pages, and their samples, counted from the list the
// sidebar is built from rather than written down. Examples are quoted for one
// framework because every window is; the label names it.
const exampleFramework = 'iced';
const totals = catalogTotals(exampleFramework);
---

<HomeLayout
  title="uni-kit"
  description="A comprehensive Rust framework for building fantastic, high-performance desktop apps with GPUI."
>
  <Nav currentPath={Astro.url.pathname} starCount={starCount} />

  <HomeApp
    client:load
    componentCount={totals.components}
    frameworkCount={totals.frameworks}
    exampleCount={totals.examples}
    exampleFramework="Iced"
    base={base}
  />

  <HomeFaq />

  <SiteFooter />
</HomeLayout>
