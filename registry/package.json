{
  "name": "@dastaran/uni-kit",
  "version": "0.5.1",
  "description": "Copy Uni Kit components into a Rust or NSH app. One command for Slint, iced, GPUI & NSH.",
  "type": "module",
  "bin": {
    "uni-kit": "index.js"
  },
  "files": [
    "index.js",
    "components.json",
    "README.md",
    "sources"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohsenDastaran/uni-kit.git",
    "directory": "registry"
  },
  "scripts": {
    "prepack": "node pack-sources.mjs",
    "postpack": "node -e \"require('node:fs').rmSync('sources',{recursive:true,force:true})\""
  }
}
