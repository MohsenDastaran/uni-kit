// Design tokens for the Slint components, mapped from `tokens/tokens.json`.
// Copy this file with any component; every component reads it and nothing
// else. Switch the built-in palettes with `Theme.dark = true;`. The website
// gallery sets `palette` and the `palette-*` colors from the page theme.

export enum ControlSize { xsmall, small, medium, large }

export enum ButtonVariant { default, primary, secondary, danger, warning, success, info, ghost, link, text }

export enum Status { default, info, success, warning, danger }

export global Theme {
    in-out property <bool> dark: false;
    // The gallery writes the frame width here. Layouts read it instead of
    // their own width, which would loop through the layout solver.
    in-out property <length> viewport: 800px;

    // The website gallery fills these from the page's computed theme tokens.
    // `palette` stays false for the built-in light and dark colors below.
    in-out property <bool> palette: false;
    in-out property <color> palette-background: #ffffff;
    in-out property <color> palette-foreground: #0a0a0a;
    in-out property <color> palette-surface: #ffffff;
    in-out property <color> palette-primary: #171717;
    in-out property <color> palette-primary-foreground: #fafafa;
    in-out property <color> palette-secondary: #e5e5e5;
    in-out property <color> palette-secondary-foreground: #171717;
    in-out property <color> palette-muted: #f5f5f5;
    in-out property <color> palette-muted-foreground: #737373;
    in-out property <color> palette-accent: #f5f5f5;
    in-out property <color> palette-accent-foreground: #171717;
    in-out property <color> palette-destructive: #ef4444;
    in-out property <color> palette-border: #e5e5e5;
    in-out property <color> palette-input: #e5e5e5;
    in-out property <color> palette-ring: #a3a3a3;
    in-out property <color> palette-selection: #55a0fc;
    in-out property <color> palette-info: #06b6d4;
    in-out property <color> palette-success: #22c55e;
    in-out property <color> palette-warning: #eab308;
    in-out property <color> palette-chart-1: #e76e50;
    in-out property <color> palette-chart-2: #2a9d90;
    in-out property <color> palette-chart-3: #274754;
    in-out property <color> palette-chart-4: #e8c468;
    in-out property <color> palette-chart-5: #f4a462;
    in-out property <color> palette-popover: #ffffff;
    in-out property <color> palette-sidebar: #fafafa;

    // colors.light / colors.dark
    out property <color> background: palette ? palette-background : (dark ? #0a0a0a : #ffffff);
    out property <color> foreground: palette ? palette-foreground : (dark ? #fafafa : #0a0a0a);
    out property <color> surface: palette ? palette-surface : (dark ? #0a0a0a : #ffffff);
    out property <color> primary: palette ? palette-primary : (dark ? #fafafa : #171717);
    out property <color> primary-foreground: palette ? palette-primary-foreground : (dark ? #171717 : #fafafa);
    out property <color> secondary: palette ? palette-secondary : (dark ? #262626 : #e5e5e5);
    out property <color> secondary-foreground: palette ? palette-secondary-foreground : (dark ? #fafafa : #171717);
    out property <color> muted: palette ? palette-muted : (dark ? #262626 : #f5f5f5);
    out property <color> muted-foreground: palette ? palette-muted-foreground : (dark ? #a3a3a3 : #737373);
    // Link text in rendered Markdown. GPUI draws a link in `primary` and marks
    // it with an underline; `StyledText` cannot underline a link, so this
    // colour has to carry that job on its own. It is the one semantic colour
    // here with no counterpart in `tokens/tokens.json`.
    out property <color> link: dark ? #60a5fa : #2563eb;
    // The surface a text field sits on. GPUI's `input_background()` lifts one off
    // the page in dark mode and leaves it on the page in light mode; without it
    // a field in dark mode is the same value as the page behind it.
    out property <color> input-background: dark ? input.with-alpha(0.3) : background;
    out property <color> accent: palette ? palette-accent : (dark ? #262626 : #f5f5f5);
    out property <color> accent-foreground: palette ? palette-accent-foreground : (dark ? #fafafa : #171717);
    out property <color> destructive: palette ? palette-destructive : (dark ? #f87171 : #ef4444);
    out property <color> destructive-foreground: dark ? #dc2626 : #fafafa;
    out property <color> border: palette ? palette-border : (dark ? #262626 : #e5e5e5);
    out property <color> input: palette ? palette-input : (dark ? #2f2f2f : #e5e5e5);
    out property <color> ring: palette ? palette-ring : (dark ? #737373 : #a3a3a3);
    out property <color> selection: palette ? palette-selection : (dark ? #1d4ed8 : #55a0fc);

    // Status colors from GPUI Component's default theme.
    out property <color> info: palette ? palette-info : (dark ? #22d3ee : #06b6d4);
    out property <color> success: palette ? palette-success : (dark ? #4ade80 : #22c55e);
    out property <color> warning: palette ? palette-warning : (dark ? #facc15 : #eab308);
    out property <color> danger: destructive;

    // Chart series, from GPUI Component's default theme.
    out property <color> chart-1: palette ? palette-chart-1 : (dark ? #2662d9 : #e76e50);
    out property <color> chart-2: palette ? palette-chart-2 : (dark ? #2eb88a : #2a9d90);
    out property <color> chart-3: palette ? palette-chart-3 : (dark ? #e88c30 : #274754);
    out property <color> chart-4: palette ? palette-chart-4 : (dark ? #af57db : #e8c468);
    out property <color> chart-5: palette ? palette-chart-5 : (dark ? #e23670 : #f4a462);

    // The five series colors, in legend order.
    public pure function chart-tone(index: int) -> color {
        if mod(index, 5) == 1 { return chart-2; }
        if mod(index, 5) == 2 { return chart-3; }
        if mod(index, 5) == 3 { return chart-4; }
        if mod(index, 5) == 4 { return chart-5; }
        return chart-1;
    }

    // GPUI `description_list_label`: the dark theme names the color, the light
    // theme leaves it to `background.blend(border.opacity(0.2))`. In `mix` the
    // factor weights the receiver, so the background keeps 0.8.
    out property <color> description-label: dark ? #171717 : background.mix(border, 0.8);
    out property <color> description-label-foreground: dark ? #f5f5f5 : #171717;

    // GPUI `group_box.background` and `group_box.foreground`. The fill is a
    // recess: neutral-100 on white in light, and neutral-800 in dark.
    //
    // GPUI's dark value is neutral-950, which is that theme's page background,
    // so a filled group there is the same colour as the page it sits on and
    // reads as no surface at all. This uses the muted step instead, so the fill
    // is visible in both palettes.
    out property <color> group-box: palette ? palette-muted : (dark ? #262626 : #f5f5f5);
    out property <color> group-box-foreground: palette ? palette-secondary-foreground : (dark ? #fafafa : #171717);
    out property <color> group-box-title-foreground: palette ? palette-muted-foreground : (dark ? #a3a3a3 : #737373);

    out property <color> popover: palette ? palette-popover : (dark ? #171717 : #ffffff);
    out property <color> sidebar: palette ? palette-sidebar : (dark ? #111111 : #fafafa);
    out property <color> overlay: dark ? #000000a0 : #0000004d;
    out property <color> shadow: dark ? #00000080 : #0000001f;

    // spacing
    out property <length> spacing-xxs: 2px;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 24px;
    out property <length> spacing-xxl: 32px;

    // radius
    out property <length> radius-sm: 3px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;

    // typography
    out property <length> font-size-xs: 12px;
    out property <length> font-size-sm: 14px;
    out property <length> font-size-md: 16px;
    out property <length> font-size-lg: 18px;
    out property <length> font-size-xl: 20px;
    out property <length> font-size-mono: 13px;
    out property <string> mono-font-family: "JetBrains Mono";

    // Hover and pressed shades of a filled surface.
    public pure function hovered(fill: color) -> color {
        return dark ? fill.brighter(0.15) : fill.darker(0.06);
    }

    public pure function pressed(fill: color) -> color {
        return dark ? fill.brighter(0.3) : fill.darker(0.12);
    }

    // The tinted background of a status-colored surface.
    public pure function tint(fill: color) -> color {
        return fill.with-alpha(dark ? 0.18 : 0.12);
    }

    public pure function control-height(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 20px;
        }
        if size == ControlSize.small {
            return 24px;
        }
        if size == ControlSize.large {
            return 40px;
        }
        return 32px;
    }

    // GPUI input heights: h_5, h_6, h_8, h_11.
    public pure function input-height(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 20px;
        }
        if size == ControlSize.small {
            return 24px;
        }
        if size == ControlSize.large {
            return 44px;
        }
        return 32px;
    }

    // Medium inputs are text-sm. Large is text-base. Buttons stay on control-font-size.
    public pure function input-font-size(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 12px;
        }
        if size == ControlSize.large {
            return 16px;
        }
        return 14px;
    }

    public pure function input-padding-x(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 4px;
        }
        if size == ControlSize.small {
            return 8px;
        }
        if size == ControlSize.large {
            return 12px;
        }
        return 10px;
    }

    public pure function control-padding(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 6px;
        }
        if size == ControlSize.small {
            return 8px;
        }
        if size == ControlSize.large {
            return 16px;
        }
        return 12px;
    }

    // Button labels: xs is text-xs, small is text-sm, medium and large are text-base.
    public pure function control-font-size(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 12px;
        }
        if size == ControlSize.small {
            return 14px;
        }
        return 16px;
    }

    // Checkbox and radio labels. Large is text-lg; buttons stay at text-base.
    public pure function label-font-size(size: ControlSize) -> length {
        if size == ControlSize.large {
            return 18px;
        }
        return control-font-size(size);
    }

    // Icon boxes: 12 / 14 / 16 / 24, matching GPUI size_3 through size_6.
    public pure function icon-size(size: ControlSize) -> length {
        if size == ControlSize.xsmall {
            return 12px;
        }
        if size == ControlSize.small {
            return 14px;
        }
        if size == ControlSize.large {
            return 24px;
        }
        return 16px;
    }

    // How many tracks a row of controls gets. Phones stack, the docs frame
    // wraps, and a wide window keeps a single row.
    public pure function wrap-columns(width: length) -> int {
        if width < 520px {
            return 1;
        }
        if width < 800px {
            return 2;
        }
        if width < 1100px {
            return 4;
        }
        return 12;
    }

    // Fields are wider than buttons, so a narrow frame gets one column.
    public pure function field-columns(width: length) -> int {
        if width < 720px {
            return 1;
        }
        return 2;
    }

    public pure function wrap-row(index: int, columns: int) -> int {
        if columns < 1 {
            return 0;
        }
        return index / columns;
    }

    public pure function wrap-col(index: int, columns: int) -> int {
        if columns < 1 {
            return 0;
        }
        return mod(index, columns);
    }

    public pure function page-padding(width: length) -> length {
        if width < 640px {
            return 16px;
        }
        return 24px;
    }

    public pure function status-color(status: Status) -> color {
        if status == Status.info {
            return info;
        }
        if status == Status.success {
            return success;
        }
        if status == Status.warning {
            return warning;
        }
        if status == Status.danger {
            return danger;
        }
        return foreground;
    }
}
