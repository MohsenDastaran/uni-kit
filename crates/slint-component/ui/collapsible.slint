import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

// A single expandable panel. Mirrors GPUI Component's `Collapsible`.
export component Collapsible {
    in property <string> title;
    in-out property <bool> open;
    callback toggled(open: bool);

    horizontal-stretch: 1;
    min-width: 0px;

    VerticalLayout {
        // An empty title means the caller draws the trigger and this is only the body.
        if root.title != "": Rectangle {
            background: touch.has-hover ? Theme.accent : transparent;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: title;
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 14px;
                    height: 14px;
                    transform-rotation: open ? 180deg : 0deg;
                    animate transform-rotation { duration: 150ms; }
                    Icon {
                        name: "chevron-down";
                        size: 14px;
                        color: Theme.muted-foreground;
                    }
                }
            }
            touch := TouchArea {
                clicked => {
                    root.open = !root.open;
                    root.toggled(root.open);
                }
            }
        }

        Rectangle {
            clip: true;
            height: open ? content.preferred-height : 0;
            animate height { duration: 150ms; }
            content := VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                @children
            }
        }
    }
}
