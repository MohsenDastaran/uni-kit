import { Theme, ControlSize } from "theme.slint";
import { Label } from "label.slint";

// A form: a vertical stack of fields with a shared gap. Mirrors GPUI
// Component's `Form`. Use `Form` for one column and `FormGrid` for several.
export component Form inherits VerticalLayout {
    spacing: 16px;
    alignment: start;
    @children
}

// A multi-column form. Place each field with `row`, `col` and `colspan`.
export component FormGrid inherits GridLayout {
    spacing: 16px;
    @children
}

// A heading that starts a group of fields inside a `Form`.
export component FormSection inherits VerticalLayout {
    in property <string> title;
    in property <string> description;

    spacing: 4px;

    if title != "": Text {
        text: root.title;
        color: Theme.foreground;
        font-size: Theme.font-size-sm;
        font-weight: 600;
        wrap: word-wrap;
    }

    if description != "": Text {
        text: root.description;
        color: Theme.muted-foreground;
        font-size: Theme.font-size-xs;
        wrap: word-wrap;
    }
}

// A one-pixel rule between form sections.
export component FormSeparator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A labeled field with the label above the control.
export component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <bool> required;
    in property <string> error;
    in property <ControlSize> size: ControlSize.medium;

    spacing: 6px;

    if label != "": Label {
        text: root.label;
        required: root.required;
        size: root.size;
    }

    @children

    if description != "" && error == "": Text {
        text: root.description;
        color: Theme.muted-foreground;
        font-size: Theme.font-size-xs;
        wrap: word-wrap;
    }

    if error != "": Text {
        text: root.error;
        color: Theme.danger;
        font-size: Theme.font-size-xs;
        wrap: word-wrap;
    }
}

// A labeled field with the label in a fixed column beside the control.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> required;
    in property <string> description;
    in property <string> error;
    in property <length> label-width: 140px;
    in property <ControlSize> size: ControlSize.medium;

    width: 100%;
    spacing: 16px;

    VerticalLayout {
        preferred-width: root.label-width;
        min-width: root.label-width;
        horizontal-stretch: 0;
        padding-top: 8px;
        alignment: start;

        Label {
            text: root.label;
            required: root.required;
            size: root.size;
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 6px;
        alignment: start;

        @children

        if description != "" && error == "": Text {
            text: root.description;
            color: Theme.muted-foreground;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
        }

        if error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
        }
    }
}
