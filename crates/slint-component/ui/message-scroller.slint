import { Theme, ButtonVariant, ControlSize } from "theme.slint";
import { Scrollable } from "scrollable.slint";
import { MessageRole } from "message-role.slint";
import { Message } from "message.slint";
import { BubbleVariant } from "bubble.slint";
import { Button } from "button.slint";

export struct ChatTurn {
    role: MessageRole,
    body: string,
}

// A conversation that stays pinned to the newest turn. Mirrors GPUI Component's
// `MessageScroller`.
//
// Rows are bubbles, not `Message`: GPUI's story renders "no avatars or author
// names, sent rows on a muted surface, received rows as ghost text", and a
// `Bubble` is what draws that.
//
// Slint cannot read a scroll position, so the application owns whether the view
// is at the newest turn: it sets `scrolled-up`, and this component shows the
// bottom fade and the jump control from that. GPUI derives the same two values
// from the list state it owns.
export component MessageScroller {
    in-out property <[ChatTurn]> messages;
    // Draws the "Unread" rule before this row. -1 draws none.
    in property <int> unread-index: -1;
    // True while the newest turn is out of view.
    in property <bool> scrolled-up: false;
    in property <bool> jump-button: true;
    // The inset around the list. GPUI's story passes `p_5` here.
    in property <length> list-padding: 20px;
    // Called when the person asks to return to the newest turn.
    callback jump-requested();

    // The component must state its own size, and it needs the stretch factors
    // for the percentages to resolve against. Its child `Scrollable` asks for
    // `100%`, and a component that leaves its size to its content leaves that
    // percentage with nothing to resolve against: the flickable collapses and
    // the conversation renders as an empty frame.
    horizontal-stretch: 1;
    vertical-stretch: 1;
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        background: transparent;

        scroller := Scrollable {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding-left: root.list-padding;
                padding-right: root.list-padding;
                padding-top: root.list-padding;
                // The jump control floats over the list, so the last row needs
                // room to clear it rather than sitting under the button.
                padding-bottom: root.list-padding + (root.jump-button && root.scrolled-up ? 40px : 0px);
                spacing: 12px;

                for turn[index] in root.messages: VerticalLayout {
                    spacing: 12px;

                    // The unread rule sits above the first row the reader has
                    // not seen, the way GPUI's separator marker does.
                    if index == root.unread-index: VerticalLayout {
                        padding-bottom: 4px;
                        spacing: 6px;

                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: Theme.border;
                        }
                        Text {
                            text: "Unread";
                            color: Theme.muted-foreground;
                            font-size: Theme.font-size-xs;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: Theme.border;
                        }
                    }

                    // No avatar, no author line: GPUI's scroller rows are a
                    // bare aligned bubble.
                    Message {
                        role: turn.role;
                        body: turn.body;
                        show-avatar: false;
                        // The scroller's rows are low-emphasis: a muted surface
                        // for sent turns and plain text for received ones.
                        bubble-variant: turn.role == MessageRole.user ? BubbleVariant.muted : BubbleVariant.ghost;
                    }
                }
            }
        }

        // The bottom edge fades into the surface behind the list, so the last
        // partly-scrolled row reads as continuing rather than cut off.
        Rectangle {
            y: parent.height - 48px;
            width: 100%;
            height: 48px;
            background: @linear-gradient(0deg, Theme.background, transparent);
            opacity: root.scrolled-up ? 1 : 0;
            animate opacity { duration: 150ms; }
        }

        // A round icon button, centred 8px above the bottom edge, like GPUI's
        // `jump-to-latest`.
        if root.jump-button && root.scrolled-up: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 8px;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.background;
            clip: true;

            Button {
                width: 100%;
                height: 100%;
                icon: "arrow-down";
                // Ghost: the wrapper above draws the circle's fill and border,
                // so the button must not paint a second surface inside it.
                variant: ButtonVariant.ghost;
                size: ControlSize.small;
                clicked => {
                    // `Scrollable` exposes the flickable's offset, so the jump
                    // is real: put the viewport at the end of the content.
                    scroller.viewport-y = max(0px, scroller.viewport-height - scroller.height);
                    root.jump-requested();
                }
            }
        }
    }
}
