import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct MenuEntry {
    label: string,
    icon: string,
    shortcut: string,
    disabled: bool,
    checked: bool,
    separator: bool,
}

// A list of actions. Mirrors GPUI Component's `Menu`.
export component Menu {
    in property <[MenuEntry]> items;
    callback chosen(index: int);

    preferred-width: 280px;

    Rectangle {
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.popover;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;

        VerticalLayout {
            padding: 4px;
            for item[index] in items: Rectangle {
                height: item.separator ? 9px : 32px;
                border-radius: Theme.radius-sm;
                background: !item.separator && touch.has-hover && !item.disabled ? Theme.accent : transparent;

                if item.separator: Rectangle {
                    y: 4px;
                    height: 1px;
                    background: Theme.border;
                }

                // Every row keeps the same columns: a leading icon slot, the
                // label, the shortcut, and a trailing check slot. A row that
                // leaves a column empty still occupies it, so labels and
                // shortcuts line up down the menu.
                if !item.separator: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    opacity: item.disabled ? 0.45 : 1;

                    Rectangle {
                        width: 16px;

                        if item.icon != "": Icon {
                            x: (parent.width - self.width) / 2;
                            name: item.icon;
                            size: 14px;
                            color: Theme.foreground;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: item.label;
                        color: Theme.foreground;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        width: 48px;
                        text: item.shortcut;
                        color: Theme.muted-foreground;
                        font-size: Theme.font-size-xs;
                        font-family: Theme.mono-font-family;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 16px;

                        if item.checked: Icon {
                            x: (parent.width - self.width) / 2;
                            name: "check";
                            size: 14px;
                            color: Theme.foreground;
                        }
                    }
                }

                touch := TouchArea {
                    enabled: !item.separator && !item.disabled;
                    clicked => {
                        root.chosen(index);
                    }
                }
            }
        }
    }
}
