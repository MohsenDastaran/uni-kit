import { Theme, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

// `outline` draws a frame of its own, which is what a toolbar wants; `default`
// stays flat until it is selected or hovered, like GPUI's two variants.
export enum ToggleVariant { default, outline }

// A pressed-in control. Mirrors GPUI Component's `Toggle`: an optional icon
// and label, sizes, and a selected state. Use `ToggleGroup` for a mutually
// exclusive row.
export component Toggle {
    in-out property <bool> selected;
    in property <string> text;
    in property <string> icon;
    in property <ToggleVariant> variant: ToggleVariant.default;
    in property <bool> enabled: true;
    in property <ControlSize> size: ControlSize.medium;
    // What the pressed state is filled and lettered with. GPUI uses
    // `accent`/`accent_foreground`; a group on its own track overrides them so
    // the pressed item stands off the track rather than matching it.
    in property <color> selected-fill: Theme.accent;
    in property <color> selected-ink: Theme.accent-foreground;
    callback changed(selected: bool);

    function toggle() {
        if !enabled {
            return;
        }
        root.selected = !root.selected;
        root.changed(root.selected);
    }

    accessible-role: button;
    accessible-label: text == "" ? icon : text;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => {
        root.toggle();
    }

    height: Theme.control-height(size);
    // As wide as its own content. Without this a layout that hosts it spans it
    // across the row, which is what turned the size examples into full-width
    // bars. An icon on its own is square, like GPUI's `min_w_8`.
    width: text == "" ? self.height : content.preferred-width;
    opacity: enabled ? 1 : 0.5;
    horizontal-stretch: 0;

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: variant == ToggleVariant.outline || selected ? 1px : 0px;
        border-color: selected ? root.selected-fill : Theme.border;
        background: selected
            ? root.selected-fill
            : variant == ToggleVariant.outline ? Theme.background
            : touch.has-hover ? Theme.accent
            : transparent;
        animate background { duration: 100ms; }
    }

    content := HorizontalLayout {
        padding-left: text == "" ? 0 : Theme.control-padding(size);
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        // The icon is a fixed-size child, so it sits against the top edge
        // unless the row centres it. `vertical-alignment` on the text does not
        // help the icon, which is why the icons floated above their labels.
        cross-axis-alignment: center;

        if icon != "": Icon {
            name: icon;
            size: Theme.icon-size(size);
            color: selected ? root.selected-ink : Theme.foreground;
        }

        if text != "": Text {
            text: root.text;
            color: selected ? root.selected-ink : Theme.foreground;
            font-size: Theme.control-font-size(size);
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md + 2px;
        border-width: 2px;
        border-color: Theme.ring;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggle();
        }
    }
}

export struct ToggleOption {
    text: string,
    icon: string,
}

// A segmented row of toggles that keep one selected index.
export component ToggleGroup {
    in property <[ToggleOption]> options;
    in-out property <int> selected: 0;
    in property <ControlSize> size: ControlSize.medium;
    callback changed(index: int);

    height: Theme.control-height(size);
    horizontal-stretch: 0;

    // The track the selected item sits on, so the pressed fill is the page
    // colour rather than `accent`, which is the same value as the track.
    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.muted;
    }

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for option[index] in options: Toggle {
            text: option.text;
            icon: option.icon;
            selected: root.selected == index;
            size: root.size;
            selected-fill: Theme.background;
            selected-ink: Theme.foreground;
            changed => {
                root.selected = index;
                root.changed(index);
            }
        }
    }
}
