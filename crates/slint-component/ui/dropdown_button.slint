import { Theme, ButtonVariant, ControlSize } from "theme.slint";
import { Button } from "button.slint";
import { Menu, MenuEntry } from "menu.slint";

export enum DropdownButtonAction { main, menu }

// A split button: the main half runs its own action, the trailing half opens a
// menu. Mirrors GPUI Component's `DropdownButton`.
//
// The variant and size belong to the whole control, and the main half redeclares
// them when it has its own. Action options - the label, the icon, a tooltip, the
// loading state - belong to that main half.
export component DropdownButton {
    in property <string> text;
    in property <string> icon;
    in property <string> tooltip;
    in property <ButtonVariant> variant: ButtonVariant.default;
    in property <ControlSize> size: ControlSize.medium;
    in property <bool> outline;
    in property <bool> enabled: true;
    in property <bool> loading;
    in property <bool> selected;
    // Squares the leading or trailing edge so several controls share one
    // outline, as the two halves of this split button do.
    in property <bool> group-start;
    in property <bool> group-end;
    in property <[MenuEntry]> items;
    // The menu's preferred width. Zero keeps the menu at its own width.
    in property <length> menu-width: 0px;
    // A menu item, or the main half, reports itself by index and event.
    callback chosen(index: int, event: DropdownButtonAction);

    horizontal-stretch: 0;
    vertical-stretch: 0;
    // The popup is a child of this root and reports no size, so the control
    // measures the two halves directly.
    width: halves.preferred-width;
    height: halves.preferred-height;

    // The two halves share one outline, so the layout joins them with a
    // negative gap and each half squares the edge that meets the other.
    halves := HorizontalLayout {
        spacing: -1px;
        alignment: center;

        // The tooltip belongs to the main half, like GPUI's inner Button. A
        // horizontal `Tooltip` would stack its children in a column, so the
        // delay and popup live here.
        main := Button {
            text: root.text;
            icon: root.icon;
            variant: root.variant;
            size: root.size;
            outline: root.outline;
            enabled: root.enabled;
            loading: root.loading;
            selected: root.selected;
            group-start: root.group-start;
            group-end: true;
            clicked => { root.chosen(-1, DropdownButtonAction.main); }

            changed has-hover => {
                tip-wait.running = self.has-hover && root.tooltip != "";
                if !self.has-hover { tip.close(); }
            }
        }

        trigger := Button {
            icon: "chevron-down";
            variant: root.variant;
            size: root.size;
            outline: root.outline;
            enabled: root.enabled;
            group-start: true;
            group-end: root.group-end;
            selected: root.selected || menu.is-open;
            clicked => { menu.show(); }
        }
    }

    tip-wait := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if main.has-hover && root.tooltip != "" { tip.show(); }
        }
    }

    tip := PopupWindow {
        close-policy: no-auto-close;
        x: (halves.width - self.width) / 2;
        y: -self.height - 6px;

        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.foreground;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadow;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;

                Text {
                    text: root.tooltip;
                    color: Theme.background;
                    font-size: Theme.font-size-xs;
                    wrap: no-wrap;
                }
            }
        }
    }

    // The trigger grows to the control's height, and the menu hangs from the
    // split button's trailing edge.
    menu := PopupWindow {
        x: parent.width - self.width;
        y: root.height + 4px;
        width: root.menu-width;
        close-policy: close-on-click-outside;

        Menu {
            items: root.items;
            chosen(index) => {
                root.chosen(index, DropdownButtonAction.menu);
                menu.close();
            }
        }
    }
}
