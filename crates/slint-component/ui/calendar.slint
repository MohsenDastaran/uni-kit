import { Theme, ButtonVariant, ControlSize } from "theme.slint";
import { Button } from "button.slint";

component CalendarMonth {
    in property <int> show-year;
    in property <int> show-month;
    in property <bool> show-previous;
    in property <bool> show-next;
    in property <int> marked-day;
    // Inclusive yyyymmdd keys. `from-key` of 0 keeps the single `marked-day`.
    in property <int> from-key;
    in property <int> to-key;
    in property <bool> block-weekends;
    callback previous();
    callback next();
    callback picked(int);

    private property <[string]> weekdays: ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
    private property <[string]> months: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    private property <length> cell: 36px;

    public pure function days-in-month(y: int, m: int) -> int {
        if m == 2 {
            return (mod(y, 4) == 0 && (mod(y, 100) != 0 || mod(y, 400) == 0)) ? 29 : 28;
        }
        if m == 4 || m == 6 || m == 9 || m == 11 {
            return 30;
        }
        return 31;
    }

    public pure function month-offset(m: int) -> int {
        if m == 1 { return 0; }
        if m == 2 { return 3; }
        if m == 3 { return 2; }
        if m == 4 { return 5; }
        if m == 5 { return 0; }
        if m == 6 { return 3; }
        if m == 7 { return 5; }
        if m == 8 { return 1; }
        if m == 9 { return 4; }
        if m == 10 { return 6; }
        if m == 11 { return 2; }
        return 4;
    }

    public pure function first-weekday(y: int, m: int) -> int {
        let yy = m < 3 ? y - 1 : y;
        return mod(yy + floor(yy / 4) - floor(yy / 100) + floor(yy / 400) + month-offset(m) + 1, 7);
    }

    horizontal-stretch: 0;
    width: cell * 7;

    VerticalLayout {
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            width: 100%;
            alignment: center;
            if show-previous: Button {
                icon: "chevron-left";
                variant: ButtonVariant.ghost;
                size: ControlSize.xsmall;
                clicked => { root.previous(); }
            }
            if !show-previous: Rectangle { width: 20px; height: 20px; }
            Text {
                horizontal-stretch: 1;
                text: "\{months[show-month - 1]} \{show-year}";
                color: Theme.foreground;
                font-size: Theme.font-size-sm;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if show-next: Button {
                icon: "chevron-right";
                variant: ButtonVariant.ghost;
                size: ControlSize.xsmall;
                clicked => { root.next(); }
            }
            if !show-next: Rectangle { width: 20px; height: 20px; }
        }

        HorizontalLayout {
            width: 100%;
            alignment: start;
            for day in weekdays: Text {
                width: root.cell;
                text: day;
                color: Theme.muted-foreground;
                font-size: Theme.font-size-xs;
                horizontal-alignment: center;
            }
        }

        for week in 6: HorizontalLayout {
            width: 100%;
            alignment: start;
            for col in 7: Rectangle {
                property <int> day: week * 7 + col - root.first-weekday(show-year, show-month) + 1;
                property <bool> in-month: day >= 1 && day <= root.days-in-month(show-year, show-month);
                property <int> key: show-year * 10000 + show-month * 100 + day;
                property <bool> blocked: in-month && root.block-weekends && (col == 0 || col == 6);
                property <bool> marked: in-month && root.from-key == 0 && day == root.marked-day;
                property <bool> endpoint: in-month && root.from-key > 0 && (key == root.from-key || (root.to-key > 0 && key == root.to-key));
                property <bool> inside: in-month && root.from-key > 0 && root.to-key > 0 && key > min(root.from-key, root.to-key) && key < max(root.from-key, root.to-key);
                width: root.cell;
                height: 32px;
                border-radius: Theme.radius-md;
                background: endpoint || marked ? Theme.primary : inside ? Theme.primary.with-alpha(0.16) : touch.has-hover && in-month && !blocked ? Theme.accent : transparent;

                if in-month: Text {
                    width: 100%;
                    height: 100%;
                    text: "\{day}";
                    color: blocked ? Theme.muted-foreground.with-alpha(0.4) : endpoint || marked ? Theme.primary-foreground : Theme.foreground;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch := TouchArea {
                    enabled: in-month && !blocked;
                    clicked => { root.picked(day); }
                }
            }
        }
    }
}

// A month grid. Mirrors GPUI Component's `Calendar`. `columns` is 1 for a
// single month, or 2–3 for multiple months side by side with spacing between
// them. The grid stays at the width of its day cells.
export component Calendar {
    in-out property <int> year: 2026;
    in-out property <int> month: 9;
    in-out property <int> selected-day: 26;
    in property <int> columns: 1;
    in property <int> range-from;
    in property <int> range-to;
    in property <bool> block-weekends;
    callback changed(year: int, month: int, day: int);

    private property <bool> has-pick;
    private property <int> pick-year;
    private property <int> pick-month;
    private property <int> pick-day;
    private property <length> month-width: 252px;
    private property <length> gap: 24px;
    private property <length> pad: 16px;
    private property <int> count: columns < 1 ? 1 : columns;

    function shift(delta: int) {
        let next = month + delta;
        if next < 1 {
            root.month = 12;
            root.year -= 1;
        } else if next > 12 {
            root.month = 1;
            root.year += 1;
        } else {
            root.month = next;
        }
    }

    horizontal-stretch: 0;
    width: month-width * count + (count > 1 ? gap * (count - 1) : 0px) + pad * 2;

    Rectangle {
        width: 100%;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;

        HorizontalLayout {
            padding: pad;
            spacing: gap;
            alignment: start;

        for offset in root.count: CalendarMonth {
            property <int> absolute: root.year * 12 + root.month - 1 + offset;

            show-year: floor(absolute / 12);
            show-month: mod(absolute, 12) + 1;
            show-previous: offset == 0;
            show-next: offset == root.count - 1;
            from-key: root.range-from;
            to-key: root.range-to;
            block-weekends: root.block-weekends;
            marked-day: (!root.has-pick && offset == 0) || (root.has-pick && floor(absolute / 12) == root.pick-year && mod(absolute, 12) + 1 == root.pick-month)
                ? (root.has-pick ? root.pick-day : root.selected-day)
                : 0;
            previous => { root.shift(-1); }
            next => { root.shift(1); }
            picked(day) => {
                root.has-pick = true;
                root.pick-year = floor(absolute / 12);
                root.pick-month = mod(absolute, 12) + 1;
                root.pick-day = day;
                root.selected-day = day;
                root.changed(floor(absolute / 12), mod(absolute, 12) + 1, day);
            }
        }
        }
    }
}
