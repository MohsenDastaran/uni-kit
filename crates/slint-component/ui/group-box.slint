import { Theme } from "theme.slint";

export enum GroupBoxVariant { normal, fill, outline }

// A container that groups related content under an optional title. Mirrors GPUI
// Component's `GroupBox`.
//
// The title sits outside the surface, so `normal` reads as a heading over a
// plain stack, while `fill` and `outline` add a surface with its own inset and
// gap. A `footer` hangs under the surface as small muted text.
export component GroupBox inherits VerticalLayout {
    in property <string> title;
    in property <GroupBoxVariant> variant: GroupBoxVariant.normal;
    // Supporting text under the surface. The 8px gap belongs to the footer, so
    // it stays tight against its group whatever the root spacing is.
    in property <string> footer;
    // The surface inset. 16px matches the gap between the surface's children.
    in property <length> content-padding: 16px;
    in property <length> corner-radius: Theme.radius-md;
    in property <color> title-color: Theme.group-box-title-foreground;

    horizontal-stretch: 1;
    spacing: variant == GroupBoxVariant.normal ? 16px : 12px;

    if title != "": Text {
        text: title;
        color: title-color;
        font-size: Theme.font-size-sm;
        font-weight: 500;
        wrap: word-wrap;
    }

    // The surface and its footer share one stack, so the footer's gap is
    // independent of the gap between the title and the surface above.
    VerticalLayout {
        spacing: footer == "" ? 0px : 8px;

        Rectangle {
            horizontal-stretch: 1;
            background: variant == GroupBoxVariant.fill ? Theme.group-box : transparent;
            border-width: variant == GroupBoxVariant.outline ? 1px : 0;
            border-color: Theme.border;
            border-radius: corner-radius;

            VerticalLayout {
                padding: variant == GroupBoxVariant.normal ? 0px : content-padding;
                spacing: 16px;
                alignment: start;
                @children
            }
        }

        if footer != "": Text {
            text: footer;
            color: Theme.muted-foreground;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
    }
}
