import { Theme, ButtonVariant, ControlSize } from "theme.slint";
import { Avatar, AvatarSize } from "avatar.slint";
import { MessageRole } from "message-role.slint";

export enum BubbleVariant { filled, secondary, muted, tinted, outline, ghost, destructive }
export enum BubbleAlignment { start, end }
export enum BubbleReactionSide { top, bottom }

// Pill for emoji, labels, or icon buttons. Size to the row; do not stretch in a column.
export component BubbleReactions inherits Rectangle {
    horizontal-stretch: 0;
    vertical-stretch: 0;
    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: self.height / 2;
    border-width: 3px;
    border-color: Theme.background;
    background: Theme.muted;
    clip: false;

    row := HorizontalLayout {
        horizontal-stretch: 0;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;
        alignment: center;
        @children
    }
}

// Aligns a content-sized reaction pill under a bubble edge (GPUI `left-3` / `right-3`).
export component BubbleReactionRow inherits HorizontalLayout {
    in property <BubbleAlignment> align: BubbleAlignment.start;
    horizontal-stretch: 1;
    min-width: 0px;
    alignment: align == BubbleAlignment.end ? end : start;
    padding-left: align == BubbleAlignment.start ? 12px : 0px;
    padding-right: align == BubbleAlignment.end ? 12px : 0px;

    @children
}

// Bubble plus a reaction pill with stable spacing (no negative overlap clipping).
export component BubbleWithReactions inherits VerticalLayout {
    in property <BubbleAlignment> column-align: BubbleAlignment.start;
    horizontal-stretch: 0;
    spacing: 6px;
    alignment: column-align == BubbleAlignment.end ? end : start;

    @children
}

// Consecutive bubbles from one sender.
export component BubbleGroup inherits VerticalLayout {
    in property <BubbleAlignment> align: BubbleAlignment.start;
    horizontal-stretch: 1;
    min-width: 0px;
    spacing: 8px;
    alignment: align == BubbleAlignment.end ? end : start;
    @children
}

// A chat bubble. Mirrors GPUI Component's `Bubble`: variants, alignment,
// optional avatars, timestamps, grouped stacks, and composable content.
export component Bubble {
    in property <MessageRole> role: MessageRole.assistant;
    in property <BubbleAlignment> alignment: role == MessageRole.user ? BubbleAlignment.end : BubbleAlignment.start;
    in property <BubbleVariant> variant: BubbleVariant.filled;
    in property <string> text;
    in property <string> time;
    in property <bool> show-avatar: true;
    // Each surface property defaults to the variant. Setting one replaces that
    // default, the same way a Styled refinement does in GPUI.
    in property <color> fill: variant-fill;
    in property <color> text-color: variant-text;
    in property <color> border-color: variant-border;
    in property <length> border-width: variant == BubbleVariant.outline ? 1px : 0px;
    in property <length> radius: ghost ? 0px : Theme.radius-xl;
    in property <length> padding-x: ghost ? 0px : 12px;
    in property <length> padding-y: ghost ? 0px : 8px;

    private property <bool> ghost: variant == BubbleVariant.ghost;
    private property <length> max-bubble-width: min(480px, Theme.viewport * 0.8);
    private property <color> variant-fill: variant == BubbleVariant.filled ? Theme.primary
        : variant == BubbleVariant.secondary || variant == BubbleVariant.muted ? Theme.muted
        : variant == BubbleVariant.tinted ? Theme.primary.mix(Theme.background, Theme.dark ? 0.76 : 0.88)
        : variant == BubbleVariant.outline ? Theme.background
        : variant == BubbleVariant.destructive ? Theme.destructive.with-alpha(Theme.dark ? 0.2 : 0.1)
        : transparent;
    private property <color> variant-text: variant == BubbleVariant.filled ? Theme.primary-foreground
        : variant == BubbleVariant.secondary ? Theme.secondary-foreground
        : variant == BubbleVariant.destructive ? Theme.destructive
        : Theme.foreground;
    private property <color> variant-border: variant == BubbleVariant.outline ? Theme.border : transparent;

    horizontal-stretch: 1;
    min-width: 0px;

    HorizontalLayout {
        spacing: 8px;
        alignment: alignment == BubbleAlignment.end ? end : start;

        if show-avatar && alignment == BubbleAlignment.start: Avatar {
            initials: "A";
            size: AvatarSize.xsmall;
        }

        VerticalLayout {
            horizontal-stretch: ghost ? 1 : 0;
            min-width: 0px;
            max-width: ghost ? 100000px : max-bubble-width;
            alignment: alignment == BubbleAlignment.end ? end : start;
            spacing: 4px;

            surface := Rectangle {
                horizontal-stretch: ghost ? 1 : 0;
                min-width: 0px;
                border-radius: root.radius;
                border-width: root.border-width;
                border-color: root.border-color;
                background: root.fill;
                clip: true;

                content := VerticalLayout {
                    padding-left: root.padding-x;
                    padding-right: root.padding-x;
                    padding-top: root.padding-y;
                    padding-bottom: root.padding-y;
                    spacing: 8px;
                    alignment: start;
                    min-width: 0px;

                    if text != "": Text {
                        text: root.text;
                        color: root.text-color;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    @children
                }
            }

            if time != "": Text {
                text: time;
                color: Theme.muted-foreground;
                font-size: 10px;
                horizontal-alignment: alignment == BubbleAlignment.end ? right : left;
            }
        }

        if show-avatar && alignment == BubbleAlignment.end: Avatar {
            initials: "U";
            size: AvatarSize.xsmall;
            fill: Theme.primary;
        }
    }
}
