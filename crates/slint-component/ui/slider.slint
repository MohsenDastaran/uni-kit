import { Theme, ControlSize } from "theme.slint";

// A numeric range control. Mirrors GPUI Component's `Slider`: a 0–100 value
// by default, step, disabled, and click-or-drag on the track.
export component Slider {
    in-out property <float> value: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <ControlSize> size: ControlSize.medium;
    callback changed(value: float);

    private property <length> track-h: size == ControlSize.xsmall ? 4px
        : size == ControlSize.large ? 8px
        : 6px;
    private property <length> thumb: size == ControlSize.xsmall ? 12px
        : size == ControlSize.large ? 18px
        : 16px;
    private property <float> span: max(0.0001, maximum - minimum);
    private property <float> fraction: clamp((value - minimum) / span, 0, 1);
    // The distance the thumb's centre travels. Half a thumb is held back at
    // each end so the whole thumb stays on the track at the extremes.
    private property <length> usable: max(0px, root.width - thumb);
    private property <length> centre: thumb / 2 + usable * fraction;

    function apply(at: length) {
        if !enabled || usable <= 0 {
            return;
        }
        // The inverse of `centre`, so the thumb lands under the pointer.
        let f = clamp((at - thumb / 2) / usable, 0, 1);
        let raw = minimum + f * span;
        let stepped = step > 0 ? round(raw / step) * step : raw;
        let next = clamp(stepped, minimum, maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }

    accessible-role: slider;
    accessible-enabled: enabled;
    accessible-value: "\{round(value)}";
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    height: max(thumb, 24px);
    min-width: 80px;
    horizontal-stretch: 1;
    opacity: enabled ? 1 : 0.5;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: track-h;
        border-radius: self.height / 2;
        background: Theme.secondary;

        Rectangle {
            // `x` has to be given: a child that sets `width` but not `x` is
            // centred in its parent, which floated the fill away from the edge
            // while the thumb stayed put.
            x: 0;
            width: centre;
            height: 100%;
            border-radius: parent.border-radius;
            background: Theme.primary;
        }
    }

    Rectangle {
        x: centre - thumb / 2;
        y: (parent.height - self.height) / 2;
        width: thumb;
        height: thumb;
        border-radius: self.width / 2;
        background: Theme.background;
        border-width: 2px;
        border-color: Theme.primary;
    }

    if focus.has-focus: Rectangle {
        x: centre - thumb / 2 - 3px;
        y: (parent.height - thumb) / 2 - 3px;
        width: thumb + 6px;
        height: thumb + 6px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.ring;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.value = min(maximum, value + step);
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.value = max(minimum, value - step);
                root.changed(root.value);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.apply(self.mouse-x);
        }
        moved => {
            if self.pressed {
                root.apply(self.mouse-x);
            }
        }
    }
}
