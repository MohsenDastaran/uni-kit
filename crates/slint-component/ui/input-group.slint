import { Theme, ControlSize } from "theme.slint";

// A framed row of inputs and buttons. Mirrors GPUI Component's `InputGroup`:
// children sit in one bordered track so an `Input` can set `appearance: false`.
export component InputGroup {
    in property <ControlSize> size: ControlSize.medium;
    in property <bool> invalid;

    height: Theme.control-height(size);
    preferred-width: 280px;
    horizontal-stretch: 1;

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: invalid ? Theme.danger : Theme.input;
        background: Theme.background;
        clip: true;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 0;
        // No `alignment: start` here: it would stop the field from stretching,
        // and the input would collapse to nothing between its addons.
        //
        // The trailing adornment is often a bare `Icon`, and a horizontal layout
        // puts a fixed-size child against the top edge. Centring the cross axis
        // is what GPUI's `h_flex().items_center()` does for the same row.
        cross-axis-alignment: center;
        @children
    }
}

export component InputGroupAddon inherits HorizontalLayout {
    padding-left: 8px;
    padding-right: 8px;
    alignment: center;
}
