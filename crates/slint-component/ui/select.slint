import { Theme, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

export struct SelectItem {
    label: string,
    value: string,
}

// A closed list of options. Mirrors GPUI Component's `Select`: a trigger
// styled like an input and a popover list with a check on the selected row.
export component Select {
    in property <[SelectItem]> items;
    in-out property <int> selected: -1;
    in property <string> placeholder: "Select…";
    in property <bool> enabled: true;
    in property <ControlSize> size: ControlSize.medium;
    // The trigger's surface. `appearance` draws the frame at all; the three
    // below are what it is drawn with, so a host can give the control its own
    // look without wrapping it, which Slint's sizing makes awkward.
    in property <bool> appearance: true;
    in property <color> background: Theme.background;
    in property <color> border-color: Theme.input;
    in property <length> radius: Theme.radius-md;
    // Written before the selected label, so the trigger can say what the value
    // is: "Country: Portugal".
    in property <string> title-prefix;
    // The popup's width. Zero matches the trigger.
    in property <length> menu-width: 0px;
    callback changed(index: int);

    private property <string> label: selected >= 0 && selected < items.length
        ? title-prefix + items[selected].label
        : placeholder;

    height: Theme.input-height(size);
    min-width: 0px;
    preferred-width: 100%;
    horizontal-stretch: 1;
    opacity: enabled ? 1 : 0.5;

    Rectangle {
        border-radius: root.radius;
        border-width: root.appearance ? 1px : 0px;
        border-color: root.border-color;
        background: root.appearance ? root.background : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.input-padding-x(size);
        padding-right: Theme.input-padding-x(size);
        spacing: 8px;
        // A fixed-size child (the chevron) sits against the top edge unless the
        // row centres it. This is the cross axis, so the label still stretches.
        cross-axis-alignment: center;

        Text {
            horizontal-stretch: 1;
            text: label;
            color: selected >= 0 ? Theme.foreground : Theme.muted-foreground;
            font-size: Theme.input-font-size(size);
            overflow: elide;
            vertical-alignment: center;
        }

        Icon {
            name: "chevrons-up-down";
            size: Theme.icon-size(size);
            color: Theme.muted-foreground;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            list.show();
        }
    }

    list := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.menu-width > 0px ? root.menu-width : root.width;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.popover;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;

            VerticalLayout {
                padding: 4px;
                for item[index] in root.items: Rectangle {
                    border-radius: Theme.radius-sm;
                    background: touch.has-hover || root.selected == index ? Theme.accent : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            horizontal-stretch: 1;
                            text: item.label;
                            color: Theme.foreground;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        if root.selected == index: Icon {
                            name: "check";
                            size: 14px;
                            color: Theme.foreground;
                        }
                    }

                    touch := TouchArea {
                        clicked => {
                            root.selected = index;
                            root.changed(index);
                            list.close();
                        }
                    }
                }
            }
        }
    }
}
