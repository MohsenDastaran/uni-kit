import { Theme, ButtonVariant, ControlSize } from "theme.slint";
import { Button } from "button.slint";

export enum Placement { top, bottom, left, right }

// A modal panel. Mirrors GPUI Component's `Dialog`: overlay, title,
// description, content, footer actions, and a close button. Render inside a
// clipped preview so the overlay stays in the example frame.
export component Dialog {
    in-out property <bool> open;
    in property <string> title;
    in property <string> description;
    in property <bool> show-close: true;
    // Clicking the dimmed backdrop closes the dialog, like GPUI's
    // `overlay_closable`.
    in property <bool> overlay-closable: true;
    // Styling overrides, mirroring GPUI's `bg`, `text_color`, `rounded` and
    // `p_*`. The defaults keep the built-in popover look.
    in property <color> panel-background: Theme.popover;
    in property <color> title-color: Theme.foreground;
    in property <color> description-color: Theme.muted-foreground;
    in property <color> panel-border-color: Theme.border;
    in property <length> radius: Theme.radius-lg;
    // A negative value keeps the default inset, which narrows in a small frame.
    in property <length> content-padding: -1px;
    callback closed();

    visible: open;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            enabled: root.overlay-closable;
            clicked => {
                root.open = false;
                root.closed();
            }
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - (parent.width < 420px ? 16px : 48px), 440px);
        height: content.preferred-height;
        border-radius: root.radius;
        border-width: 1px;
        border-color: root.panel-border-color;
        background: root.panel-background;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shadow;

        content := VerticalLayout {
            padding: root.content-padding >= 0px ? root.content-padding : (parent.width < 420px ? 16px : 20px);
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    if title != "": Text {
                        text: title;
                        color: root.title-color;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                    }
                    if description != "": Text {
                        text: description;
                        color: root.description-color;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }
                if show-close: Button {
                    icon: "x";
                    variant: ButtonVariant.ghost;
                    size: ControlSize.xsmall;
                    accessible-label: "Close";
                    clicked => {
                        root.open = false;
                        root.closed();
                    }
                }
            }

            @children
        }
    }
}

export component DialogFooter inherits HorizontalLayout {
    in property <bool> centered;
    spacing: 8px;
    alignment: centered ? center : end;
}
