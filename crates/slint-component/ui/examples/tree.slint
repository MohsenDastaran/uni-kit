import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Tree } from "../tree.slint";

export component TreeExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // The model is flat: `depth` indents a row, and `expanded` chooses the
    // chevron. Collapsing a folder is the caller's re-model, not a tree
    // behaviour, which keeps the component free of state.
    GroupBox {
        title: "Basic Tree";
        variant: GroupBoxVariant.outline;

        Tree {
            items: [
                { label: "src", depth: 0, folder: true, expanded: true },
                { label: "lib.rs", depth: 1, folder: false, expanded: false },
                { label: "main.rs", depth: 1, folder: false, expanded: false },
                { label: "ui", depth: 0, folder: true, expanded: false },
            ];
            selected: 1;
        }
    }

    GroupBox {
        title: "File Tree with Icons";
        variant: GroupBoxVariant.outline;

        Tree {
            items: [
                { label: "slint-component", depth: 0, folder: true, expanded: true },
                { label: "ui", depth: 1, folder: true, expanded: true },
                { label: "dock.slint", depth: 2, folder: false, expanded: false },
                { label: "menu.slint", depth: 2, folder: false, expanded: false },
                { label: "theme.slint", depth: 2, folder: false, expanded: false },
                { label: "Cargo.toml", depth: 1, folder: false, expanded: false },
                { label: "README.md", depth: 1, folder: false, expanded: false },
            ];
            selected: 2;
        }
    }
}
