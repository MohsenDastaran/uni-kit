import { Theme, ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";
import { Switch } from "../switch.slint";
import { Checkbox } from "../checkbox.slint";
import { RadioGroup } from "../radio.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { GroupBox as Panel } from "../group-box.slint";

export component GroupBoxExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // The shape a group box holds most often: a label that takes the room and
    // the control that acts on it at the trailing edge.
    GroupBox {
        title: "Account Settings";
        variant: GroupBoxVariant.fill;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: left;
                text: "Make profile private and hide activity";
                color: Theme.foreground;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Switch {
                checked: true;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: left;
                text: "Include private contributions on my profile";
                color: Theme.foreground;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Switch {
                checked: false;
            }
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: "Save Changes";
                variant: ButtonVariant.primary;
            }
        }
    }

    GroupBox {
        title: "Preferences";
        variant: GroupBoxVariant.outline;

        Checkbox {
            label: "All activity";
            description: "Every mention, reply, and review.";
            checked: true;
        }
        Checkbox {
            label: "Product updates";
            description: "Release notes and deprecations.";
            checked: true;
        }
        Checkbox {
            label: "Account activity";
            description: "Sign-ins and billing changes.";
        }
    }

    // The three surfaces side by side. The outer group is a plain section, so
    // each card stands on its own rather than nesting one surface in another.
    GroupBox {
        title: "GroupBox Variants";

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 12px;

            Panel {
                horizontal-stretch: 1;
                Text {
                    text: "No visual container. The title alone groups the content.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
            Panel {
                horizontal-stretch: 1;
                variant: GroupBoxVariant.fill;
                Text {
                    text: "A muted background, for a recessed settings surface.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
            Panel {
                horizontal-stretch: 1;
                variant: GroupBoxVariant.outline;
                Text {
                    text: "A one-pixel border, for a card that must read as a unit.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }
    }

    GroupBox {
        title: "With Title";
        variant: GroupBoxVariant.normal;

        Panel {
            title: "Email notifications";
            variant: GroupBoxVariant.fill;

            Checkbox {
                label: "All activity";
                checked: true;
            }
            Checkbox {
                label: "Account activity";
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Save preferences";
                    variant: ButtonVariant.primary;
                }
            }
        }
    }

    // A footer sits under the surface, 8px away, as small muted text. It shares
    // the title's leading edge.
    GroupBox {
        title: "Footer outside the surface";
        variant: GroupBoxVariant.normal;

        Panel {
            title: "Contributions & activity";
            variant: GroupBoxVariant.fill;
            footer: "Private contributions never reveal repository names.";

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Make profile private and hide activity";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Switch {
                    checked: true;
                }
            }
        }
    }

    GroupBox {
        title: "Custom Title Styling";
        variant: GroupBoxVariant.normal;

        Panel {
            title: "Appearance";
            variant: GroupBoxVariant.outline;
            title-color: Theme.foreground;

            RadioGroup {
                options: ["Light", "Dark", "System"];
                selected: 2;
            }
        }
    }

    // `content-padding` and `corner-radius` are the two knobs a caller reaches
    // for most: a roomier inset, and a softer or sharper corner.
    GroupBox {
        title: "Custom Content Styling";
        variant: GroupBoxVariant.normal;

        Panel {
            title: "Roomy surface";
            variant: GroupBoxVariant.outline;
            content-padding: 24px;
            corner-radius: Theme.radius-xl;

            Text {
                text: "A 24px inset on a 12px radius.";
                color: Theme.foreground;
                font-size: Theme.font-size-sm;
            }
        }
    }

    GroupBox {
        title: "Without Title";
        variant: GroupBoxVariant.normal;

        Panel {
            variant: GroupBoxVariant.outline;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Make profile private and hide activity";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Switch {
                    checked: true;
                }
            }
        }
    }
}
