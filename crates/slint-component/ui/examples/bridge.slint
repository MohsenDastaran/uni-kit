// Gallery-only. The example title and its code icon share one row. Either one
// tells the embedding page which sample to show. Installed components do not
// include this file.

import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";

export global ExampleBridge {
    in-out property <int> next-id: 0;
    callback show(int, string);
}

export component SourceHeading inherits HorizontalLayout {
    in property <string> title;
    // A sentence under the title, the way a GPUI `section()` carries its
    // description. Empty draws nothing.
    in property <string> description;
    // Posted when the visible title is reused by another card. Empty means
    // the visible title is the source title.
    in property <string> source-title: "";
    in property <color> color: Theme.muted-foreground;
    in property <length> font-size: Theme.font-size-sm;
    in property <int> font-weight: 500;

    property <int> index: -1;
    property <string> posted: source-title != "" ? source-title : title;

    spacing: 8px;
    vertical-stretch: 0;

    init => {
        root.index = ExampleBridge.next-id;
        ExampleBridge.next-id += 1;
    }

    function open() {
        if root.posted == "" || root.index < 0 {
            return;
        }
        ExampleBridge.show(root.index, root.posted);
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;

        title-hit := TouchArea {
            clicked => { root.open(); }

            Text {
                text: root.title;
                color: root.color;
                font-size: root.font-size;
                font-weight: root.font-weight;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        if root.description != "": Text {
            text: root.description;
            color: Theme.muted-foreground;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
            horizontal-stretch: 1;
            // The title beside it is centred, so a left-aligned sentence
            // underneath reads as detached from it.
            horizontal-alignment: center;
        }
    }

    VerticalLayout {
        alignment: center;

        icon := Rectangle {
            width: 28px;
            height: 28px;
            vertical-stretch: 0;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.primary.with-alpha(icon-hit.pressed ? 0.7 : icon-hit.has-hover ? 0.55 : 0.35);
            background: Theme.primary.with-alpha(icon-hit.pressed ? 0.34 : icon-hit.has-hover ? 0.22 : 0.12);
            animate background { duration: 120ms; }
            animate border-color { duration: 120ms; }
            accessible-role: button;
            accessible-label: "View source";
            accessible-action-default => { root.open(); }

            icon-hit := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.open(); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "code-xml";
                    size: 16px;
                    color: Theme.primary;
                }
            }
        }
    }
}
