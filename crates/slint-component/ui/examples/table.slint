import { Theme, GalleryView, ButtonVariant, ControlSize } from "../theme.slint";
import { Button } from "../button.slint";
import { Toolbar, ToolbarGroup, ToolbarSeparator, ToolbarSpacer } from "../toolbar.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Table, TableHeader, TableBody, TableFooter, TableRow, TableHead, TableCell, TableCaption } from "../table.slint";

export component TableExample inherits VerticalLayout {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <[{ invoice: string, status: string, method: string, amount: string }]> invoices: [
        { invoice: "INV001", status: "Paid", method: "Credit Card", amount: "$250.00" },
        { invoice: "INV002", status: "Pending", method: "PayPal", amount: "$150.00" },
        { invoice: "INV003", status: "Unpaid", method: "Bank Transfer", amount: "$350.00" },
        { invoice: "INV004", status: "Paid", method: "Credit Card", amount: "$450.00" },
        { invoice: "INV005", status: "Paid", method: "PayPal", amount: "$550.00" },
    ];
    private property <bool> striped;
    private property <bool> bordered: true;
    private property <ControlSize> table-size: ControlSize.medium;

    // Shown on a component page, hidden when the gallery is asked for a
    // single finished screen.
    if GalleryView.example != "last": GroupBox {
        title: "Basic table";
        variant: GroupBoxVariant.outline;
        Table {
            TableHeader {
                TableRow {
                    TableHead {
                        text: "Invoice";
                    }
                    TableHead {
                        text: "Status";
                    }
                    TableHead {
                        text: "Method";
                    }
                    TableHead {
                        text: "Amount";
                        align: TextHorizontalAlignment.right;
                    }
                }
            }
            TableBody {
                for row[
                    i
                ]
                in invoices: TableRow {
                    index: i;
                    TableCell {
                        text: row.invoice;
                    }
                    TableCell {
                        text: row.status;
                    }
                    TableCell {
                        text: row.method;
                    }
                    TableCell {
                        text: row.amount;
                        align: TextHorizontalAlignment.right;
                    }
                }
            }
            TableCaption {
                text: "A list of your recent invoices.";
            }
        }
    }

    // Shown on a component page, hidden when the gallery is asked for a
    // single finished screen.
    if GalleryView.example != "last": GroupBox {
        title: "Striped, bordered and sizes";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 8px;
            Button {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Striped";
                selected: striped;
                clicked => {
                    striped = !striped;
                }
            }
            Button {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Bordered";
                selected: bordered;
                clicked => {
                    bordered = !bordered;
                }
            }
            Rectangle {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                width: 8px;
            }
            Button {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Small";
                selected: table-size == ControlSize.small;
                clicked => {
                    table-size = ControlSize.small;
                }
            }
            Button {
                row: Theme.wrap-row(4, root.wrap-cols);
                col: Theme.wrap-col(4, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Medium";
                selected: table-size == ControlSize.medium;
                clicked => {
                    table-size = ControlSize.medium;
                }
            }
            Button {
                row: Theme.wrap-row(5, root.wrap-cols);
                col: Theme.wrap-col(5, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Large";
                selected: table-size == ControlSize.large;
                clicked => {
                    table-size = ControlSize.large;
                }
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
        Table {
            bordered: bordered;
            TableHeader {
                TableRow {
                    TableHead {
                        text: "Invoice";
                        size: table-size;
                    }
                    TableHead {
                        text: "Status";
                        size: table-size;
                        align: TextHorizontalAlignment.center;
                    }
                    TableHead {
                        text: "Method";
                        size: table-size;
                    }
                    TableHead {
                        text: "Amount";
                        size: table-size;
                        align: TextHorizontalAlignment.right;
                    }
                }
            }
            TableBody {
                for row[
                    i
                ]
                in invoices: TableRow {
                    index: i;
                    striped: striped;
                    TableCell {
                        text: row.invoice;
                        size: table-size;
                    }
                    TableCell {
                        size: table-size;
                        align: TextHorizontalAlignment.center;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                property <color> tone: row.status == "Paid" ? Theme.success : row.status == "Pending" ? Theme.warning : Theme.danger;
                                height: 20px;
                                border-radius: Theme.radius-sm;
                                background: Theme.tint(tone);
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: row.status;
                                        color: tone;
                                        font-size: Theme.font-size-xs;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    TableCell {
                        text: row.method;
                        size: table-size;
                    }
                    TableCell {
                        text: row.amount;
                        size: table-size;
                        align: TextHorizontalAlignment.right;
                    }
                }
            }
            TableFooter {
                TableRow {
                    TableCell {
                        text: "Total";
                        size: table-size;
                        col-span: 3;
                    }
                    TableCell {
                        text: "$1,750.00";
                        size: table-size;
                        align: TextHorizontalAlignment.right;
                    }
                }
            }
        }
    }

    // The finished screen: the toolbar that shapes the query, the table it
    // returns, and the footer that says how much of the result is on screen.
    // The gallery already frames the example, so this is the screen itself:
    // no section title, no source icon beside one, and one border.
    if GalleryView.example == "last": Rectangle {
        vertical-stretch: 1;
        width: 100%; height: 100%; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-lg; clip: true;

            // The frame's layout carries its own box. A `Rectangle` sizes its
            // child to the child's preferred size, so without this the layout
            // shrinks to its content and anything that stretches inside it
            // collapses to nothing.
            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 0;

                Toolbar {
                    ToolbarGroup {
                        Button { text: "Filter"; icon: "funnel"; }
                        Button { text: "Columns"; icon: "list"; }
                        Button { text: "Export"; icon: "download"; }
                    }
                    ToolbarSeparator { width: 1px; }
                    ToolbarGroup {
                        Button { text: "New invoice"; icon: "plus"; variant: ButtonVariant.primary; }
                    }
                    // Keeps the commands at the leading edge. Without it the row
                    // spreads its free space and the buttons stretch to fill.
                    ToolbarSpacer { }
                }

                // Claims the height the toolbar leaves, so the table fills.
                VerticalLayout {
                    vertical-stretch: 1;
                    width: 100%;
                    padding: 16px;
                    spacing: 12px;

                    Table {
                        vertical-stretch: 1;
                        TableHeader {
                            TableRow {
                                TableHead { text: "Invoice"; }
                                TableHead { text: "Customer"; }
                                TableHead { text: "Status"; }
                                TableHead { text: "Method"; }
                                TableHead { text: "Amount"; align: TextHorizontalAlignment.right; }
                            }
                        }
                        TableBody {
                            TableRow {
                                TableCell { text: "INV-0042"; mono: true; }
                                TableCell { text: "Northwind Trading"; }
                                TableCell { text: "Paid"; }
                                TableCell { text: "Card"; }
                                TableCell { text: "$1,250.00"; align: TextHorizontalAlignment.right; mono: true; }
                            }
                            TableRow {
                                TableCell { text: "INV-0041"; mono: true; }
                                TableCell { text: "Contoso Ltd"; }
                                TableCell { text: "Pending"; }
                                TableCell { text: "Bank transfer"; }
                                TableCell { text: "$860.00"; align: TextHorizontalAlignment.right; mono: true; }
                            }
                            TableRow {
                                TableCell { text: "INV-0040"; mono: true; }
                                TableCell { text: "Fabrikam"; }
                                TableCell { text: "Overdue"; }
                                TableCell { text: "Card"; }
                                TableCell { text: "$2,400.00"; align: TextHorizontalAlignment.right; mono: true; }
                            }
                            TableRow {
                                TableCell { text: "INV-0039"; mono: true; }
                                TableCell { text: "Adventure Works"; }
                                TableCell { text: "Paid"; }
                                TableCell { text: "Card"; }
                                TableCell { text: "$415.00"; align: TextHorizontalAlignment.right; mono: true; }
                            }
                            TableRow {
                                TableCell { text: "INV-0038"; mono: true; }
                                TableCell { text: "Litware Inc"; }
                                TableCell { text: "Draft"; }
                                TableCell { text: "—"; }
                                TableCell { text: "$980.00"; align: TextHorizontalAlignment.right; mono: true; }
                            }
                        }
                        TableFooter {
                            TableCaption { text: "5 of 48 invoices"; }
                        }
                    }
                }
            }
        }
}
