import { Theme, ButtonVariant } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Message, MessageRole } from "../message.slint";
import { Button } from "../button.slint";

export component MessageExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // The whole row: a header line, the bubble, and a footer under both.
    GroupBox {
        title: "Anatomy and basic usage";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.assistant;
                author: "Alice";
                time: "10:24 AM";
                initials: "AL";
                body: "Can you review this?";
                footer: "Read";
            }

            Message {
                role: MessageRole.user;
                author: "You";
                time: "10:25 AM";
                initials: "YO";
                body: "Sure — I will send notes shortly.";
                footer: "Delivered";
            }
        }
    }

    // `user` turns sit at the trailing edge and take the primary surface;
    // everything else starts at the leading edge on the secondary one.
    GroupBox {
        title: "Alignment";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.assistant;
                author: "Support";
                time: "10:42 AM";
                initials: "ST";
                body: "Your issue has been assigned to the team.";
            }

            Message {
                role: MessageRole.user;
                author: "You";
                time: "Just now";
                initials: "YO";
                body: "Thank you for the quick update.";
                footer: "Delivered";
            }
        }
    }

    GroupBox {
        title: "Avatar";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.assistant;
                author: "Alice Chen";
                initials: "AC";
                body: "Initials stand in whenever there is no image.";
            }

            Message {
                role: MessageRole.assistant;
                author: "Jordan Park";
                initials: "JP";
                body: "A turn with no avatar slot pulls its text to the edge instead.";
                show-avatar: false;
            }
        }
    }

    GroupBox {
        title: "Header";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.assistant;
                author: "Alice Chen";
                time: "10:24 AM";
                initials: "AC";
                body: "The header carries the sender and the timestamp.";
            }

            Message {
                role: MessageRole.user;
                author: "You";
                time: "10:25 AM";
                initials: "YO";
                body: "And it lines up with the bubble, not with the avatar.";
            }
        }
    }

    // A footer states delivery; a failed turn says so and offers the retry.
    GroupBox {
        title: "Footer";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.user;
                initials: "YO";
                body: "This one was delivered.";
                footer: "Delivered";
            }

            Message {
                role: MessageRole.user;
                initials: "YO";
                body: "The response could not be sent.";
                failed: true;
            }
        }
    }

    // The actions are the caller's: the component only reserves the row.
    GroupBox {
        title: "Rich content and actions";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 20px;

            Message {
                role: MessageRole.assistant;
                author: "Support";
                initials: "ST";
                body: "The install failure is coming from the workspace package.";
                show-actions: true;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: "Copy"; icon: "copy"; variant: ButtonVariant.ghost; }
                Button { text: "Retry"; icon: "refresh-cw"; variant: ButtonVariant.ghost; }
            }
        }
    }
}
