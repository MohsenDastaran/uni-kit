import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Select } from "../select.slint";

export component SelectExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <string> picked: "nothing yet";
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Framework";
        variant: GroupBoxVariant.outline;
        Select {
            placeholder: "Choose a framework";
            items: [
                { label: "GPUI", value: "gpui" },
                { label: "Slint", value: "slint" },
                { label: "egui", value: "egui" }
            ];
            selected: 0;
        }
    }

    // Nothing is selected, so the trigger shows the placeholder.
    GroupBox {
        title: "Placeholder";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;

            Select {
                placeholder: "Choose a framework";
                items: [
                    { label: "GPUI", value: "gpui" },
                    { label: "Slint", value: "slint" },
                ];
                selected: -1;
            }

            Select {
                placeholder: "No region matches this filter";
                items: [
                    { label: "GPUI", value: "gpui" },
                    { label: "Slint", value: "slint" },
                ];
                selected: -1;
                enabled: false;
            }
        }
    }

    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;
        Select {
            size: ControlSize.small;
            placeholder: "Small";
            items: [
                { label: "GPUI", value: "gpui" },
                { label: "Slint", value: "slint" },
            ];
            selected: 0;
        }
        Select {
            placeholder: "Medium";
            items: [
                { label: "GPUI", value: "gpui" },
                { label: "Slint", value: "slint" },
            ];
            selected: 1;
        }
        Select {
            size: ControlSize.large;
            placeholder: "Large";
            items: [
                { label: "GPUI", value: "gpui" },
                { label: "Slint", value: "slint" },
            ];
            selected: 0;
        }
    }

    // `changed` reports the row index, which is what a form's model stores.
    GroupBox {
        title: "Events";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Select {
                placeholder: "Choose a framework";
                items: [
                    { label: "GPUI", value: "gpui" },
                    { label: "Slint", value: "slint" },
                ];
                selected: 0;
                changed(index) => {
                    root.picked = index == 0 ? "GPUI" : "Slint";
                }
            }
            Text {
                text: "Last choice: " + picked;
                color: Theme.muted-foreground;
                font-size: Theme.font-size-xs;
            }
        }
    }

    // The trigger's own surface, a wider popup than the trigger, and a prefix
    // on the value it shows.
    GroupBox {
        title: "Custom Appearance";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;

            Select {
                title-prefix: "Country: ";
                background: Theme.primary.with-alpha(0.08);
                border-color: Theme.primary.with-alpha(0.45);
                radius: Theme.radius-xl;
                menu-width: 360px;
                items: [
                    { label: "Portugal", value: "pt" },
                    { label: "Netherlands", value: "nl" },
                    { label: "New Zealand", value: "nz" }
                ];
                selected: 1;
            }

            Select {
                title-prefix: "Build: ";
                background: Theme.muted;
                border-color: Theme.border;
                radius: Theme.radius-sm;
                items: [
                    { label: "Debug", value: "debug" },
                    { label: "Release", value: "release" }
                ];
                selected: 1;
            }

            // `appearance` off draws no frame at all, for a host that supplies
            // the surface itself.
            Select {
                appearance: false;
                placeholder: "Choose a framework";
                items: [
                    { label: "GPUI", value: "gpui" },
                    { label: "Slint", value: "slint" }
                ];
                selected: 0;
            }
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        Select {
            enabled: false;
            placeholder: "Choose a framework";
            items: [
                { label: "GPUI", value: "gpui" },
                { label: "Slint", value: "slint" },
            ];
            selected: 0;
        }
    }

}
