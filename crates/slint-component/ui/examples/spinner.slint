import { Theme, ControlSize, ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Spinner } from "../spinner.slint";

export component SpinnerExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    in-out property <bool> refreshing;

    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Colors";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 16px;
            Spinner {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
            }
            Spinner {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                color: Theme.muted-foreground;
            }
            Spinner {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                color: Theme.info;
            }
            Spinner {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                color: Theme.success;
            }
            Spinner {
                row: Theme.wrap-row(4, root.wrap-cols);
                col: Theme.wrap-col(4, root.wrap-cols);
                horizontal-stretch: 0;
                color: Theme.warning;
            }
            Spinner {
                row: Theme.wrap-row(5, root.wrap-cols);
                col: Theme.wrap-col(5, root.wrap-cols);
                horizontal-stretch: 0;
                color: Theme.danger;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 16px;
            VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Spinner {
                    size: ControlSize.xsmall;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Spinner {
                    size: ControlSize.small;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Spinner {}
            }
            VerticalLayout {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Spinner {
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(4, root.wrap-cols);
                col: Theme.wrap-col(4, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Spinner {
                    width: 32px;
                    color: Theme.primary;
                }
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "In context";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 8px;
            Button {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                text: root.refreshing ? "Refreshing" : "Refresh";
                icon: "refresh-cw";
                loading: root.refreshing;
                clicked => {
                    root.refreshing = true;
                }
            }
            if root.refreshing: GridLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                spacing: 8px;
                VerticalLayout {
                    row: Theme.wrap-row(0, root.wrap-cols);
                    col: Theme.wrap-col(0, root.wrap-cols);
                    horizontal-stretch: 0;
                    alignment: center;
                    Spinner {
                        size: ControlSize.small;
                        color: Theme.muted-foreground;
                    }
                }
                Text {
                    row: Theme.wrap-row(1, root.wrap-cols);
                    col: Theme.wrap-col(1, root.wrap-cols);
                    horizontal-stretch: 0;
                    text: "Loading data…";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Rectangle {
                    row: 0;
                    col: root.wrap-cols;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 140px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            clip: true;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: "Quarterly report";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                }
                Text {
                    text: "Revenue, active users and retention for the last three months.";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-sm;
                }
            }
            Rectangle {
                background: Theme.background.with-alpha(0.8);
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            size: ControlSize.large;
                            color: Theme.primary;
                        }
                    }
                    Text {
                        text: "Loading…";
                        color: Theme.muted-foreground;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // Any icon can be the spinning glyph, which is how a component keeps its
    // own loading language.
    GroupBox {
        title: "Spinner with Custom Icon";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 16px;
            alignment: center;
            Spinner { icon: "loader-circle"; size: ControlSize.large; color: Theme.primary; }
            Spinner { icon: "refresh-cw"; size: ControlSize.large; color: Theme.success; }
            Spinner { icon: "refresh-cw"; size: ControlSize.large; color: Theme.warning; }
        }
    }

    Timer {
        interval: 2s;
        running: root.refreshing;
        triggered => {
            root.refreshing = false;
        }
    }
}
