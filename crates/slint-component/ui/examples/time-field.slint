import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { TimeField, TimePrecision, HourCycle } from "../time-field.slint";

export component TimeFieldExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic Time Field";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            alignment: start;
            TimeField { hour: 9; minute: 30; }
            TimeField { hour: 0; minute: 0; }
            TimeField { hour: 23; minute: 59; }
        }
    }

    GroupBox {
        title: "With Seconds";
        variant: GroupBoxVariant.outline;

        TimeField {
            hour: 14;
            minute: 5;
            second: 42;
            precision: TimePrecision.hours_minutes_seconds;
        }
    }

    GroupBox {
        title: "12-Hour Clock";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            alignment: start;
            TimeField { hour: 9; minute: 30; hour-cycle: HourCycle.h12; }
            TimeField { hour: 14; minute: 5; hour-cycle: HourCycle.h12; }
            TimeField { hour: 0; minute: 0; hour-cycle: HourCycle.h12; }
        }
    }

    GroupBox {
        title: "Sizes, Disabled and Invalid";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            alignment: start;
            TimeField { hour: 8; minute: 15; size: ControlSize.small; }
            TimeField { hour: 8; minute: 15; }
            TimeField { hour: 8; minute: 15; size: ControlSize.large; }
            TimeField { hour: 8; minute: 15; enabled: false; }
            TimeField { hour: 99; minute: 99; invalid: true; }
        }
    }
}
