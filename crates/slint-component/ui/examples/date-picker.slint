import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { DatePicker } from "../date-picker.slint";

export component DatePickerExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Date";
        variant: GroupBoxVariant.outline;
        DatePicker {
            year: 2026;
            month: 10;
            day: 2;
        }
    }

    GroupBox {
        title: "Date and Time";
        variant: GroupBoxVariant.outline;
        VerticalLayout {
            spacing: 8px;
            when := DatePicker {
                with-time: true;
                year: 2026;
                month: 10;
                day: 2;
                hour: 9;
                minute: 30;
            }
            Text {
                text: "Value: \{when.year}-\{when.month < 10 ? "0" : ""}\{when.month}-\{when.day < 10 ? "0" : ""}\{when.day} \{when.hour < 10 ? "0" : ""}\{when.hour}:\{when.minute < 10 ? "0" : ""}\{when.minute}";
                color: Theme.muted-foreground;
                font-size: Theme.font-size-sm;
            }
        }
    }

    GroupBox {
        title: "Date Range Picker";
        variant: GroupBoxVariant.outline;
        DatePicker {
            range: true;
            months: 2;
            empty: true;
            placeholder: "Select a range";
            year: 2026;
            month: 10;
            day: 2;
        }
    }

    GroupBox {
        title: "Disabled Weekends";
        variant: GroupBoxVariant.outline;
        DatePicker {
            block-weekends: true;
            year: 2026;
            month: 10;
            day: 2;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        DatePicker {
            size: ControlSize.small;
            year: 2026;
            month: 10;
            day: 2;
        }
        DatePicker {
            year: 2026;
            month: 10;
            day: 2;
        }
        DatePicker {
            size: ControlSize.large;
            year: 2026;
            month: 10;
            day: 2;
        }
    }
}
