import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { NumberInput } from "../number-input.slint";

export component NumberInputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Quantity";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 3;
            minimum: 0;
            maximum: 99;
            step: 1;
        }
        NumberInput {
            value: 19.99;
            prefix: "$";
            step: 0.5;
        }
    }

    // The narrow shape. A counter gives the steppers the work and leaves the
    // field only wide enough for the number, which is what an inline quantity
    // control needs.
    GroupBox {
        title: "Integer Counter";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Quantity";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                NumberInput {
                    width: 96px;
                    value: 3;
                    minimum: 0;
                    maximum: 99;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Seats, in twos";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                NumberInput {
                    width: 96px;
                    value: 12;
                    minimum: 0;
                    maximum: 20;
                    step: 2;
                }
            }

            // At the bound, the stepper that would cross it is disabled.
            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "At the minimum";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                NumberInput {
                    width: 96px;
                    value: 0;
                    minimum: 0;
                    maximum: 99;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Disabled";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                NumberInput {
                    width: 96px;
                    value: 8;
                    enabled: false;
                }
            }
        }
    }

    // The stepper shape: the value is centred and the buttons sit at the two
    // ends, so the control reads `− 3 +` rather than `3 − +`.
    GroupBox {
        title: "Without Default Styling";
        description: "The value is centred, with a stepper at each end.";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;

            NumberInput {
                centered: true;
                value: 3;
                minimum: 0;
                maximum: 99;
            }

            NumberInput {
                centered: true;
                value: 42;
                minimum: 0;
                maximum: 99;
                prefix: "$";
            }

            NumberInput {
                centered: true;
                value: 8;
                size: ControlSize.large;
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: "Seats, in twos";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                NumberInput {
                    centered: true;
                    width: 140px;
                    value: 6;
                    minimum: 0;
                    maximum: 20;
                    step: 2;
                }
            }
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 4;
            size: ControlSize.small;
        }
        NumberInput {
            value: 4;
        }
        NumberInput {
            value: 4;
            size: ControlSize.large;
        }
    }

    // `minimum` and `maximum` clamp the value and disable the stepper that
    // would cross them.
    GroupBox {
        title: "With Min/Max/Step";
        variant: GroupBoxVariant.outline;

        NumberInput {
            value: 1;
            minimum: 1;
            maximum: 12;
            step: 1;
        }
        NumberInput {
            value: 100;
            minimum: 0;
            maximum: 100;
            step: 5;
            suffix: "%";
        }
    }

    // `prefix` and `suffix` sit inside the frame, on either side of the value.
    GroupBox {
        title: "With Number Formatting";
        variant: GroupBoxVariant.outline;

        NumberInput {
            value: 1250;
            step: 50;
            prefix: "$";
            suffix: "/mo";
        }
        NumberInput {
            value: 7.5;
            step: 0.5;
            suffix: "kg";
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 8;
            enabled: false;
        }
    }

}
