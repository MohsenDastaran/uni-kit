import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { NumberInput } from "../number-input.slint";

export component NumberInputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Quantity";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 3;
            minimum: 0;
            maximum: 99;
            step: 1;
        }
        NumberInput {
            value: 19.99;
            prefix: "$";
            step: 0.5;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 4;
            size: ControlSize.small;
        }
        NumberInput {
            value: 4;
        }
        NumberInput {
            value: 4;
            size: ControlSize.large;
        }
    }

    // `minimum` and `maximum` clamp the value and disable the stepper that
    // would cross them.
    GroupBox {
        title: "With Min/Max/Step";
        variant: GroupBoxVariant.outline;

        NumberInput {
            value: 1;
            minimum: 1;
            maximum: 12;
            step: 1;
        }
        NumberInput {
            value: 100;
            minimum: 0;
            maximum: 100;
            step: 5;
            suffix: "%";
        }
    }

    // `prefix` and `suffix` sit inside the frame, on either side of the value.
    GroupBox {
        title: "With Number Formatting";
        variant: GroupBoxVariant.outline;

        NumberInput {
            value: 1250;
            step: 50;
            prefix: "$";
            suffix: "/mo";
        }
        NumberInput {
            value: 7.5;
            step: 0.5;
            suffix: "kg";
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 8;
            enabled: false;
        }
    }

}
