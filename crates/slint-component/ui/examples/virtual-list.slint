import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { VirtualList, VirtualRow } from "../virtual-list.slint";
import { Button } from "../button.slint";

export component VirtualListExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // Rows are a flat model and scroll inside the list. Every row is
    // instantiated, so this suits hundreds of rows rather than tens of
    // thousands.
    GroupBox {
        title: "Basic Vertical Virtual List";
        variant: GroupBoxVariant.outline;

        VirtualList {
            height: 240px;
            items: [
                { label: "Row 1" },
                { label: "Row 2" },
                { label: "Row 3" },
                { label: "Row 4" },
                { label: "Row 5" },
                { label: "Row 6" },
                { label: "Row 7" },
                { label: "Row 8" },
                { label: "Row 9" },
                { label: "Row 10" },
                { label: "Row 11" },
                { label: "Row 12" },
                { label: "Row 13" },
                { label: "Row 14" },
                { label: "Row 15" },
                { label: "Row 16" },
                { label: "Row 17" },
                { label: "Row 18" },
                { label: "Row 19" },
                { label: "Row 20" },
                { label: "Row 21" },
                { label: "Row 22" },
                { label: "Row 23" },
                { label: "Row 24" },
                { label: "Row 25" },
                { label: "Row 26" },
                { label: "Row 27" },
                { label: "Row 28" },
                { label: "Row 29" },
                { label: "Row 30" },
                { label: "Row 31" },
                { label: "Row 32" },
                { label: "Row 33" },
                { label: "Row 34" },
                { label: "Row 35" },
                { label: "Row 36" },
                { label: "Row 37" },
                { label: "Row 38" },
                { label: "Row 39" },
                { label: "Row 40" },
            ];
            selected: 2;
        }
    }

    // The scroll offset is a property, so a host drives the list -- to the top,
    // to a row, to the middle -- and reads back which rows are on screen. This
    // is the control strip the GPUI window puts over the same list.
    in-out property <[VirtualRow]> scroll-items: [
                { label: "Row 1" },
                { label: "Row 2" },
                { label: "Row 3" },
                { label: "Row 4" },
                { label: "Row 5" },
                { label: "Row 6" },
                { label: "Row 7" },
                { label: "Row 8" },
                { label: "Row 9" },
                { label: "Row 10" },
                { label: "Row 11" },
                { label: "Row 12" },
                { label: "Row 13" },
                { label: "Row 14" },
                { label: "Row 15" },
                { label: "Row 16" },
                { label: "Row 17" },
                { label: "Row 18" },
                { label: "Row 19" },
                { label: "Row 20" },
                { label: "Row 21" },
                { label: "Row 22" },
                { label: "Row 23" },
                { label: "Row 24" },
                { label: "Row 25" },
                { label: "Row 26" },
                { label: "Row 27" },
                { label: "Row 28" },
                { label: "Row 29" },
                { label: "Row 30" },
                { label: "Row 31" },
                { label: "Row 32" },
                { label: "Row 33" },
                { label: "Row 34" },
                { label: "Row 35" },
                { label: "Row 36" },
                { label: "Row 37" },
                { label: "Row 38" },
                { label: "Row 39" },
                { label: "Row 40" },
                { label: "Row 41" },
                { label: "Row 42" },
                { label: "Row 43" },
                { label: "Row 44" },
                { label: "Row 45" },
                { label: "Row 46" },
                { label: "Row 47" },
                { label: "Row 48" },
                { label: "Row 49" },
                { label: "Row 50" },
                { label: "Row 51" },
                { label: "Row 52" },
                { label: "Row 53" },
                { label: "Row 54" },
                { label: "Row 55" },
                { label: "Row 56" },
                { label: "Row 57" },
                { label: "Row 58" },
                { label: "Row 59" },
                { label: "Row 60" },
    ];

    GroupBox {
        title: "Basic Scroll Control";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Top";
                    icon: "arrow-up";
                    clicked => { scroll.scroll-to(0px); }
                }
                Button {
                    text: "Row 50";
                    clicked => { scroll.scroll-to-row(49, false); }
                }
                Button {
                    text: "Center 25";
                    clicked => { scroll.scroll-to-row(24, true); }
                }
                Button {
                    text: "Bottom";
                    icon: "arrow-down";
                    clicked => { scroll.scroll-to-row(59, false); }
                }
            }

            Text {
                text: "Visible: \{scroll.first-visible}..\{scroll.last-visible} of \{scroll.items.length}";
                color: Theme.muted-foreground;
                font-size: Theme.font-size-xs;
            }

            scroll := VirtualList {
                height: 260px;
                items <=> root.scroll-items;
                selected: 4;
            }
        }
    }

    // A taller row and alternating fill make a table-like reading surface.
    GroupBox {
        title: "Variable Item Sizes";
        variant: GroupBoxVariant.outline;

        VirtualList {
            height: 200px;
            row-height: 44px;
            items: [
                { label: "Milestone: first commit" },
                { label: "Milestone: gallery online" },
                { label: "Milestone: dock ships" },
                { label: "Milestone: menu alignment" },
                { label: "Milestone: editor chrome" },
                { label: "Milestone: 76 pages" },
            ];
            selected: 0;
        }
    }
}
