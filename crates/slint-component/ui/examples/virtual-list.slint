import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { VirtualList, VirtualRow } from "../virtual-list.slint";

export component VirtualListExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // Rows are a flat model and scroll inside the list. Every row is
    // instantiated, so this suits hundreds of rows rather than tens of
    // thousands.
    GroupBox {
        title: "Basic Vertical Virtual List";
        variant: GroupBoxVariant.outline;

        VirtualList {
            height: 240px;
            items: [
                { label: "Row 1" },
                { label: "Row 2" },
                { label: "Row 3" },
                { label: "Row 4" },
                { label: "Row 5" },
                { label: "Row 6" },
                { label: "Row 7" },
                { label: "Row 8" },
                { label: "Row 9" },
                { label: "Row 10" },
                { label: "Row 11" },
                { label: "Row 12" },
                { label: "Row 13" },
                { label: "Row 14" },
                { label: "Row 15" },
                { label: "Row 16" },
                { label: "Row 17" },
                { label: "Row 18" },
                { label: "Row 19" },
                { label: "Row 20" },
                { label: "Row 21" },
                { label: "Row 22" },
                { label: "Row 23" },
                { label: "Row 24" },
                { label: "Row 25" },
                { label: "Row 26" },
                { label: "Row 27" },
                { label: "Row 28" },
                { label: "Row 29" },
                { label: "Row 30" },
                { label: "Row 31" },
                { label: "Row 32" },
                { label: "Row 33" },
                { label: "Row 34" },
                { label: "Row 35" },
                { label: "Row 36" },
                { label: "Row 37" },
                { label: "Row 38" },
                { label: "Row 39" },
                { label: "Row 40" },
            ];
            selected: 2;
        }
    }

    // A taller row and alternating fill make a table-like reading surface.
    GroupBox {
        title: "Variable Item Sizes";
        variant: GroupBoxVariant.outline;

        VirtualList {
            height: 200px;
            row-height: 44px;
            items: [
                { label: "Milestone: first commit" },
                { label: "Milestone: gallery online" },
                { label: "Milestone: dock ships" },
                { label: "Milestone: menu alignment" },
                { label: "Milestone: editor chrome" },
                { label: "Milestone: 76 pages" },
            ];
            selected: 0;
        }
    }
}
