import { Theme, Status, ControlSize } from "../theme.slint";
import { GroupBox } from "section.slint";
import { Alert } from "../alert.slint";
import { Switch } from "../switch.slint";
import { TextView, TextHeading, TextParagraph } from "../text-view.slint";

export component AlertExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    property <bool> banner-open: true;
    property <bool> should-show-alert: true;
    property <bool> update-dismissed;

    GroupBox {
        title: "Default";
        Alert {
            title: "Workspace settings saved";
            message: "Your workspace is ready for the team.\n• 12 members have access\n• Billing remains with the workspace owner";
        }
    }

    GroupBox {
        title: "Variants";
        Alert {
            title: "Scheduled maintenance";
            message: "Maintenance starts Friday at 22:00 UTC.";
            status: Status.info;
            closable: true;
        }
        Alert {
            title: "Transfer submitted";
            message: "The transfer is queued and usually settles within one business day.";
            status: Status.success;
        }
        Alert {
            message: "Two teammates still use recovery codes generated more than a year ago. Ask them to generate a fresh set in Security settings.";
            status: Status.warning;
        }
        Alert {
            title: "Unable to process your payment.";
            message: "Please verify your billing information and try again.\n• Check your card details\n• Ensure sufficient funds\n• Verify billing address";
            status: Status.danger;
        }
    }

    GroupBox {
        title: "Banner";
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Alert {
                message: "Reporting is read-only while the nightly ledger closes.";
                banner: true;
                closable: true;
                open <=> root.banner-open;
            }
            Alert {
                message: "A new desktop update will install after you restart.";
                status: Status.info;
                banner: true;
            }
            Alert {
                message: "All 1,284 records finished importing.";
                status: Status.success;
                banner: true;
            }
            Alert {
                message: "Your API key expires in 6 days. Rotate it before August 19.";
                status: Status.warning;
                banner: true;
            }
            Alert {
                message: "Live updates are disconnected. Changes may be delayed.";
                status: Status.danger;
                banner: true;
            }
        }
    }

    GroupBox {
        title: "Custom icon";
        Alert {
            title: "Two events overlap by 30 minutes";
            message: "The quarterly planning review overlaps with the APAC operations call. Move one event or invite another owner before sending the agenda.";
            icon: "calendar";
        }
    }

    GroupBox {
        title: "Alert Sizes";
        Alert {
            title: "XSmall Alert";
            message: "Message content";
            status: Status.info;
            size: ControlSize.xsmall;
        }
        Alert {
            title: "Small Alert";
            message: "Message content";
            status: Status.info;
            size: ControlSize.small;
        }
        Alert {
            title: "Medium Alert";
            message: "Message content";
            status: Status.info;
        }
        Alert {
            title: "Large Alert";
            message: "Message content";
            status: Status.info;
            size: ControlSize.large;
        }
    }

    GroupBox {
        title: "Closable Alerts";
        Alert {
            title: "Dismissible";
            message: "This alert can be dismissed.";
            status: Status.info;
            closable: true;
        }
    }

    GroupBox {
        title: "With Markdown Content";
        Alert {
            title: "Payment Failed";
            status: Status.danger;
            TextView {
                TextParagraph {
                    text: @markdown("Please verify your billing information and try again.");
                    default-color: Theme.danger;
                }
                TextParagraph {
                    text: @markdown("• Check your card details");
                    default-color: Theme.danger;
                }
                TextParagraph {
                    text: @markdown("• Ensure sufficient funds");
                    default-color: Theme.danger;
                }
                TextParagraph {
                    text: @markdown("• Verify billing address");
                    default-color: Theme.danger;
                }
            }
        }
    }

    GroupBox {
        title: "Conditional Visibility";
        Switch {
            label: "Show alert";
            checked <=> root.should-show-alert;
        }
        Alert {
            title: "Conditional";
            message: "This alert may be hidden.";
            status: Status.info;
            open: root.should-show-alert;
        }
    }

    GroupBox {
        title: "Interactive Alert with Custom Action";
        Alert {
            title: "Update Available";
            message: "A new version of the application is available.";
            status: Status.info;
            icon: "download";
            closable: true;
            closed => {
                root.update-dismissed = true;
            }
        }
        if root.update-dismissed: Text {
            text: "Update dismissed";
            color: Theme.muted-foreground;
            font-size: Theme.font-size-sm;
        }
    }

    GroupBox {
        title: "Multi-line Content with Formatting";
        Alert {
            title: "Security Alert";
            status: Status.warning;
            icon: "shield";
            TextView {
                TextHeading {
                    level: 4;
                    text: "Security Notice";
                    color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("Unusual activity detected on your account.");
                    default-color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("Recent activity:");
                    default-color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("• Login from new device (Chrome on Windows)");
                    default-color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("• Location: San Francisco, CA");
                    default-color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("• Time: Today at 2:30 PM");
                    default-color: Theme.warning;
                }
                TextParagraph {
                    text: @markdown("If this wasn't you, please change your password immediately.");
                    default-color: Theme.warning;
                }
            }
        }
    }
}
