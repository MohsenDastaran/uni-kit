import { Theme, ControlSize, ButtonVariant } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Popover } from "../popover.slint";
import { Placement } from "../tooltip.slint";
import { Button } from "../button.slint";
import { Icon } from "../icon.slint";

export component PopoverExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <bool> controlled;

    // The plain case: a button, and text in the panel.
    GroupBox {
        title: "Basic Popover";
        variant: GroupBoxVariant.outline;

        Popover {
            trigger-text: "Click me";
            panel-width: 260px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Hello, this is a popover!";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                }
                Text {
                    text: "It appears when you click the button.";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }
        }
    }

    GroupBox {
        title: "Click";
        variant: GroupBoxVariant.outline;

        Popover {
            trigger-text: "Open popover";
            trigger-icon: "chevron-down";
            panel-width: 280px;

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Click outside to dismiss.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                }
                Text {
                    text: "The panel is a popup, so it is not clipped by this card.";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }
        }
    }

    GroupBox {
        title: "Popover with Custom Positioning";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 24px;
            alignment: center;

            Popover {
                placement: Placement.bottom;
                trigger-text: "Below";
                panel-width: 220px;
                Text {
                    text: "Placement.bottom";
                    color: Theme.foreground;
                    font-size: Theme.font-size-xs;
                }
            }
            Popover {
                placement: Placement.right;
                trigger-text: "Right";
                panel-width: 220px;
                Text {
                    text: "Placement.right";
                    color: Theme.foreground;
                    font-size: Theme.font-size-xs;
                }
            }
            Popover {
                placement: Placement.top;
                trigger-text: "Above";
                panel-width: 220px;
                Text {
                    text: "Placement.top";
                    color: Theme.foreground;
                    font-size: Theme.font-size-xs;
                }
            }
        }
    }

    // Any children work: this one is a small activity view.
    GroupBox {
        title: "View in Popover";
        variant: GroupBoxVariant.outline;

        Popover {
            trigger-text: "Open activity";
            panel-width: 280px;

            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Recent activity";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-xs;
                }
                for row in [{ title: "Build finished", detail: "2 minutes ago" }, { title: "New comment", detail: "9 minutes ago" }, { title: "Deploy failed", detail: "1 hour ago" }]: HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Icon {
                        name: row.title == "Deploy failed" ? "circle-x" : "circle-check";
                        size: 14px;
                        color: row.title == "Deploy failed" ? Theme.danger : Theme.success;
                    }
                    VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: row.title;
                            color: Theme.foreground;
                            font-size: Theme.font-size-sm;
                        }
                        Text {
                            text: row.detail;
                            color: Theme.muted-foreground;
                            font-size: Theme.font-size-xs;
                        }
                    }
                }
            }
        }
    }

    // The panel can hold interactive children, not just text.
    GroupBox {
        title: "Add content by `content` method";
        variant: GroupBoxVariant.outline;

        Popover {
            trigger-text: "Complex content";
            panel-width: 280px;

            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "This popover has complex content.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Perform action"; outline: true; }
                    Button { text: "Cancel"; variant: ButtonVariant.ghost; }
                }
            }
        }
    }

    // Closing from inside needs a handle on the popover, which the host has.
    GroupBox {
        title: "Dismiss Popover manually";
        variant: GroupBoxVariant.outline;

        dismiss := Popover {
            trigger-text: "Dismiss popover";
            panel-width: 300px;

            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Click the button below to dismiss this popover.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
                Button {
                    text: "Close popover";
                    outline: true;
                    clicked => {
                        dismiss.open = false;
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Styling Popover";
        variant: GroupBoxVariant.outline;

        Popover {
            trigger-text: "Custom style";
            panel-width: 300px;
            panel-background: Theme.primary;
            panel-radius: Theme.radius-xl;
            panel-border: false;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Fully custom styled popover";
                    color: Theme.primary-foreground;
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                }
                Text {
                    text: "A custom surface, radius, and no border.";
                    color: Theme.primary-foreground;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }
        }
    }

    // The host owns the state, so an outside control can drive it too.
    GroupBox {
        title: "Control Open State";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Button {
                text: root.controlled ? "Close" : "Open";
                outline: true;
                clicked => {
                    root.controlled = !root.controlled;
                }
            }

            controlled := Popover {
                trigger-text: "Controlled popover";
                open <=> root.controlled;
                panel-width: 280px;

                Text {
                    text: "This popover's open state is controlled programmatically.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }
        }
    }

}
