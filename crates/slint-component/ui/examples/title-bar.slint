import { Theme } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { TitleBar } from "../title-bar.slint";

export component TitleBarExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic Title Bar";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 140px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-lg; clip: true;
            VerticalLayout {
                TitleBar { title: "Notes"; }
                Rectangle { vertical-stretch: 1; background: Theme.background;
                    Text { x: 16px; y: 16px; text: "Window content"; color: Theme.muted-foreground; }
                }
            }
        }
    }

    // The two ends belong to the application. Here the trailing overflow menu
    // is replaced with a pair of actions in the same slot.
    GroupBox {
        title: "Title Bar with Custom Content";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 140px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-lg; clip: true;
            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: Theme.sidebar;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "Workspace"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; font-weight: 560; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Share"; }
                        Button { text: "Preview"; }
                    }
                }
                Rectangle { vertical-stretch: 1; background: Theme.background;
                    Text { x: 16px; y: 16px; text: "Window content"; color: Theme.muted-foreground; }
                }
            }
        }
    }
}
