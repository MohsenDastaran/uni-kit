import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { HoverCard } from "../hover-card.slint";
import { ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";

export component HoverCardExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Hover";
        variant: GroupBoxVariant.outline;
        HoverCard {
            title: "Ada Lovelace";
            description: "Mathematician and the first computer programmer.";
            Button {
                text: "@ada";
                variant: ButtonVariant.link;
            }
        }
    }

    // A card can open over anything hoverable, so a whole row can be the host.
    GroupBox {
        title: "User Profile Preview";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            HoverCard {
                title: "grace@example.com";
                description: "Maintains the Slint port. Reviewed 42 changes this month.";
                Button { text: "Open profile"; variant: ButtonVariant.link; }
            }
            HoverCard {
                title: "#design";
                description: "12 members. Last message 4 minutes ago.";
                Button { text: "Join channel"; variant: ButtonVariant.link; }
            }
        }
    }

    GroupBox {
        title: "Custom Timing";
        variant: GroupBoxVariant.outline;
        HoverCard {
            title: "Immediate";
            description: "Opens as soon as the pointer rests.";
            delay: 0ms;
            Button {
                text: "No delay";
                variant: ButtonVariant.link;
            }
        }
        HoverCard {
            title: "Deliberate";
            description: "Waits before opening, so a passing pointer does not flash it.";
            delay: 600ms;
            Button {
                text: "600 ms";
                variant: ButtonVariant.link;
            }
        }
    }

    // The card follows its host: one anchored under a label at the start, one
    // under a control at the end of the row.
    GroupBox {
        title: "Positioning";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 16px;

            HoverCard {
                title: "Start";
                description: "Anchored to this label.";
                Button { text: "Left"; variant: ButtonVariant.link; }
            }

            Rectangle { horizontal-stretch: 1; }

            HoverCard {
                title: "End";
                description: "Anchored to the trailing control.";
                Button { text: "Right"; variant: ButtonVariant.link; }
            }
        }
    }
}
