import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Tag, TagVariant } from "../tag.slint";
import { Status } from "../theme.slint";

export component TagExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Tags";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 8px;
            Tag {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Rust";
                icon: "code";
            }
            Tag {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Draft";
                variant: TagVariant.outline;
                closable: true;
            }
            Tag {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Live";
                variant: TagVariant.status;
                status: Status.success;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "Tag Variants";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Tag { text: "Default"; }
            Tag { text: "Secondary"; variant: TagVariant.secondary; }
            Tag { text: "Outline"; variant: TagVariant.outline; }
            Tag { text: "Status"; variant: TagVariant.status; status: Status.info; }
        }
    }

    GroupBox {
        title: "Tag Sizes";
        variant: GroupBoxVariant.outline;
        Tag {
            text: "Small";
            size: ControlSize.small;
        }
        Tag {
            text: "Medium";
        }
        Tag {
            text: "Large";
            size: ControlSize.large;
        }
    }

    // An outlined, closable tag is the usual shape for a filter the person can
    // remove; the close affordance is the same at every variant.
    GroupBox {
        title: "Outline Tags";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Tag { text: "language:rust"; variant: TagVariant.outline; closable: true; }
            Tag { text: "label:good first issue"; variant: TagVariant.outline; closable: true; }
            Tag { text: "assignee:ada"; variant: TagVariant.outline; }
        }
    }
}
