import { Theme, ControlSize, Status } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Progress, ProgressCircle } from "../progress.slint";

export component ProgressExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    in-out property <float> value: 45;
    in-out property <bool> loading;

    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Progress";
        variant: GroupBoxVariant.outline;
        // One row, packed left. These are small controls and always fit, so the
        // wrap grid only ever broke them onto separate lines.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                horizontal-stretch: 0;
                text: "Loading";
                selected: root.loading;
                clicked => {
                    root.loading = !root.loading;
                }
            }
            Button {
                horizontal-stretch: 0;
                icon: "minus";
                enabled: root.value > 0;
                clicked => {
                    root.value = max(0, root.value - 10);
                }
            }
            Button {
                horizontal-stretch: 0;
                icon: "plus";
                enabled: root.value < 100;
                clicked => {
                    root.value = min(100, root.value + 10);
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            GridLayout {
                Text {
                    row: Theme.wrap-row(0, root.wrap-cols);
                    col: Theme.wrap-col(0, root.wrap-cols);
                    text: root.loading ? "Preparing upload…" : "Uploading report.pdf";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                    horizontal-stretch: 1;
                }
                Text {
                    row: Theme.wrap-row(1, root.wrap-cols);
                    col: Theme.wrap-col(1, root.wrap-cols);
                    horizontal-stretch: 0;
                    text: root.loading ? "" : "\{round(root.value)}%";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-sm;
                }
                Rectangle {
                    row: 0;
                    col: root.wrap-cols;
                    horizontal-stretch: 1;
                }
            }
            Progress {
                value: root.value;
                loading: root.loading;
            }
        }
    }

    GroupBox {
        title: "Values";
        variant: GroupBoxVariant.outline;
        Progress {
            value: 0;
        }
        Progress {
            value: 25;
        }
        Progress {
            value: 75;
        }
        Progress {
            value: 100;
        }
    }

    GroupBox {
        title: "Sizes and status colors";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 24px;
            VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                spacing: 12px;
                alignment: center;
                Progress {
                    value: 50;
                    size: ControlSize.xsmall;
                }
                Progress {
                    value: 50;
                    size: ControlSize.small;
                }
                Progress {
                    value: 50;
                }
                Progress {
                    value: 50;
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                spacing: 12px;
                alignment: center;
                Progress {
                    value: 30;
                    status: Status.info;
                }
                Progress {
                    value: 60;
                    status: Status.success;
                }
                Progress {
                    value: 45;
                    status: Status.warning;
                }
                Progress {
                    value: 80;
                    status: Status.danger;
                }
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "Progress circle";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 16px;
            VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: root.value;
                    loading: root.loading;
                    size: ControlSize.xsmall;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: root.value;
                    loading: root.loading;
                    size: ControlSize.small;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: root.value;
                    loading: root.loading;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: root.value;
                    loading: root.loading;
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(4, root.wrap-cols);
                col: Theme.wrap-col(4, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: 75;
                    status: Status.success;
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(5, root.wrap-cols);
                col: Theme.wrap-col(5, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: 40;
                    status: Status.warning;
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(6, root.wrap-cols);
                col: Theme.wrap-col(6, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    loading: true;
                    size: ControlSize.large;
                }
            }
            ProgressCircle {
                row: Theme.wrap-row(7, root.wrap-cols);
                col: Theme.wrap-col(7, root.wrap-cols);
                horizontal-stretch: 0;
                value: root.value;
                loading: root.loading;
                width: 80px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.loading ? "…" : "\{round(root.value)}%";
                        color: Theme.primary;
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Loading";
                        color: Theme.muted-foreground;
                        font-size: Theme.font-size-xs;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
        GridLayout {
            spacing: 8px;
            VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                ProgressCircle {
                    value: root.value;
                    loading: root.loading;
                }
            }
            Text {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                text: root.loading ? "Initializing…" : "Downloading…";
                color: Theme.foreground;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }
}
