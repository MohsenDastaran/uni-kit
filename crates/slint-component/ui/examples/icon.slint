import { Theme, ButtonVariant } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Icon } from "../icon.slint";
import { Button } from "../button.slint";

export component IconExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Icons";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Icon {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                name: "search";
            }
            Icon {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                name: "settings";
            }
            Icon {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                name: "star";
                color: Theme.warning;
            }
            Icon {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                name: "loader-circle";
                spinning: true;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "Icon with Custom Size";
        variant: GroupBoxVariant.outline;
        Icon {
            name: "search";
            size: 16px;
        }
        Icon {
            name: "search";
            size: 24px;
        }
        Icon {
            name: "search";
            size: 32px;
        }
    }

    GroupBox {
        title: "Status Icons";
        variant: GroupBoxVariant.outline;
        Icon {
            name: "circle-check";
            color: Theme.success;
        }
        Icon {
            name: "triangle-alert";
            color: Theme.warning;
        }
        Icon {
            name: "circle-x";
            color: Theme.danger;
        }
    }

    // A one-off glyph does not need a lookup entry: point an `Image` at the
    // file. `colorize` tints it to the theme, which is what `Icon` does for
    // every named icon.
    GroupBox {
        title: "Custom SVG Path";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 16px;
            alignment: center;
            Image {
                width: 24px;
                height: 24px;
                image-fit: contain;
                source: @image-url("../icons/sparkles.svg");
            }
            Image {
                width: 32px;
                height: 32px;
                colorize: Theme.primary;
                image-fit: contain;
                source: @image-url("../icons/sparkles.svg");
            }
            Image {
                width: 40px;
                height: 40px;
                colorize: Theme.success;
                image-fit: contain;
                source: @image-url("../icons/sparkles.svg");
            }
        }
    }

    // `spinning` rotates any glyph, so a set of loading states can share one
    // component.
    GroupBox {
        title: "Animated Loading Icon";
        variant: GroupBoxVariant.outline;

        HorizontalLayout {
            spacing: 16px;
            alignment: center;
            Icon { name: "loader-circle"; size: 20px; spinning: true; }
            Icon { name: "loader-circle"; size: 20px; color: Theme.primary; spinning: true; }
            Icon { name: "refresh-cw"; size: 20px; color: Theme.success; spinning: true; }
            Icon { name: "refresh-cw"; size: 20px; color: Theme.warning; spinning: true; }
        }
    }

    GroupBox {
        title: "Icon in Button";
        variant: GroupBoxVariant.outline;
        Button {
            text: "Search";
            icon: "search";
        }
        Button {
            icon: "settings";
            variant: ButtonVariant.ghost;
        }
    }

}
