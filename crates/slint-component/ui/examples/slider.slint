import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Slider } from "../slider.slint";

export component SliderExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <float> volume: 42;
    GroupBox {
        title: "Volume";
        variant: GroupBoxVariant.outline;
        Slider {
            value <=> root.volume;
        }
        Text {
            text: "\{round(root.volume)}%";
            color: Theme.muted-foreground;
        }
    }

    // The value is a plain number, so a slider backs any bounded quantity.
    GroupBox {
        title: "Basic Slider";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 10px;
            alignment: start;
            Slider { value: 25; }
            Slider { value: 50; }
            Slider { value: 75; }
        }
    }

    GroupBox {
        title: "Custom Step Intervals";
        variant: GroupBoxVariant.outline;
        Slider {
            value: 20;
            step: 10;
        }
    }

    GroupBox {
        title: "Min/Max Configuration";
        variant: GroupBoxVariant.outline;
        Slider {
            value: 21;
            minimum: -10;
            maximum: 40;
        }
    }

    GroupBox {
        title: "Custom Styling";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            alignment: start;
            Slider { value: 40; }
            Slider { value: 65; }
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        Slider {
            value: 30;
            enabled: false;
        }
    }

}
