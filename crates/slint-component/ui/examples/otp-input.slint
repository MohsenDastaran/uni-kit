import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { OtpInput } from "../otp-input.slint";

export component OtpInputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // The cells report every change, so the host owns both the storage and the
    // decision that a code is complete.
    private property <[string]> code: ["", "", "", "", "", ""];
    private property <string> last: "nothing yet";

    GroupBox {
        title: "Verification";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits <=> root.code;
            edited(index, text) => {
                root.last = "cell \{index + 1} → \{text == "" ? "(cleared)" : text}";
            }
        }
        Text {
            text: "Enter the 6-digit code.";
            color: Theme.muted-foreground;
        }
        Text {
            text: "Last edit: " + root.last;
            color: Theme.muted-foreground;
            font-size: Theme.font-size-xs;
        }
    }

    GroupBox {
        title: "With Default Value";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits: ["1", "2", "3", "4", "5", "6"];
        }
    }

    GroupBox {
        title: "Masked OTP Input";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits: ["1", "2", "3", "4", "5", "6"];
            masked: true;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits: ["1", "2", "3", "4"];
            size: ControlSize.small;
        }
        OtpInput {
            digits: ["1", "2", "3", "4", "5", "6"];
        }
        OtpInput {
            digits: ["1", "2", "3", "4", "5", "6"];
            size: ControlSize.large;
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits: ["1", "2", "3", "4", "5", "6"];
            enabled: false;
        }
    }

    // The cell count is `digits.length`, so a four-cell code is just a
    // four-entry array.
    GroupBox {
        title: "Different Length Codes";
        variant: GroupBoxVariant.outline;

        OtpInput {
            digits: ["1", "2", "3", "4"];
        }
        OtpInput {
            digits: ["", "", "", "", "", ""];
        }
    }
}
