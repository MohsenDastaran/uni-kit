import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { StatusBar, StatusItemKind } from "../status-bar.slint";
import { Progress } from "../progress.slint";

export component StatusBarExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <string> pressed: "nothing yet";

    // The three regions: a left region, a centre, and a right region. Each card
    // sits its bar at the bottom of a panel, which is where a status bar lives.
    GroupBox {
        title: "Labels";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 60px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                StatusBar {
                    left: [{ kind: StatusItemKind.label, icon: "", label: "Ready" }];
                    right: [{ kind: StatusItemKind.label, icon: "", label: "UTF-8" }];
                    Text {
                        text: "README.md";
                        color: Theme.muted-foreground;
                        font-size: Theme.font-size-xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // A `button` segment takes the hover affordance and reports a click. A
    // read-only item stays a `label`, so it does not look clickable.
    GroupBox {
        title: "Buttons";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 100%; height: 48px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
                VerticalLayout {
                    Rectangle { vertical-stretch: 1; }
                    StatusBar {
                        left: [{ kind: StatusItemKind.button, icon: "github", label: "main" }];
                        right: [{ kind: StatusItemKind.button, icon: "", label: "Ln 1, Col 1" }];
                        left-clicked(index) => { root.pressed = "the branch"; }
                        right-clicked(index) => { root.pressed = "the cursor position"; }
                    }
                }
            }

            Text {
                text: "Last click: " + root.pressed;
                color: Theme.muted-foreground;
                font-size: Theme.font-size-xs;
            }
        }
    }

    // A `separator` divides runs of items, and the centre region is `@children`,
    // so it holds a component rather than a plain label.
    GroupBox {
        title: "Separators and custom elements";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 60px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                StatusBar {
                    left: [
                        { kind: StatusItemKind.button, icon: "github", label: "main" },
                        { kind: StatusItemKind.separator, icon: "", label: "" },
                        { kind: StatusItemKind.label, icon: "circle-check", label: "0 problems" },
                    ];
                    right: [{ kind: StatusItemKind.label, icon: "", label: "Ln 12, Col 4" }];

                    Rectangle {
                        width: 96px;
                        Progress { value: 60; size: ControlSize.xsmall; }
                    }
                }
            }
        }
    }

    // `background` and `border-color` override the defaults, the way any
    // `Styled` method overrides a GPUI `StatusBar`.
    GroupBox {
        title: "Custom styling";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 60px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                StatusBar {
                    background: Theme.secondary;
                    border-color: Theme.border;
                    left: [{ kind: StatusItemKind.label, icon: "", label: "Ready" }];
                    right: [{ kind: StatusItemKind.label, icon: "", label: "Rust" }];
                }
            }
        }
    }
}
