import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { StatusBar } from "../status-bar.slint";

export component StatusBarExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Labels";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 40px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                StatusBar { left: "main • slint-component"; right: "Ln 12, Col 4"; }
            }
        }
    }

    GroupBox {
        title: "Buttons";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 40px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 24px;
                    background: Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        alignment: center;
                        Text { horizontal-stretch: 1; text: "Build succeeded"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; vertical-alignment: center; }
                        Text { text: "Rebuild"; color: Theme.primary; font-size: Theme.font-size-xs; vertical-alignment: center; }
                        Text { text: "Output"; color: Theme.primary; font-size: Theme.font-size-xs; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Separators and custom elements";
        variant: GroupBoxVariant.outline;

        Rectangle {
            width: 100%; height: 40px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md; clip: true;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 24px;
                    background: Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        alignment: center;
                        Text { text: "Rust"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; vertical-alignment: center; }
                        Rectangle { width: 1px; height: 12px; background: Theme.border; }
                        Text { text: "UTF-8"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; vertical-alignment: center; }
                        Rectangle { width: 1px; height: 12px; background: Theme.border; }
                        Text { text: "Spaces: 4"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "Ln 12, Col 4"; color: Theme.muted-foreground; font-size: Theme.font-size-xs; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
