import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Switch } from "../switch.slint";
import { ControlSize } from "../theme.slint";

export component SwitchExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic";
        variant: GroupBoxVariant.outline;
        Switch {
            label: "Airplane mode";
        }
        Switch {
            label: "Wi-Fi";
            checked: true;
        }
        Switch {
            label: "Disabled";
            enabled: false;
        }
    }
    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            Switch {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                size: ControlSize.xsmall;
                checked: true;
            }
            Switch {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                size: ControlSize.small;
                checked: true;
            }
            Switch {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                checked: true;
            }
            Switch {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                size: ControlSize.large;
                checked: true;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "With Label";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 10px;
            alignment: start;

            Switch { label: "Send anonymous usage data"; checked: true; }
            Switch { label: "Keep the window on top of others"; }
            Switch { label: "Reopen the last workspace on launch"; checked: true; }
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 10px;
            alignment: start;

            Switch { label: "Off and disabled"; enabled: false; }
            Switch { label: "On and disabled"; checked: true; enabled: false; }
        }
    }
}
