import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Pagination } from "../pagination.slint";

export component PaginationExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    // GPUI's plain `Pagination` labels its step buttons and pairs each label
    // with its arrow: "‹ Previous" and "Next ›".
    GroupBox {
        title: "Basic Pagination";
        description: "The step buttons carry their labels.";
        variant: GroupBoxVariant.outline;

        Pagination {
            pages: 10;
            page: 5;
            compact: false;
        }
    }

    GroupBox {
        title: "Pages";
        variant: GroupBoxVariant.outline;
        Pagination {
            pages: 12;
            page: 1;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        Pagination {
            pages: 8;
            page: 2;
            size: ControlSize.xsmall;
        }
        Pagination {
            pages: 8;
            page: 3;
            size: ControlSize.medium;
        }
        Pagination {
            pages: 8;
            page: 4;
            size: ControlSize.large;
        }
    }

    // The arrow that has nowhere to go is disabled, so a first page cannot step
    // back and a last page cannot step on.
    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            alignment: start;
            Pagination { pages: 5; page: 1; }
            Pagination { pages: 5; page: 5; }
        }
    }
}
