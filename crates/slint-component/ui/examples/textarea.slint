import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Textarea } from "../textarea.slint";

export component TextareaExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <string> draft: "";
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic usage";
        variant: GroupBoxVariant.outline;

        Textarea {
            placeholder: "Tell us about yourself…";
            text: "I build desktop tools in Rust and Slint.";
        }
    }

    // A taller frame for longer prose. `preferred-height` is what grows; the
    // text still scrolls inside once it passes the frame.
    GroupBox {
        title: "Auto-grow";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            Textarea {
                height: 200px;
                placeholder: "Release notes…";
                text: "Dock now keeps every toolbar chip on one baseline.";
            }
        }
    }

    // `edited` fires on every keystroke; `text` is two-way, so a host can read
    // the draft without a second property.
    GroupBox {
        title: "Value and events";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Textarea {
                placeholder: "Type a note…";
                edited(text) => {
                    root.draft = text;
                }
            }
            Text {
                text: "Draft: " + (root.draft == "" ? "(empty)" : root.draft);
                color: Theme.muted-foreground;
                font-size: Theme.font-size-xs;
                wrap: word-wrap;
            }
        }
    }

    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            Textarea { size: ControlSize.small; placeholder: "Small"; }
            Textarea { size: ControlSize.medium; placeholder: "Medium"; }
            Textarea { size: ControlSize.large; placeholder: "Large"; }
        }
    }

    GroupBox {
        title: "Appearance";
        variant: GroupBoxVariant.outline;

        VerticalLayout {
            spacing: 12px;
            Textarea { placeholder: "Normal"; }
            Textarea { placeholder: "Read only"; read-only: true; text: "Generated from the manifest."; }
            Textarea { placeholder: "Invalid"; invalid: true; text: "missing closing brace"; }
            Textarea { placeholder: "Disabled"; enabled: false; }
        }
    }
}
