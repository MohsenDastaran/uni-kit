import { Theme, ControlSize } from "theme.slint";

// A transparent row of commands. Mirrors GPUI Component's `Toolbar`: it owns no
// background and no border, so the surrounding surface (a panel header, a tab
// strip, a custom command bar) supplies them. Items render in source order and
// take the toolbar's size.
//
// End the row with a `ToolbarSpacer`. A layout with unclaimed space spreads its
// children apart, so a spacer is what keeps the commands at the leading edge and
// still lets a trailing group sit at the far end.
export component Toolbar {
    in property <ControlSize> size: ControlSize.small;
    // The gap between items. A separator draws its own rule, so it wants less.
    in property <length> spacing: 4px;
    // The inset from the surface. A toolbar drops into a header that already has
    // its own padding, so this defaults to none.
    in property <length> inset: 0px;

    width: 100%;
    horizontal-stretch: 1;
    height: Theme.control-height(size) + inset * 2;

    HorizontalLayout {
        padding: root.inset;
        // No `alignment: start`: it would stop the stretch factor, and a
        // `ToolbarSpacer` could not push the trailing group to the edge. The
        // controls set `horizontal-stretch: 0`, so they keep their own width.
        spacing: root.spacing;
        @children
    }
}

// The vertical rule between command groups. Give it a height; the default reads
// as a divider in a small toolbar.
export component ToolbarSeparator inherits Rectangle {
    in property <length> bar-height: 18px;

    width: 1px;
    height: bar-height;
    horizontal-stretch: 0;
    background: Theme.border;
}

// A pushed group: everything after it sits at the trailing edge.
export component ToolbarSpacer inherits Rectangle {
    horizontal-stretch: 1;
    min-width: 0px;
    background: transparent;
}
